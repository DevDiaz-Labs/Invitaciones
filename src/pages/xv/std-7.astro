---
// src/pages/xv/std-7.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date (Midnight & Silver)</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Prata&family=Work+Sans:wght@200;300;400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#0B132B", // Deep Midnight Blue
                            secondary: "#8E9AAF", // Silver Blue
                            background: "#050814", // Near Black Navy
                            "on-background": "#E6ECF2", // Silver White
                            accent: "#FFFFFF",
                        },
                        fontFamily: {
                            serif: ["Prata", "serif"],
                            sans: ["Work Sans", "sans-serif"],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .silver-panel {
                background-color: rgba(142, 154, 175, 0.1);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.15);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            }
            .silver-text-gradient {
                background: linear-gradient(135deg, #FFFFFF 0%, #B0C4DE 50%, #8E9AAF 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-sans antialiased min-h-screen flex flex-col selection:bg-secondary selection:text-primary"
    >
        <main class="flex-grow flex flex-col relative min-h-screen p-4 md:p-8">
            <!-- Floating Back to Catalog Button -->
            <a
                href="/xv/catalogo"
                class="fixed top-4 left-4 z-50 bg-black/60 hover:bg-black/85 backdrop-blur-md text-white px-4 py-2 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-widest flex items-center gap-2 border border-white/20 transition-all shadow-lg"
            >
                <span class="material-symbols-outlined text-[14px] md:text-[16px]">arrow_back</span>
                Catálogo
            </a>
            <!-- Double thin silver border lines -->
            <div class="absolute inset-4 md:inset-8 border border-white/10 z-10 pointer-events-none"></div>
            <div class="absolute inset-5 md:inset-9 border border-white/5 z-10 pointer-events-none"></div>

            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img
                    alt="Background Floral Art"
                    class="w-full h-full object-cover object-center opacity-30 filter brightness-90 contrast-110"
                    src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-b from-background/90 via-background/60 to-background/95"
                >
                </div>
            </div>

            <!-- Content -->
            <div
                class="relative z-20 w-full flex-grow max-w-4xl mx-auto flex flex-col justify-between items-center text-center px-4 py-12 md:py-16"
            >
                <!-- Top -->
                <div class="mt-8">
                    <span
                        class="text-[10px] md:text-xs uppercase tracking-[0.35em] text-secondary font-medium"
                    >
                        Gran Gala de Quince Años
                    </span>
                    <h1
                        class="font-serif text-6xl md:text-8xl text-white mt-4 mb-3 tracking-wider silver-text-gradient drop-shadow-md"
                    >
                        Valeria
                    </h1>
                    <div class="w-16 h-px bg-white/30 mx-auto"></div>
                </div>

                <!-- Middle: Save the Date & Countdown -->
                <div class="flex flex-col items-center w-full max-w-xl my-6">
                    <span class="text-xs uppercase tracking-[0.3em] text-white font-semibold mb-5">
                        SAVE THE DATE
                    </span>

                    <p class="text-sm text-on-background/75 max-w-md mx-auto mb-8 font-light leading-relaxed">
                        Te invitamos a ser parte de una velada espectacular llena de etiqueta, elegancia y momentos mágicos para celebrar mis quince años.
                    </p>

                    <!-- Silver/Navy Block Countdown -->
                    <div class="grid grid-cols-4 gap-3 w-full max-w-md">
                        <div class="silver-panel rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-white font-bold">142</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-2">Días</span>
                        </div>
                        <div class="silver-panel rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-white font-bold">08</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-2">Horas</span>
                        </div>
                        <div class="silver-panel rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-white font-bold">45</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-2">Minutos</span>
                        </div>
                        <div class="silver-panel rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-white font-bold">12</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-2">Segs</span>
                        </div>
                    </div>
                </div>

                <!-- Bottom: Actions -->
                <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md justify-center">
                    <button
                        class="w-full sm:w-auto bg-white text-primary px-8 py-3 rounded font-semibold text-xs uppercase tracking-widest shadow-lg hover:bg-secondary hover:text-white transition-all flex items-center justify-center gap-2 border border-white/20"
                    >
                        <span class="material-symbols-outlined text-[16px] font-bold">calendar_today</span>
                        Google Calendar
                    </button>
                    <button
                        class="w-full sm:w-auto bg-transparent border border-white/40 text-white px-8 py-3 rounded hover:bg-white/10 transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px]">event</span>
                        iCal / Outlook
                    </button>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-8 border-t border-white/10 bg-[#020409] flex flex-col items-center gap-2 text-center"
        >
            <div class="text-white font-serif text-2xl tracking-widest">
                VALERIA
            </div>
            <div
                class="text-[9px] tracking-[0.25em] uppercase text-secondary/60 font-light"
            >
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
