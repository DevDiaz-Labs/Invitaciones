import * as fs from "fs";
import * as path from "path";

// Generar rutas estáticas filtrando SOLO por "xv"
export async function getStaticPaths() {
    const clientesDir = path.resolve("./src/data/clientes");
    let clientesFiles: string[] = [];

    try {
        clientesFiles = fs
            .readdirSync(clientesDir)
            .filter((f) => f.endsWith(".json"));
    } catch (e) {
        console.log(
            "Directorio de clientes no encontrado, retornando paths vacíos.",
        );
    }

    const paths = [];

    for (const file of clientesFiles) {
        const clienteId = file.replace(".json", "");
        const rawData = fs.readFileSync(path.join(clientesDir, file), "utf-8");
        try {
            const data = JSON.parse(rawData);

            // FILTRO CRUCIAL: Solo aceptamos las invitaciones tipo 'xv'
            if (data.tipo === "xv") {
                paths.push({
                    params: { cliente: clienteId },
                    props: { data },
                });
            }
        } catch (e) {
            console.error(`Error procesando JSON de ${file}:`, e);
        }
    }

    return paths;
}

const { data } = Astro.props;
const showSobre = !data.sobre || data.sobre.mostrar !== false;

// ============================================
// MAPAS DE COMPONENTES - Aquí se conecta el nombre del JSON con el componente real
// Si un JSON no tiene campo "componente", se usa el DEFAULT (el original de siempre)
// ============================================
const heroMap: Record<string, any> = {
    HeroFloralFrame, HeroBoho, HeroMinimalista, HeroXVArchFlowers,
    HeroXVDrama, HeroXVEditorialBold, HeroXVMiniVideoStyle,
    HeroXVMinimalElegance, HeroXVRoseGold, HeroXVStarlight, HeroXVWatercolor,
};

const cartaMap: Record<string, any> = {
    CartaFloral, CartaElegante, CartaRustica, CartaRomantica,
    CartaBohemia, CartaVintage, CartaModerna, CartaReal, CartaNoche, CartaJoven, CartaImagenFullScreen,
};

const countdownMap: Record<string, any> = {
    CountdownXV, CountdownMinimalista, CountdownSimple,
    CountdownBurbujas, CountdownAnillos, CountdownFlip,
};

const ubicacionMap: Record<string, any> = {
    UbicacionRustica, UbicacionTimeline, UbicacionNatural, UbicacionNocturna,
    UbicacionRosada, UbicacionFiesta, UbicacionLujo, UbicacionMapaFull,
    UbicacionMiniMapas, UbicacionVintage, UbicacionBoho,
};

const itinerarioMap: Record<string, any> = {
    ItinerarioPolaroid, ItinerarioClassic, ItinerarioElegant,
    ItinerarioTimeline, ItinerarioMinimalista, ItinerarioAccordion,
    ItinerarioRoyalGold, ItinerarioMetro,
};

const dressCodeMap: Record<string, any> = {
    DressCodeXV, DressCodeBoho, DressCodeEtiqueta,
    DressCodeVintageChic, DressCodeGalaImperial, DressCodePlaya,
};

const regalosMap: Record<string, any> = {
    RegalosXV, RegalosBoda, RegalosElegante, RegalosBoho, RegalosGlamour,
};

const reproductorMap: Record<string, any> = {
    ReproductorMinimalista, ReproductorXV,
};

const galeriaMap: Record<string, any> = {
    GaleriaMini, GaleriaMasonry, GaleriaPolaroidStack,
    GaleriaCineFilm, GaleriaGlassCards, GaleriaSwipeDeck, GaleriaBento,
};

const rsvpMap: Record<string, any> = {
    RSVPElegantSerif, RSVPMinimalista, RSVPBoho, RSVPXV,
    RSVPChicPopup, RSVPDigitalEnvelope,
};

const calendarioMap: Record<string, any> = {
    CalendarioXV, CalendarioMinimalista, CalendarioFloral,
    CalendarioModerno, CalendarioVintage, CalendarioBoho,
};

const footerMap: Record<string, any> = {
    FooterVintage, FooterBoho, FooterElegant,
    FooterMinimalista, FooterXV, FooterClassic,
};

// ============================================
// RESOLVER COMPONENTES - Si el JSON tiene "componente", usa ese; si no, usa el default
// ============================================
const HeroComp = data.hero?.componente ? (heroMap[data.hero.componente] || HeroDefault) : HeroDefault;
const CartaComp = data.dedicatoria?.componente ? (cartaMap[data.dedicatoria.componente] || CartaDefault) : CartaDefault;
const CountdownComp = data.countdown?.componente ? (countdownMap[data.countdown.componente] || CountdownDefault) : CountdownDefault;
const UbicacionComp = data.eventos?.componente ? (ubicacionMap[data.eventos.componente] || null) : null;
const ItinerarioComp = data.itinerario?.componente ? (itinerarioMap[data.itinerario.componente] || ItinerarioDefault) : ItinerarioDefault;
const DressCodeComp = data.dressCode?.componente ? (dressCodeMap[data.dressCode.componente] || DressCodeDefault) : DressCodeDefault;
const RegalosComp = data.regalos?.componente ? (regalosMap[data.regalos.componente] || RegalosDefault) : RegalosDefault;
const ReproductorComp = data.musica?.componente ? (reproductorMap[data.musica.componente] || MusicPlayerDefault) : MusicPlayerDefault;
const GaleriaComp = data.galeria?.componente ? (galeriaMap[data.galeria.componente] || GaleriaDefault) : GaleriaDefault;
const RSVPComp = data.rsvp?.componente ? (rsvpMap[data.rsvp.componente] || RSVPDefault) : RSVPDefault;
const CalendarioComp = data.calendario?.componente ? (calendarioMap[data.calendario.componente] || null) : null;
const FooterComp = data.footer?.componente ? (footerMap[data.footer.componente] || FooterDefault) : FooterDefault;
const NinezComp = data.ninez?.componente ? (galeriaMap[data.ninez.componente] || GaleriaDefault) : null;

// Determinar si usamos ubicación unificada o ceremonia/recepción por separado
const usaUbicacionUnificada = UbicacionComp !== null;
---

<XVDulceLayout title={data.hero.etiqueta} tema={data.tema}>
    <!-- El script de Tailwind cargado de manera global y asíncrona pero sin dependencias reactivas condicionales -->
    <script slot="head" is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Selector de Animación de Entrada -->
    {
        showSobre && (
            <Sobre
                nombre={data.hero.nombre}
                fecha={data.hero.fechaTexto}
                evento={data.hero.etiqueta}
                mensajeTop="Te invito a celebrar"
                pases={data.pases}
                {...data.sobre}
            />
        )
    }

    <!-- Contenido Principal inicia oculto (el sobre lo muestra al animarse) -->
    <main
        id="invitation-content"
        style={showSobre 
            ? "opacity: 0; transform: translateY(20px); transition: opacity 1s ease 1.5s, transform 1s ease 1.5s, visibility 0s 1.5s; visibility: hidden;" 
            : "opacity: 1; transform: translateY(0); visibility: visible;"}
    >
        <!-- HERO -->
        <HeroComp data={data.hero} />

        <!-- CARTA / DEDICATORIA -->
        {data.dedicatoria?.componente ? (
            <!-- Si tiene componente alternativo de carta, usa ese con los datos de dedicatoria -->
            <CartaComp data={{
                ...data.dedicatoria,
                mostrar: data.dedicatoria.mostrar !== false,
                imagenFondo: data.imagenesFondo?.dedicatoria || data.dedicatoria.imagenFondo,
            }} bgSize={data.imagenesFondo?.dedicatoriaSize} bgRepeat={data.imagenesFondo?.dedicatoriaRepeat} />
        ) : (
            <>
                {data.carta && <CartaComp data={data.carta} bgImage={data.imagenesFondo?.carta} />}
                {data.dedicatoria && <DedicatoriaDefault data={data.dedicatoria} bgImage={data.imagenesFondo?.dedicatoria} />}
            </>
        )}

        <!-- SECCIÓN NIÑEZ (Recuerdos infantiles) -->
        {NinezComp && data.ninez?.mostrar !== false && data.ninez?.imagenes && (
            <NinezComp data={data.ninez.imagenes} titulo={data.ninez.titulo} bgImage={data.imagenesFondo?.ninez} bgColor={data.ninez?.colorFondo} bgSize={data.imagenesFondo?.ninezSize} bgRepeat={data.imagenesFondo?.ninezRepeat} mostrarMarca={data.ninez?.mostrarMarca} />
        )}

        <!-- COUNTDOWN -->
        {data.countdown && <CountdownComp data={data.countdown} bgImage={data.imagenesFondo?.countdown} bgColor={data.countdown?.colorFondo} bgSize={data.imagenesFondo?.countdownSize} bgRepeat={data.imagenesFondo?.countdownRepeat} />}

        <!-- CALENDARIO (Agregado abajo del countdown a peticion) -->
        {CalendarioComp && data.calendario && <CalendarioComp calendario={data.calendario} bgImage={data.imagenesFondo?.calendario} bgColor={data.calendario?.colorFondo} bgSize={data.imagenesFondo?.calendarioSize} bgRepeat={data.imagenesFondo?.calendarioRepeat} />}

        <!-- ITINERARIO -->
        {data.itinerario && data.itinerario.mostrar !== false && (data.itinerario.componente ? (
            <ItinerarioComp data={{ ...data.itinerario, itinerario: data.itinerario.eventos || data.itinerario.items || [] }} bgColor={data.itinerario?.colorFondo} bgImage={data.imagenesFondo?.itinerario} bgSize={data.imagenesFondo?.itinerarioSize} bgRepeat={data.imagenesFondo?.itinerarioRepeat} />
        ) : (
            data.itinerario.mostrar && <ItinerarioComp data={data.itinerario} bgImage={data.imagenesFondo?.itinerario} bgColor={data.itinerario?.colorFondo} bgSize={data.imagenesFondo?.itinerarioSize} bgRepeat={data.imagenesFondo?.itinerarioRepeat} />
        ))}

        <!-- UBICACIÓN (unificada o separada) -->
        {usaUbicacionUnificada ? (
            <UbicacionComp data={data.eventos} />
        ) : (
            <>
                {data.eventos?.ceremonia && <CeremoniaDefault data={data.eventos.ceremonia} bgImage={data.imagenesFondo?.ceremonia} />}
                {data.eventos?.recepcion && <RecepcionDefault data={data.eventos.recepcion} bgImage={data.imagenesFondo?.recepcion} />}
            </>
        )}

        <!-- DRESS CODE -->
        {data.dressCode && <DressCodeComp data={data.dressCode} bgImage={data.imagenesFondo?.dressCode} bgColor={data.dressCode?.colorFondo} bgSize={data.imagenesFondo?.dressCodeSize} bgRepeat={data.imagenesFondo?.dressCodeRepeat} />}

        <!-- REGALOS -->
        {
            data.regalos && data.regalos.mostrar !== false && (
                <RegalosComp data={data.regalos} nombre={data.hero.nombre} bgImage={data.imagenesFondo?.regalos} bgColor={data.regalos?.colorFondo} bgSize={data.imagenesFondo?.regalosSize} bgRepeat={data.imagenesFondo?.regalosRepeat} />
            )
        }

        <!-- LLUVIA DE SOBRES (solo si existe, sin alternativa por ahora) -->
        {data.lluviaDeSobres?.mostrar && <LluviaDeSobresDefault data={data.lluviaDeSobres} />}

        <!-- SEPARADOR -->
        {data.hero.imagenFondo2 && <Separador image={data.hero.imagenFondo2} />}

        <!-- GALERÍA -->
        {data.galeria?.mostrar && <GaleriaComp data={data.galeria?.componente ? data.galeria.imagenes : data.galeria.imagenes} bgImage={data.imagenesFondo?.galeria} bgColor={data.galeria?.colorFondo} bgSize={data.imagenesFondo?.galeriaSize} bgRepeat={data.imagenesFondo?.galeriaRepeat} />}

        <!-- RSVP -->
        {
            data.rsvp && (
                <RSVPComp
                    data={{
                        ...data.rsvp,
                        urlCalendario: data.countdown?.urlCalendario,
                        pases: data.pases,
                    }}
                    bgImage={data.imagenesFondo?.rsvp}
                    bgColor={data.rsvp?.colorFondo}
                    colorPrincipal={data.tema?.colorPrincipal}
                    colorTexto={data.rsvp?.colorTexto || data.tema?.colorTexto}
                    bgSize={data.imagenesFondo?.rsvpSize}
                    bgRepeat={data.imagenesFondo?.rsvpRepeat}
                    nombre={data.footer?.nombres || data.hero?.nombre}
                />
            )
        }

        <!-- CALENDARIO (solo si existe en el JSON, es nuevo) -->
        {CalendarioComp && data.calendario && <CalendarioComp calendario={data.calendario} bgImage={data.imagenesFondo?.calendario} bgColor={data.calendario?.colorFondo} bgSize={data.imagenesFondo?.calendarioSize} bgRepeat={data.imagenesFondo?.calendarioRepeat} />}

        <!-- COMPARTIR FOTOS -->
        {data.compartirFotos?.mostrar && <CompartirFotosDefault data={data.compartirFotos} bgImage={data.imagenesFondo?.compartirFotos} />}
    </main>

    <div
        id="footer-content"
        style={showSobre 
            ? "opacity: 0; transition: opacity 1s ease 1.5s; visibility: hidden;" 
            : "opacity: 1; visibility: visible;"}
    >
        <FooterComp data={{ ...data.footer, nombre: data.hero.nombre, fechaVista: data.hero.fechaTexto }} />
    </div>

    <!-- REPRODUCTOR DE MÚSICA -->
    {data.musica?.componente ? (
        <ReproductorComp audioSrc={data.musica.url} autoplay={data.musica.autoplay === true} />
    ) : (
        data.musica?.url && <MusicPlayerDefault url={data.musica.url} />
    )}
</XVDulceLayout>
