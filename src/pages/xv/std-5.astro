---
// src/pages/xv/std-5.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date (Celestial Fairytale)</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Pinyon+Script&family=DM+Sans:wght@300;400;600;700&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#C3B1E1", // Pastel Lavender
                            secondary: "#FAD2E1", // Soft Rose Pearl
                            background: "#160F26", // Twilight Night
                            "on-background": "#F0ECF7",
                            accent: "#E8D8FF",
                        },
                        fontFamily: {
                            cursive: ["Pinyon Script", "cursive"],
                            sans: ["DM Sans", "sans-serif"],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .celestial-bubble {
                background: rgba(255, 255, 255, 0.05);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(195, 177, 225, 0.2);
                box-shadow: 0 8px 32px 0 rgba(195, 177, 225, 0.08);
            }
            .galaxy-btn {
                background: linear-gradient(135deg, #A78BFA 0%, #F472B6 100%);
                box-shadow: 0 4px 15px rgba(167, 139, 250, 0.3);
            }
            .galaxy-btn:hover {
                box-shadow: 0 6px 22px rgba(244, 114, 182, 0.5);
                opacity: 0.95;
            }
            /* Sparkle positions */
            .sparkle {
                position: absolute;
                background-color: #FFF;
                border-radius: 50%;
                animation: pulse 2s infinite ease-in-out;
            }
            @keyframes pulse {
                0%, 100% { opacity: 0.2; transform: scale(0.8); }
                50% { opacity: 1; transform: scale(1.2); }
            }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-sans antialiased min-h-screen flex flex-col selection:bg-primary selection:text-background"
    >
        <main class="flex-grow flex flex-col relative min-h-screen overflow-hidden">
            <!-- Floating Back to Catalog Button -->
            <a
                href="/xv/catalogo"
                class="fixed top-4 left-4 z-50 bg-black/65 hover:bg-black/90 backdrop-blur-md text-white px-4 py-2 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-widest flex items-center gap-2 border border-white/20 transition-all shadow-lg"
            >
                <span class="material-symbols-outlined text-[14px] md:text-[16px]">arrow_back</span>
                Catálogo
            </a>
            <!-- Simulated background stars/sparkles -->
            <div class="sparkle w-1 h-1 top-[15%] left-[20%]" style="animation-delay: 0.2s;"></div>
            <div class="sparkle w-1.5 h-1.5 top-[25%] left-[80%]" style="animation-delay: 0.7s;"></div>
            <div class="sparkle w-1 h-1 top-[55%] left-[10%]" style="animation-delay: 1.1s;"></div>
            <div class="sparkle w-2 h-2 top-[70%] left-[85%]" style="animation-delay: 0.5s;"></div>
            <div class="sparkle w-1 h-1 top-[80%] left-[30%]" style="animation-delay: 1.4s;"></div>

            <!-- Background Image with Purple / Twilight filter -->
            <div class="absolute inset-0 z-0">
                <img
                    alt="Celestial Landscape"
                    class="w-full h-full object-cover object-center opacity-30"
                    src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-b from-background/90 via-background/60 to-background/95"
                >
                </div>
            </div>

            <!-- Content -->
            <div
                class="relative z-10 w-full flex-grow max-w-4xl mx-auto flex flex-col justify-between items-center text-center px-6 py-16 md:py-20"
            >
                <!-- Top Content: Script Name & Title -->
                <div class="mt-8">
                    <span
                        class="text-[10px] uppercase tracking-[0.3em] text-accent/80 font-semibold block mb-1"
                    >
                        Bajo un Cielo Estrellado
                    </span>
                    <h1
                        class="font-cursive text-7xl md:text-9xl text-white tracking-wide"
                    >
                        Valeria
                    </h1>
                    <span
                        class="text-xs uppercase tracking-[0.25em] text-primary font-medium block mt-2"
                    >
                        Mis Quince Años
                    </span>
                </div>

                <!-- Middle Content: Celestial Details & Bubbles -->
                <div class="flex flex-col items-center w-full max-w-xl my-6">
                    <span class="text-xs uppercase tracking-[0.3em] text-secondary font-semibold mb-4 block">
                        ✨ Save the Date ✨
                    </span>

                    <p class="text-sm text-on-background/75 max-w-md mx-auto mb-8 font-light leading-relaxed">
                        Acompáñame a escribir un cuento de hadas real en una noche inolvidable. Celebremos mis quince años rodeados de estrellas y magia.
                    </p>

                    <!-- Bubble-styled Countdown -->
                    <div class="grid grid-cols-4 gap-3 w-full max-w-md">
                        <div class="celestial-bubble rounded-full aspect-square flex flex-col items-center justify-center p-3">
                            <span class="font-semibold text-xl md:text-3xl text-white">142</span>
                            <span class="text-[8px] text-accent uppercase tracking-widest mt-1">Días</span>
                        </div>
                        <div class="celestial-bubble rounded-full aspect-square flex flex-col items-center justify-center p-3">
                            <span class="font-semibold text-xl md:text-3xl text-white">08</span>
                            <span class="text-[8px] text-accent uppercase tracking-widest mt-1">Horas</span>
                        </div>
                        <div class="celestial-bubble rounded-full aspect-square flex flex-col items-center justify-center p-3">
                            <span class="font-semibold text-xl md:text-3xl text-white">45</span>
                            <span class="text-[8px] text-accent uppercase tracking-widest mt-1">Min</span>
                        </div>
                        <div class="celestial-bubble rounded-full aspect-square flex flex-col items-center justify-center p-3">
                            <span class="font-semibold text-xl md:text-3xl text-white">12</span>
                            <span class="text-[8px] text-accent uppercase tracking-widest mt-1">Seg</span>
                        </div>
                    </div>
                </div>

                <!-- Bottom Content: Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md justify-center">
                    <button
                        class="w-full sm:w-auto galaxy-btn text-white px-8 py-3 rounded-full font-semibold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2 border border-white/20"
                    >
                        <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                        Agregar Calendario
                    </button>
                    <button
                        class="w-full sm:w-auto bg-white/5 border border-primary/30 text-accent hover:bg-white/10 px-8 py-3 rounded-full font-semibold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px]">event</span>
                        iCal / Outlook
                    </button>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-8 border-t border-white/5 bg-[#0F0A1C] flex flex-col items-center gap-2 text-center"
        >
            <div class="text-white font-cursive text-3xl tracking-wider">
                Valeria
            </div>
            <div
                class="text-[9px] tracking-[0.25em] uppercase text-primary/60 font-light"
            >
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
