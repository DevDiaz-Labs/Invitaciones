---
// src/pages/xv/std-8.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date (Vintage Romance)</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Italiana&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#C59A9F", // Dusty Vintage Rose
                            secondary: "#9C8370", // Warm Sepia
                            background: "#F5EFE6", // Aged Ivory
                            "on-background": "#44362E", // Vintage Ink / Chocolate
                            accent: "#6B5143",
                        },
                        fontFamily: {
                            display: ["Italiana", "serif"],
                            serif: ["Cardo", "serif"],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .vintage-border {
                border: 1px solid rgba(156, 131, 112, 0.35);
            }
            .ornament {
                font-family: 'Cardo', serif;
                color: #C59A9F;
            }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-serif antialiased min-h-screen flex flex-col selection:bg-primary selection:text-background"
    >
        <main class="flex-grow flex flex-col relative min-h-screen p-4 md:p-8">
            <!-- Floating Back to Catalog Button -->
            <a
                href="/xv/catalogo"
                class="fixed top-4 left-4 z-50 bg-[#44362E]/85 hover:bg-[#44362E] text-background px-4 py-2 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-widest flex items-center gap-2 border border-secondary/20 transition-all shadow-lg"
            >
                <span class="material-symbols-outlined text-[14px] md:text-[16px]">arrow_back</span>
                Catálogo
            </a>
            <!-- Vintage outer frame -->
            <div class="absolute inset-4 md:inset-8 border vintage-border z-10 pointer-events-none"></div>
            <div class="absolute inset-5 md:inset-9 border vintage-border opacity-50 z-10 pointer-events-none"></div>

            <!-- Faded Background Image -->
            <div class="absolute inset-0 z-0">
                <img
                    alt="Vintage background floral"
                    class="w-full h-full object-cover object-center opacity-30 filter sepia-[0.3]"
                    src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-b from-background/90 via-background/70 to-background/95"
                >
                </div>
            </div>

            <!-- Content -->
            <div
                class="relative z-20 w-full flex-grow max-w-4xl mx-auto flex flex-col justify-between items-center text-center px-4 py-12 md:py-16"
            >
                <!-- Top: Vintage Name -->
                <div class="mt-8">
                    <span
                        class="font-display text-xs uppercase tracking-[0.3em] text-secondary font-semibold"
                    >
                        Mis XV Años
                    </span>
                    
                    <!-- Ornament -->
                    <div class="ornament text-xl my-2">❦</div>

                    <h1
                        class="font-display text-6xl md:text-8xl text-on-background tracking-wide"
                    >
                        Valeria
                    </h1>

                    <div class="ornament text-xl mt-2">❦</div>
                </div>

                <!-- Middle: Save the Date & Countdown -->
                <div class="flex flex-col items-center w-full max-w-xl my-6">
                    <h2 class="font-display text-2xl tracking-widest text-primary uppercase mb-4">
                        Save the Date
                    </h2>

                    <p class="text-sm md:text-base text-on-background/80 max-w-md mx-auto mb-8 italic leading-relaxed">
                        “Hay momentos en la vida que son especiales por sí solos, pero compartirlos con quienes amas los hace inolvidables.”
                    </p>

                    <!-- Vintage Countdown Grid -->
                    <div class="grid grid-cols-4 gap-4 w-full max-w-md">
                        <div class="border-b border-secondary/40 pb-4 flex flex-col items-center">
                            <span class="font-display text-3xl md:text-4xl text-on-background">142</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-1">Días</span>
                        </div>
                        <div class="border-b border-secondary/40 pb-4 flex flex-col items-center">
                            <span class="font-display text-3xl md:text-4xl text-on-background">08</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-1">Horas</span>
                        </div>
                        <div class="border-b border-secondary/40 pb-4 flex flex-col items-center">
                            <span class="font-display text-3xl md:text-4xl text-on-background">45</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-1">Minutos</span>
                        </div>
                        <div class="border-b border-secondary/40 pb-4 flex flex-col items-center">
                            <span class="font-display text-3xl md:text-4xl text-on-background">12</span>
                            <span class="text-[9px] text-secondary uppercase tracking-widest mt-1">Segs</span>
                        </div>
                    </div>
                </div>

                <!-- Bottom: Vintage Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md justify-center">
                    <button
                        class="w-full sm:w-auto bg-[#44362E] text-background px-8 py-3 rounded-sm font-semibold text-xs uppercase tracking-widest hover:bg-primary hover:text-on-background transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                        Añadir Calendario
                    </button>
                    <button
                        class="w-full sm:w-auto bg-transparent border border-[#44362E] text-[#44362E] px-8 py-3 rounded-sm font-semibold text-xs uppercase tracking-widest hover:bg-[#44362E]/5 transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px]">event</span>
                        iCal / Outlook
                    </button>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-8 border-t border-secondary/20 bg-[#ECE5DA] flex flex-col items-center gap-2 text-center"
        >
            <div class="text-[#44362E] font-display text-2xl">
                Valeria
            </div>
            <div
                class="text-[9px] tracking-[0.25em] uppercase text-secondary font-light"
            >
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
