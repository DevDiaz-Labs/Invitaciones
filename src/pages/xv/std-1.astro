---
// src/pages/xv/std-1.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date (Rose Gold Luxury)</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Montserrat:ital,wght@0,300;0,400;0,600;1,400&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#B76E79", // Rose Gold
                            secondary: "#D4A373", // Warm Gold
                            background: "#1A0F11", // Deep Burgundy/Charcoal
                            "on-background": "#F5EBE0", // Warm Ivory Text
                            accent: "#E6C594",
                            "border-rose": "rgba(183, 110, 121, 0.3)",
                        },
                        fontFamily: {
                            serif: ["Playfair Display", "serif"],
                            sans: ["Montserrat", "sans-serif"],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .luxury-border {
                border: 1px solid rgba(212, 163, 115, 0.25);
                box-shadow: 0 0 20px rgba(183, 110, 121, 0.15);
            }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-sans antialiased min-h-screen flex flex-col selection:bg-primary selection:text-white"
    >
        <main class="flex-grow flex flex-col relative min-h-screen p-4 md:p-6">
            <!-- Floating Back to Catalog Button -->
            <a
                href="/xv/catalogo"
                class="fixed top-4 left-4 z-50 bg-black/60 hover:bg-black/85 backdrop-blur-md text-white px-4 py-2 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-widest flex items-center gap-2 border border-white/20 transition-all shadow-lg"
            >
                <span class="material-symbols-outlined text-[14px] md:text-[16px]">arrow_back</span>
                Catálogo
            </a>
            <!-- Outermost elegant border -->
            <div class="absolute inset-4 md:inset-6 border border-secondary/20 z-10 pointer-events-none"></div>
            <div class="absolute inset-5 md:inset-7 border border-primary/20 z-10 pointer-events-none"></div>

            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img
                    alt="Background photo"
                    class="w-full h-full object-cover object-center opacity-40"
                    src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-b from-background/80 via-background/60 to-background/95"
                >
                </div>
            </div>

            <!-- Content -->
            <div
                class="relative z-20 w-full flex-grow max-w-4xl mx-auto flex flex-col justify-between items-center text-center px-4 py-12 md:py-16"
            >
                <!-- Top Content: Name -->
                <div class="mt-8">
                    <span
                        class="text-xs uppercase tracking-[0.35em] text-secondary font-semibold"
                    >
                        Mis Quince Años
                    </span>
                    <h1
                        class="font-serif italic text-6xl md:text-8xl font-medium text-on-background my-4 tracking-wider drop-shadow-lg"
                    >
                        Valeria
                    </h1>
                    <div class="w-24 h-px bg-gradient-to-r from-transparent via-primary to-transparent mx-auto"></div>
                </div>

                <!-- Bottom Content: Info & Countdown -->
                <div class="flex flex-col items-center w-full max-w-2xl mb-4">
                    <h2
                        class="font-serif italic text-2xl md:text-3xl text-primary tracking-wide mb-4"
                    >
                        Save the Date
                    </h2>

                    <p
                        class="text-sm md:text-base text-on-background/85 max-w-lg mx-auto mb-8 font-light leading-relaxed px-4"
                    >
                        Acompáñanos a celebrar una noche mágica llena de elegancia, sueños y alegría inolvidable.
                    </p>

                    <!-- Elegant Framed Countdown -->
                    <div
                        class="luxury-border bg-background/70 backdrop-blur-md rounded-lg p-6 w-full mb-10 flex justify-center items-center gap-4 text-on-background border border-primary/30"
                    >
                        <div class="flex flex-col items-center flex-1">
                            <span class="font-serif text-3xl md:text-5xl text-accent font-light">142</span>
                            <span class="text-[10px] md:text-xs text-on-background/60 uppercase tracking-widest mt-2">Días</span>
                        </div>
                        <div class="w-px bg-primary/20 h-10 self-center"></div>
                        <div class="flex flex-col items-center flex-1">
                            <span class="font-serif text-3xl md:text-5xl text-accent font-light">08</span>
                            <span class="text-[10px] md:text-xs text-on-background/60 uppercase tracking-widest mt-2">Horas</span>
                        </div>
                        <div class="w-px bg-primary/20 h-10 self-center"></div>
                        <div class="flex flex-col items-center flex-1">
                            <span class="font-serif text-3xl md:text-5xl text-accent font-light">45</span>
                            <span class="text-[10px] md:text-xs text-on-background/60 uppercase tracking-widest mt-2">Minutos</span>
                        </div>
                        <div class="w-px bg-primary/20 h-10 self-center"></div>
                        <div class="flex flex-col items-center flex-1">
                            <span class="font-serif text-3xl md:text-5xl text-accent font-light">12</span>
                            <span class="text-[10px] md:text-xs text-on-background/60 uppercase tracking-widest mt-2">Segundos</span>
                        </div>
                    </div>

                    <!-- Calendar Actions -->
                    <div
                        class="flex flex-col md:flex-row gap-4 w-full md:w-auto justify-center"
                    >
                        <button
                            class="w-full md:w-auto bg-gradient-to-r from-primary to-[#c2848e] text-white px-8 py-3 rounded-md font-semibold text-xs uppercase tracking-widest shadow-lg hover:shadow-xl hover:opacity-95 transition-all flex items-center justify-center gap-2 border border-secondary/20"
                        >
                            <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                            Google Calendar
                        </button>
                        <button
                            class="w-full md:w-auto bg-transparent border border-secondary/40 text-on-background px-8 py-3 rounded-md font-semibold text-xs uppercase tracking-widest hover:bg-secondary/10 transition-all flex items-center justify-center gap-2"
                        >
                            <span class="material-symbols-outlined text-[16px]">event</span>
                            Outlook
                        </button>
                        <button
                            class="w-full md:w-auto bg-transparent border border-secondary/40 text-on-background px-8 py-3 rounded-md font-semibold text-xs uppercase tracking-widest hover:bg-secondary/10 transition-all flex items-center justify-center gap-2"
                        >
                            <span class="material-symbols-outlined text-[16px]">ios</span>
                            iCal
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-8 border-t border-secondary/10 bg-[#0F0809] flex flex-col items-center gap-2 text-center z-20"
        >
            <div class="text-secondary font-serif text-2xl italic tracking-wider">
                Valeria
            </div>
            <div
                class="text-[10px] tracking-[0.25em] uppercase text-on-background/50 font-light"
            >
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
