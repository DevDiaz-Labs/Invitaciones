---
// src/pages/xv/std-simple.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;600&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            secondary: "#70585b",
                            "on-error-container": "#93000a",
                            "on-tertiary": "#ffffff",
                            "surface-tint": "#8c4b55",
                            "surface-container-highest": "#e4e3db",
                            "tertiary-container": "#cba72f",
                            "secondary-container": "#f8d8db",
                            primary: "#8a4853",
                            "on-surface-variant": "#524345",
                            "inverse-on-surface": "#f3f1e9",
                            "surface-container-low": "#f5f4ec",
                            "surface-variant": "#e4e3db",
                            "surface-dim": "#dcdad2",
                            "inverse-primary": "#ffb2bc",
                            "error-container": "#ffdad6",
                            "surface-bright": "#fbf9f1",
                            "surface-container-lowest": "#ffffff",
                            "on-error": "#ffffff",
                            "primary-fixed": "#ffd9dd",
                            "on-primary": "#ffffff",
                            "on-primary-container": "#fffbff",
                            "on-tertiary-fixed": "#241a00",
                            "on-secondary-fixed-variant": "#574144",
                            "inverse-surface": "#30312c",
                            "secondary-fixed-dim": "#debfc2",
                            "on-tertiary-container": "#4e3d00",
                            "surface-container-high": "#eae8e0",
                            "outline-variant": "#d7c1c3",
                            outline: "#857374",
                            "on-secondary-fixed": "#281719",
                            "on-surface": "#1b1c17",
                            "on-primary-fixed": "#3a0915",
                            "secondary-fixed": "#fbdbde",
                            "primary-fixed-dim": "#ffb2bc",
                            "on-secondary": "#ffffff",
                            "tertiary-fixed-dim": "#e9c349",
                            error: "#ba1a1a",
                            "on-tertiary-fixed-variant": "#574500",
                            tertiary: "#735c00",
                            "surface-container": "#f0eee6",
                            "on-background": "#1b1c17",
                            "tertiary-fixed": "#ffe088",
                            surface: "#fbf9f1",
                            "primary-container": "#a6606b",
                            "on-primary-fixed-variant": "#70343e",
                            "on-secondary-container": "#755d5f",
                            background: "#fbf9f1",
                        },
                        borderRadius: {
                            DEFAULT: "0.25rem",
                            lg: "0.5rem",
                            xl: "0.75rem",
                            full: "9999px",
                        },
                        spacing: {
                            gutter: "24px",
                            unit: "8px",
                            "margin-mobile": "20px",
                            "container-max": "1200px",
                            "section-gap": "80px",
                        },
                        fontFamily: {
                            "headline-lg": ["Noto Serif", "serif"],
                            "body-md": ["Plus Jakarta Sans", "sans-serif"],
                            "headline-md": ["Noto Serif", "serif"],
                            "body-lg": ["Plus Jakarta Sans", "sans-serif"],
                            "display-lg": ["Noto Serif", "serif"],
                            "label-md": ["Plus Jakarta Sans", "sans-serif"],
                        },
                        fontSize: {
                            "headline-lg": [
                                "40px",
                                {
                                    lineHeight: "48px",
                                    letterSpacing: "-0.01em",
                                    fontWeight: "600",
                                },
                            ],
                            "body-md": [
                                "16px",
                                { lineHeight: "24px", fontWeight: "400" },
                            ],
                            "headline-md": [
                                "32px",
                                { lineHeight: "40px", fontWeight: "600" },
                            ],
                            "body-lg": [
                                "18px",
                                { lineHeight: "28px", fontWeight: "400" },
                            ],
                            "display-lg": [
                                "64px",
                                {
                                    lineHeight: "72px",
                                    letterSpacing: "-0.02em",
                                    fontWeight: "700",
                                },
                            ],
                            "label-md": [
                                "14px",
                                {
                                    lineHeight: "20px",
                                    letterSpacing: "0.1em",
                                    fontWeight: "600",
                                },
                            ],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .glass-panel {
                background-color: rgba(251, 249, 241, 0.2);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-body-md antialiased min-h-screen flex flex-col selection:bg-primary selection:text-white"
    >
        <main class="flex-grow flex flex-col relative min-h-screen">
            <!-- Hero Section -->
            <section
                class="relative flex-grow flex flex-col justify-center overflow-hidden px-4 py-12 md:py-16 md:px-margin-mobile"
            >
                <!-- Background Image -->
                <div class="absolute inset-0 z-0">
                    <img
                        alt="Background floral texture"
                        class="w-full h-full object-cover object-center opacity-85"
                        src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/30 to-black/80"
                    >
                    </div>
                </div>

                <!-- Content -->
                <div
                    class="relative z-10 w-full flex-grow max-w-container-max mx-auto flex flex-col justify-between items-center text-center"
                >
                    <!-- Top Content: Name -->
                    <div class="mt-8 md:mt-12">
                        <h1
                            class="font-serif italic text-6xl md:text-8xl font-bold text-white mb-2 drop-shadow-xl tracking-wide"
                        >
                            Valeria
                        </h1>

                        <span
                            class="font-label-md text-[10px] md:text-xs uppercase tracking-[0.3em] md:tracking-[0.25em] text-primary-fixed drop-shadow-md"
                        >
                            Mis XV Años
                        </span>
                    </div>

                    <!-- Bottom Content: Info & Countdown -->
                    <div class="flex flex-col items-center w-full mb-4">
                        <span
                            class="font-label-md text-[10px] md:text-xs uppercase tracking-[0.25em] text-primary-fixed mb-3 md:mb-4 drop-shadow-md"
                        >
                            Save the Date
                        </span>

                        <p
                            class="font-body-md text-[13px] md:text-sm text-inverse-on-surface max-w-xl mx-auto mb-6 md:mb-8 drop-shadow-md px-4 leading-relaxed"
                        >
                            Por favor, acompáñanos a celebrar una noche de
                            elegancia, alegría y recuerdos inolvidables en mis
                            quince años.
                        </p>

                        <!-- Glassmorphic Countdown -->
                        <div
                            class="glass-panel rounded-2xl p-4 md:p-6 w-full max-w-2xl mb-8 flex justify-center items-center gap-2 md:gap-6 text-white"
                        >
                            <div class="flex flex-col items-center flex-1">
                                <span
                                    class="font-headline-lg text-2xl md:text-4xl text-white"
                                    >142</span
                                >
                                <span
                                    class="font-label-md text-[9px] md:text-[11px] text-white/80 uppercase tracking-widest mt-1 md:mt-2"
                                    >Días</span
                                >
                            </div>
                            <div class="w-px bg-white/20 h-8 md:h-12 self-center">
                            </div>
                            <div class="flex flex-col items-center flex-1">
                                <span
                                    class="font-headline-lg text-2xl md:text-4xl text-white"
                                    >08</span
                                >
                                <span
                                    class="font-label-md text-[9px] md:text-[11px] text-white/80 uppercase tracking-widest mt-1 md:mt-2"
                                    >Hrs</span
                                >
                            </div>
                            <div class="w-px bg-white/20 h-8 md:h-12 self-center">
                            </div>
                            <div class="flex flex-col items-center flex-1">
                                <span
                                    class="font-headline-lg text-2xl md:text-4xl text-white"
                                    >45</span
                                >
                                <span
                                    class="font-label-md text-[9px] md:text-[11px] text-white/80 uppercase tracking-widest mt-1 md:mt-2"
                                    >Min</span
                                >
                            </div>
                            <div class="w-px bg-white/20 h-8 md:h-12 self-center">
                            </div>
                            <div class="flex flex-col items-center flex-1">
                                <span
                                    class="font-headline-lg text-2xl md:text-4xl text-white"
                                    >12</span
                                >
                                <span
                                    class="font-label-md text-[9px] md:text-[11px] text-white/80 uppercase tracking-widest mt-1 md:mt-2"
                                    >Seg</span
                                >
                            </div>
                        </div>

                        <!-- Calendar Actions -->
                        <div
                            class="flex flex-col md:flex-row gap-3 w-full md:w-auto px-8 md:px-0"
                        >
                            <button
                                class="w-full md:w-auto bg-gradient-to-r from-primary to-primary-container text-on-primary px-6 py-3 rounded-full font-label-md text-[11px] md:text-xs uppercase tracking-widest border border-[#B76E79] shadow-[0_4px_15px_rgba(183,110,121,0.3)] hover:shadow-[0_6px_20px_rgba(183,110,121,0.4)] transition-all flex items-center justify-center gap-2"
                            >
                                <span class="material-symbols-outlined text-[16px]"
                                    >calendar_today</span
                                >
                                Google Calendar
                            </button>
                            <button
                                class="w-full md:w-auto bg-white/10 backdrop-blur-md text-white px-6 py-3 rounded-full font-label-md text-[11px] md:text-xs uppercase tracking-widest border border-white/30 hover:bg-white/20 transition-all flex items-center justify-center gap-2"
                            >
                                <span class="material-symbols-outlined text-[16px]"
                                    >event</span
                                >
                                Outlook
                            </button>
                            <button
                                class="w-full md:w-auto bg-white/10 backdrop-blur-md text-white px-6 py-3 rounded-full font-label-md text-[11px] md:text-xs uppercase tracking-widest border border-white/30 hover:bg-white/20 transition-all flex items-center justify-center gap-2"
                            >
                                <span class="material-symbols-outlined text-[16px]"
                                    >ios</span
                                >
                                iCal
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-10 border-t border-white/10 bg-[#141412] flex flex-col items-center gap-4 text-center"
        >
            <div class="text-white/90 font-bold font-serif text-2xl italic">
                Valeria
            </div>
            <div
                class="font-serif text-[10px] md:text-xs italic tracking-[0.2em] uppercase text-primary-fixed/80"
            >
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
