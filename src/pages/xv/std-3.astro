---
// src/pages/xv/std-3.astro
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Valeria's XV - Save the Date (Emerald & Gold)</title>
        <script
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
            is:inline></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Lato:wght@300;400;700&display=swap"
            rel="stylesheet"
        />

        <script id="tailwind-config" is:inline>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#0F2F1D", // Deep Emerald
                            secondary: "#D4AF37", // Metallic Gold
                            background: "#081A10", // Dark Forest
                            "on-background": "#F0F7F3", // Cream Mint
                            accent: "#E2C463",
                        },
                        fontFamily: {
                            serif: ["Cinzel", "serif"],
                            sans: ["Lato", "sans-serif"],
                        },
                    },
                },
            };
        </script>
        <style is:global>
            .gold-glow {
                box-shadow: 0 0 15px rgba(212, 175, 55, 0.15);
                border: 1px solid rgba(212, 175, 55, 0.3);
            }
            .gold-text-gradient {
                background: linear-gradient(135deg, #FFE082 0%, #D4AF37 50%, #B38F24 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .gold-bg-gradient {
                background: linear-gradient(135deg, #FFE082 0%, #D4AF37 50%, #B38F24 100%);
            }
            .corner-decor {
                width: 20px;
                height: 20px;
                position: absolute;
                border-color: rgba(212, 175, 55, 0.6);
                border-width: 0;
            }
            .corner-tl { top: 12px; left: 12px; border-top-width: 2px; border-left-width: 2px; }
            .corner-tr { top: 12px; right: 12px; border-top-width: 2px; border-right-width: 2px; }
            .corner-bl { bottom: 12px; left: 12px; border-bottom-width: 2px; border-left-width: 2px; }
            .corner-br { bottom: 12px; right: 12px; border-bottom-width: 2px; border-right-width: 2px; }
        </style>
    </head>
    <body
        class="bg-background text-on-background font-sans antialiased min-h-screen flex flex-col selection:bg-secondary selection:text-background"
    >
        <main class="flex-grow flex flex-col relative min-h-screen overflow-hidden">
            <!-- Floating Back to Catalog Button -->
            <a
                id="smart-back-btn"
                href="/xv/catalogo"
                class="fixed top-4 left-4 z-50 bg-black/60 hover:bg-black/85 backdrop-blur-md text-white px-4 py-2 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-widest flex items-center gap-2 border border-white/20 transition-all shadow-lg"
            >
                <span id="smart-back-icon" class="material-symbols-outlined text-[14px] md:text-[16px]">arrow_back</span>
                <span id="smart-back-text">Catálogo</span>
            </a>
            <script>
                if (document.referrer.includes('/estudio')) {
                    const btn = document.getElementById('smart-back-btn');
                    if (btn) {
                        btn.href = 'javascript:void(0)';
                        btn.onclick = function(e) { e.preventDefault(); window.close(); };
                        document.getElementById('smart-back-text').innerText = 'Cerrar';
                        document.getElementById('smart-back-icon').innerText = 'close';
                    }
                }
            </script>
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img
                    alt="Floral background"
                    class="w-full h-full object-cover object-center opacity-30"
                    src="https://images.unsplash.com/photo-1714611302520-5afa2c3e26df?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-b from-background/95 via-background/70 to-background/95"
                >
                </div>
            </div>

            <!-- Content Container -->
            <div class="relative z-10 w-full flex-grow max-w-4xl mx-auto flex flex-col justify-between items-center text-center px-6 py-16 md:py-20">
                
                <!-- Frame with Gold Corners -->
                <div class="absolute inset-6 md:inset-8 border border-secondary/15 pointer-events-none rounded-lg">
                    <div class="corner-decor corner-tl"></div>
                    <div class="corner-decor corner-tr"></div>
                    <div class="corner-decor corner-bl"></div>
                    <div class="corner-decor corner-br"></div>
                </div>

                <!-- Top: Name & Invitation Tag -->
                <div class="mt-6">
                    <span class="font-serif text-[10px] md:text-xs uppercase tracking-[0.4em] text-secondary font-semibold">
                        Te invitamos a celebrar
                    </span>
                    <h1 class="font-serif text-5xl md:text-7xl font-bold tracking-widest uppercase mt-4 mb-2 gold-text-gradient drop-shadow-md">
                        Valeria
                    </h1>
                    <span class="text-xs tracking-[0.3em] text-on-background/60 uppercase">
                        Mis XV Años
                    </span>
                </div>

                <!-- Middle: Save the Date & Countdown -->
                <div class="flex flex-col items-center w-full max-w-xl my-6">
                    <p class="text-xs uppercase tracking-[0.25em] text-secondary font-semibold mb-6">
                        —— Save the Date ——
                    </p>

                    <p class="text-sm text-on-background/80 leading-relaxed font-light mb-8 max-w-md">
                        Reserva este gran día para acompañarme en una velada inolvidable inspirada en la elegancia y la magia de los quince años.
                    </p>

                    <!-- Glowing Emerald Countdown Cards -->
                    <div class="grid grid-cols-4 gap-3 w-full max-w-md">
                        <div class="gold-glow bg-primary/40 backdrop-blur-sm rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-secondary font-bold">142</span>
                            <span class="text-[9px] text-on-background/50 uppercase tracking-widest mt-1">Días</span>
                        </div>
                        <div class="gold-glow bg-primary/40 backdrop-blur-sm rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-secondary font-bold">08</span>
                            <span class="text-[9px] text-on-background/50 uppercase tracking-widest mt-1">Hrs</span>
                        </div>
                        <div class="gold-glow bg-primary/40 backdrop-blur-sm rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-secondary font-bold">45</span>
                            <span class="text-[9px] text-on-background/50 uppercase tracking-widest mt-1">Min</span>
                        </div>
                        <div class="gold-glow bg-primary/40 backdrop-blur-sm rounded p-4 flex flex-col items-center">
                            <span class="font-serif text-2xl md:text-3xl text-secondary font-bold">12</span>
                            <span class="text-[9px] text-on-background/50 uppercase tracking-widest mt-1">Seg</span>
                        </div>
                    </div>
                </div>

                <!-- Bottom: Actions -->
                <div class="flex flex-col sm:flex-row gap-3 w-full max-w-md mb-6 justify-center">
                    <button
                        class="w-full sm:w-auto gold-bg-gradient text-background px-6 py-3 rounded-full font-bold text-xs uppercase tracking-widest hover:opacity-95 transition-all shadow-[0_4px_15px_rgba(212,175,55,0.3)] flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px] font-bold">calendar_today</span>
                        Google Calendar
                    </button>
                    <button
                        class="w-full sm:w-auto bg-transparent border border-secondary text-secondary px-6 py-3 rounded-full font-bold text-xs uppercase tracking-widest hover:bg-secondary/10 transition-all flex items-center justify-center gap-2"
                    >
                        <span class="material-symbols-outlined text-[16px] font-bold">event</span>
                        iCal / Outlook
                    </button>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer
            class="w-full py-8 border-t border-secondary/15 bg-[#040C08] flex flex-col items-center gap-2 text-center"
        >
            <div class="gold-text-gradient font-serif text-xl tracking-widest uppercase font-bold">
                Valeria
            </div>
            <div class="text-[9px] tracking-[0.3em] uppercase text-on-background/45">
                © 2024 Celebrando Quince Años
            </div>
        </footer>
    </body>
</html>
