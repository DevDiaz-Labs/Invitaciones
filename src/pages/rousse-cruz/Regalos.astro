---
// Regalos.astro
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    mostrarDatosBancarios?: boolean;
    amazon_liverpool?: boolean;
    datosBancarios?: string;
    mostrarDatosBancarios?: boolean;
    amazon_liverpool?: boolean;
  };
}
const { data } = Astro.props;
---

<section class="py-24 md:py-32 px-6 text-center bg-[var(--gold)]/5">
    <div class="max-w-4xl mx-auto space-y-16">
        <h3
            class="font-serif text-5xl text-[var(--gold)] italic observe-me fade-up"
        >
            Regalos
        </h3>

        <div class="flex flex-row justify-center items-center gap-12 md:gap-24 observe-me fade-up" style="transition-delay: 200ms;">
            {data.opcionEfectivo && (
                <div class="flex flex-col items-center group">
                    <div class="w-20 h-20 md:w-24 md:h-24 flex items-center justify-center text-[var(--gold)] mb-4 border border-[var(--gold)]/30 rounded-full p-5 bg-white/50 group-hover:scale-110 transition-transform shadow-sm">
                        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <span class="text-xs md:text-sm tracking-[0.2em] text-[var(--gold)] font-medium uppercase text-center mt-2">Lluvia de Sobres</span>
                </div>
            )}

            {data.opcionMesa && (
                <div class="flex flex-col items-center group">
                    <div class="w-20 h-20 md:w-24 md:h-24 flex items-center justify-center text-[var(--gold)] mb-4 border border-[var(--gold)]/30 rounded-full p-5 bg-white/50 group-hover:scale-110 transition-transform shadow-sm">
                        <svg viewBox="0 0 24 24" fill="none" class="w-full h-full" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 12 20 22 4 22 4 12"></polyline>
                            <rect x="2" y="7" width="20" height="5"></rect>
                            <line x1="12" y1="22" x2="12" y2="7"></line>
                            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                        </svg>
                    </div>
                    <span class="text-xs md:text-sm tracking-[0.2em] text-[var(--gold)] font-medium uppercase text-center mt-2">Regalo Físico</span>
                </div>
            )}
        </div>

        <div class="pt-10 observe-me fade-in-slow" style="transition-delay: 600ms;">
            <p class="text-[var(--dark-text)]/50 italic text-sm md:text-base leading-relaxed max-w-2xl mx-auto border-t border-[var(--gold)]/20 pt-8 mt-10">
                "{data.mensaje}"
            </p>
        </div>
    </div>
</section>
