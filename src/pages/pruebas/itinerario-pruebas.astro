---
// src/pages/pruebas/itinerario-pruebas.astro
import ItinerarioMinimalista from "../../components/itinerario/ItinerarioMinimalista.astro";
import ItinerarioBoho from "../../components/itinerario/ItinerarioBoho.astro";
import ItinerarioElegant from "../../components/itinerario/ItinerarioElegant.astro";
import ItinerarioTimeline from "../../components/itinerario/ItinerarioTimeline.astro";
import ItinerarioGlass from "../../components/itinerario/ItinerarioGlass.astro";
import ItinerarioCard from "../../components/itinerario/ItinerarioCard.astro";
import ItinerarioVibrant from "../../components/itinerario/ItinerarioVibrant.astro";
import ItinerarioPolaroid from "../../components/itinerario/ItinerarioPolaroid.astro";
import ItinerarioRetro from "../../components/itinerario/ItinerarioRetro.astro";
import ItinerarioClassic from "../../components/itinerario/ItinerarioClassic.astro";

// Nuevos componentes restantes
import ItinerarioCircularSteps from "../../components/itinerario/ItinerarioCircularSteps.astro";
import ItinerarioAccordion from "../../components/itinerario/ItinerarioAccordion.astro";
import ItinerarioMetro from "../../components/itinerario/ItinerarioMetro.astro";
import ItinerarioHorizontalScroll from "../../components/itinerario/ItinerarioHorizontalScroll.astro";
import ItinerarioEditorialBold from "../../components/itinerario/ItinerarioEditorialBold.astro";
import ItinerarioGlowNeon from "../../components/itinerario/ItinerarioGlowNeon.astro";
import ItinerarioRoyalGold from "../../components/itinerario/ItinerarioRoyalGold.astro";

const mockData = {
  mostrar: true,
  nombres: 'Ana & Carlos',
  titulo: 'Mesa de Regalos / Lluvia de Sobres',
  fechaVista: '13 · Junio · 2026',
  fecha: '2026-06-13',
  frase: 'El mejor regalo es tu presencia',
  imagenFondo: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  imagen: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  hashtag: '#AnaYCarlos',
  mensaje: 'Esperamos contar con tu presencia',
  texto: 'Haremos de este día algo inolvidable',
  urlSpotify: 'https://open.spotify.com/playlist/37i9dQZF1DWV7EzJMK2FUI',
  banco: 'BBVA',
  cuenta: '0123456789',
  clabe: '012345678901234567',
  titular: 'Ana Sofia Valdes',
  amazon: '#',
  liverpool: '#',
  eventos: [
    { hora: '17:00', nombre: 'Ceremonia Religiosa', lugar: 'Parroquia de San Miguel', icono: 'iglesia' },
    { hora: '18:30', nombre: 'Cóctel de Bienvenida', lugar: 'Jardines de la Hacienda', icono: 'fiesta' },
    { hora: '20:00', nombre: 'Cena y Brindis', lugar: 'Salón Principal', icono: 'cena' },
    { hora: '22:00', nombre: 'Apertura de Pista', lugar: '¡A bailar toda la noche!', icono: 'baile' }
  ],
  itinerario: [
    { time: '17:00', event: 'Ceremonia Religiosa', desc: 'Parroquia de San Miguel' },
    { time: '18:30', event: 'Cóctel de Bienvenida', desc: 'Jardines de la Hacienda' },
    { time: '20:00', event: 'Cena y Brindis', desc: 'Salón Principal' },
    { time: '22:00', event: 'Apertura de Pista', desc: '¡A bailar toda la noche!' }
  ],
  dressCode: {
    titulo: 'Formal',
    subtitulo: 'Traje oscuro y vestido largo',
    nota: 'La recepción será en un jardín, sugerimos considerar el calzado para tu comodidad.'
  },
  galeria: [
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800',
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800'
  ]
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catálogo: Componentes Itinerario</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Great+Vibes&family=Sacramento&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Componentes Itinerario</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 17 diseños de itinerario premium para invitaciones de XV años, bodas y eventos especiales.
        </p>
      </header>

      <!-- 1. Itinerario Minimalista -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Itinerario Minimalista</span>
        </div>
        <div class="relative w-full">
          <ItinerarioMinimalista data={mockData} />
        </div>
      </section>

      <!-- 2. Itinerario Boho -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Itinerario Boho</span>
        </div>
        <div class="relative w-full">
          <ItinerarioBoho data={mockData} />
        </div>
      </section>

      <!-- 3. Itinerario Elegant -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. Itinerario Elegant</span>
        </div>
        <div class="relative w-full">
          <ItinerarioElegant data={mockData} />
        </div>
      </section>

      <!-- 4. Itinerario Timeline -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. Itinerario Timeline</span>
        </div>
        <div class="relative w-full">
          <ItinerarioTimeline data={mockData} />
        </div>
      </section>

      <!-- 5. Itinerario Glass -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. Itinerario Glass</span>
        </div>
        <div class="relative w-full">
          <ItinerarioGlass data={mockData} />
        </div>
      </section>

      <!-- 6. Itinerario Card -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. Itinerario Card</span>
        </div>
        <div class="relative w-full">
          <ItinerarioCard data={mockData} />
        </div>
      </section>

      <!-- 7. Itinerario Vibrant -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. Itinerario Vibrant</span>
        </div>
        <div class="relative w-full">
          <ItinerarioVibrant data={mockData} />
        </div>
      </section>

      <!-- 8. Itinerario Polaroid -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>8. Itinerario Polaroid</span>
        </div>
        <div class="relative w-full">
          <ItinerarioPolaroid data={mockData} />
        </div>
      </section>

      <!-- 9. Itinerario Retro -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. Itinerario Retro</span>
        </div>
        <div class="relative w-full">
          <ItinerarioRetro data={mockData} />
        </div>
      </section>

      <!-- 10. Itinerario Classic -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>10. Itinerario Classic</span>
        </div>
        <div class="relative w-full">
          <ItinerarioClassic data={mockData} />
        </div>
      </section>

      <!-- 11. Itinerario Ruta en Curva -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. Itinerario Ruta en Curva</span>
        </div>
        <div class="relative w-full">
          <ItinerarioCircularSteps data={mockData} />
        </div>
      </section>

      <!-- 12. Itinerario Acordeón -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>12. Itinerario Acordeón</span>
        </div>
        <div class="relative w-full">
          <ItinerarioAccordion data={mockData} />
        </div>
      </section>

      <!-- 13. Itinerario Mapa de Estaciones -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>13. Itinerario Mapa de Estaciones</span>
        </div>
        <div class="relative w-full">
          <ItinerarioMetro data={mockData} />
        </div>
      </section>

      <!-- 14. Itinerario Deslizador Horizontal -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>14. Itinerario Deslizador Horizontal</span>
        </div>
        <div class="relative w-full">
          <ItinerarioHorizontalScroll data={mockData} />
        </div>
      </section>

      <!-- 15. Itinerario Tipografía Gigante Solapada -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>15. Itinerario Tipografía Gigante Solapada</span>
        </div>
        <div class="relative w-full">
          <ItinerarioEditorialBold data={mockData} />
        </div>
      </section>

      <!-- 16. Itinerario Neón Cyber/Festival Dark -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>16. Itinerario Neón Cyber/Festival Dark</span>
        </div>
        <div class="relative w-full">
          <ItinerarioGlowNeon data={mockData} />
        </div>
      </section>

      <!-- 17. Itinerario Clásico Imperial -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>17. Itinerario Clásico Imperial</span>
        </div>
        <div class="relative w-full">
          <ItinerarioRoyalGold data={mockData} />
        </div>
      </section>

    </main>
  </body>
</html>
