---
// src/pages/pruebas/hero-pruebas.astro
import HeroBoho from "../../components/hero/HeroBoho.astro";
import HeroMinimalista from "../../components/hero/HeroMinimalista.astro";
import HeroSofia from "../../components/xv-plantilla/Hero.astro";
import HeroClassic from "../../components/hero/HeroClassic.astro";
import HeroLuxury from "../../components/hero/HeroLuxury.astro";
import HeroVintage from "../../components/hero/HeroVintage.astro";
import HeroNature from "../../components/hero/HeroNature.astro";
import HeroRomantic from "../../components/hero/HeroRomantic.astro";
import HeroXVMiniVideoStyle from "../../components/hero/HeroXVMiniVideoStyle.astro";
import HeroXVEditorialBold from "../../components/hero/HeroXVEditorialBold.astro";
import HeroXVRoseGold from "../../components/hero/HeroXVRoseGold.astro";
import HeroXVStarlight from "../../components/hero/HeroXVStarlight.astro";
import HeroXVWatercolor from "../../components/hero/HeroXVWatercolor.astro";
import HeroXVDrama from "../../components/hero/HeroXVDrama.astro";
import HeroXVMinimalElegance from "../../components/hero/HeroXVMinimalElegance.astro";
import HeroXVArchFlowers from "../../components/hero/HeroXVArchFlowers.astro";
import HeroWeddingModernDate from "../../components/hero/HeroWeddingModernDate.astro";
import HeroWeddingClassicArch from "../../components/hero/HeroWeddingClassicArch.astro";
import HeroWeddingElegantPortal from "../../components/hero/HeroWeddingElegantPortal.astro";

import dataXV from "../../data/clientes/ejemplo-xv.json";

const mockData = {
  mostrar: true,
  nombres: 'Ana & Carlos',
  titulo: 'Mesa de Regalos / Lluvia de Sobres',
  fechaVista: '24 de Octubre de 2026',
  fecha: '2026-10-24',
  frase: 'Con la bendición del amor, unimos nuestras vidas.',
  imagenFondo: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80',
  imagen: 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80',
  hashtag: '#AnaYCarlos',
  mensaje: 'Esperamos contar con tu presencia',
  texto: 'Haremos de este día algo inolvidable',
  urlSpotify: 'https://open.spotify.com/playlist/37i9dQZF1DWV7EzJMK2FUI',
  banco: 'BBVA',
  cuenta: '0123456789',
  clabe: '012345678901234567',
  titular: 'Ana Sofia Valdes',
  amazon: '#',
  liverpool: '#',
  eventos: [
    { hora: '16:00', nombre: 'Ceremonia', lugar: 'Templo Expiatorio', icono: 'iglesia' },
    { hora: '18:00', nombre: 'Recepción', lugar: 'Salón de Eventos', icono: 'fiesta' }
  ],
  itinerario: [
    { time: '16:00', event: 'Ceremonia', desc: 'Templo Expiatorio' },
    { time: '18:00', event: 'Recepción', desc: 'Salón de Eventos' }
  ],
  dressCode: {
    titulo: 'Formal',
    subtitulo: 'Traje oscuro y vestido largo',
    nota: 'La recepción será en un jardín, sugerimos considerar el calzado para tu comodidad.'
  },
  galeria: [
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800',
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800'
  ]
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catálogo: Componentes Hero</title>

    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Great+Vibes&family=Sacramento&display=swap" rel="stylesheet" />

    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              boho: {
                terracota: '#CD5C5C',
                arena: '#F4F1DE',
                eucalipto: '#81B29A',
                rosa: '#E8C3B9',
                dorado: '#C5A059'
              },
              'boho-terracota': '#CD5C5C',
              'boho-arena': '#F4F1DE',
              'boho-eucalipto': '#81B29A',
              'boho-rosa': '#E8C3B9',
              'boho-dorado': '#C5A059'
            },
            fontFamily: {
              sans: ['"Inter"', 'sans-serif'],
              serif: ['"Playfair Display"', 'serif'],
              handwriting: ['"Great Vibes"', 'cursive']
            }
          }
        }
      }
    </script>

    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
      .font-nombres {
        font-family: 'Great Vibes', cursive !important;
      }
      .section-divider {
        height: 1px;
        width: 120px;
        background: linear-gradient(90deg, transparent, #D4AF37, transparent);
        margin: 2rem auto;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">

      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Componentes Hero</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 19 diseños de hero premium para invitaciones de XV años y bodas.
        </p>
      </header>

      <!-- 1. HeroBoho -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Hero Boho</span>
          
        </div>
        <div class="relative w-full">
          <HeroBoho data={mockData} />
        </div>
      </section>

      <!-- 2. HeroMinimalista -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Hero Minimalista</span>
          
        </div>
        <div class="relative w-full">
          <HeroMinimalista data={mockData} />
        </div>
      </section>

      <!-- 3. HeroSofia (XV) -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. Hero XV Sofía</span>
          
        </div>
        <div class="relative w-full">
          <HeroSofia data={dataXV.hero} />
        </div>
      </section>

      <!-- 4. HeroClassic -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. Hero Classic</span>
          
        </div>
        <div class="relative w-full">
          <HeroClassic data={mockData} />
        </div>
      </section>

      <!-- 5. HeroLuxury -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. Hero Luxury</span>
          
        </div>
        <div class="relative w-full">
          <HeroLuxury data={mockData} />
        </div>
      </section>

      <!-- 6. HeroVintage -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. Hero Vintage</span>
          
        </div>
        <div class="relative w-full">
          <HeroVintage data={mockData} />
        </div>
      </section>

      <!-- 7. HeroNature -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. Hero Nature</span>
          
        </div>
        <div class="relative w-full">
          <HeroNature data={mockData} />
        </div>
      </section>

      <!-- 8. HeroRomantic -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>8. Hero Romantic</span>
          
        </div>
        <div class="relative w-full">
          <HeroRomantic data={mockData} />
        </div>
      </section>

      <!-- 9. HeroXVMiniVideoStyle -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. Hero XV Mini Video</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVMiniVideoStyle data={dataXV.hero} />
        </div>
      </section>

      <!-- 10. HeroXVEditorialBold -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>10. Hero XV Editorial Bold</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVEditorialBold data={dataXV.hero} />
        </div>
      </section>

      <!-- 11. HeroXVRoseGold -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. Hero XV Rose Gold</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVRoseGold data={dataXV.hero} />
        </div>
      </section>

      <!-- 12. HeroXVStarlight -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>12. Hero XV Starlight</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVStarlight data={dataXV.hero} />
        </div>
      </section>

      <!-- 13. HeroXVWatercolor -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>13. Hero XV Watercolor</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVWatercolor data={dataXV.hero} />
        </div>
      </section>

      <!-- 14. HeroXVDrama -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>14. Hero XV Drama</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVDrama data={dataXV.hero} />
        </div>
      </section>

      <!-- 15. HeroXVMinimalElegance -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>15. Hero XV Minimal Elegance</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVMinimalElegance data={dataXV.hero} />
        </div>
      </section>

      <!-- 16. HeroXVArchFlowers -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>16. Hero XV Arch Flowers</span>
          
        </div>
        <div class="relative w-full">
          <HeroXVArchFlowers data={{
            ...dataXV.hero,
            imagen: "/imagenes/xv/ejemplo/ejemplo2.jpg"
          }} />
        </div>
      </section>

      <!-- 17. HeroWeddingModernDate -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>17. Hero Wedding Modern Date</span>
          
        </div>
        <div class="relative w-full">
          <HeroWeddingModernDate data={{
            ...mockData,
            nombres: "Daniel & Nohemí",
            fecha: "2026-12-29",
            imagen: "/imagenes/imagenes/hero-wedding-modern-date.avif"
          }} />
        </div>
      </section>

      <!-- 18. HeroWeddingClassicArch -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>18. Hero Wedding Classic Arch</span>
          
        </div>
        <div class="relative w-full">
          <HeroWeddingClassicArch data={{
            ...mockData,
            nombres: "Nuestra Boda",
            fecha: "2026-11-22",
            imagen: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=800&auto=format&fit=crop"
          }} />
        </div>
      </section>

      <!-- 19. HeroWeddingElegantPortal -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>19. Hero Wedding Elegant Portal</span>
          
        </div>
        <div class="relative w-full">
          <HeroWeddingElegantPortal data={{
            ...mockData,
            nombres: "Janette & Arturo",
            invitado: "Familia Medina",
            fecha: "2025-02-22",
            imagen: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=800&auto=format&fit=crop"
          }} />
        </div>
      </section>

    </main>
  </body>
</html>
