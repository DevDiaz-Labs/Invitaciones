---
// src/pages/pruebas/ubicacion-pruebas.astro
import UbicacionVertical from "../../components/ubicacion/UbicacionVertical.astro";
import UbicacionBoho from "../../components/ubicacion/UbicacionBoho.astro";
import UbicacionVIP from "../../components/ubicacion/UbicacionVIP.astro";
import UbicacionMiniMapas from "../../components/ubicacion/UbicacionMiniMapas.astro";
import UbicacionRosada from "../../components/ubicacion/UbicacionRosada.astro";
import UbicacionNocturna from "../../components/ubicacion/UbicacionNocturna.astro";
import UbicacionNatural from "../../components/ubicacion/UbicacionNatural.astro";
import UbicacionRustica from "../../components/ubicacion/UbicacionRustica.astro";
import UbicacionLujo from "../../components/ubicacion/UbicacionLujo.astro";
import UbicacionFiesta from "../../components/ubicacion/UbicacionFiesta.astro";
import UbicacionMapaFull from "../../components/ubicacion/UbicacionMapaFull.astro";
import UbicacionTimeline from "../../components/ubicacion/UbicacionTimeline.astro";
import UbicacionCyberpunk from "../../components/ubicacion/UbicacionCyberpunk.astro";
import UbicacionMinimalistaBlanco from "../../components/ubicacion/UbicacionMinimalistaBlanco.astro";
import UbicacionAcuarela from "../../components/ubicacion/UbicacionAcuarela.astro";
import UbicacionRetro from "../../components/ubicacion/UbicacionRetro.astro";
import UbicacionVintage from "../../components/ubicacion/UbicacionVintage.astro";

// Datos de prueba (Mocks) que emulan a un cliente real
const datosEjemplo = {
  ceremonia: {
    titulo: "Ceremonia Religiosa",
    hora: "5:00 PM",
    lugar: "Parroquia San Nicolás de Tolentino",
    direccion: "Porfirio Díaz 301, Centro, 66400 San Nicolás de los Garza, N.L.",
    urlMapa: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d57494.86451052193!2d-100.32446332089843!3d25.7563889!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8662958aa47c624b%3A0x664162c39ee5666c!2sParroquia%20San%20Nicol%C3%A1s%20de%20Tolentino!5e0!3m2!1ses-419!2smx!4v1777948217738!5m2!1ses-419!2smx",
    urlMapaDirecto: "https://maps.app.goo.gl/nChdbuvJd5tXGrDMA",
    iframeMapa: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d57494.86451052193!2d-100.32446332089843!3d25.7563889!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8662958aa47c624b%3A0x664162c39ee5666c!2sParroquia%20San%20Nicol%C3%A1s%20de%20Tolentino!5e0!3m2!1ses-419!2smx!4v1777948217738!5m2!1ses-419!2smx"
  },
  recepcion: {
    titulo: "Recepción",
    hora: "7:00 PM",
    lugar: "Salón La Cúpula",
    direccion: "Calle Mariano Matamoros 1270 A, C. Mariano Matamoros 1270-A, Sin Nombre de Col 6, 66428 San Nicolás de los Garza, N.L.",
    urlMapa: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3593.1547545697626!2d-100.29724060000002!3d25.76545149999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86629483c92138dd%3A0x1a303f693d501479!2sLa%20C%C3%BApula!5e0!3m2!1ses-419!2smx!4v1777948266752!5m2!1ses-419!2smx",
    urlMapaDirecto: "https://maps.app.goo.gl/qAZBTAwonZYxcu2eA",
    iframeMapa: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3593.1547545697626!2d-100.29724060000002!3d25.76545149999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86629483c92138dd%3A0x1a303f693d501479!2sLa%20C%C3%BApula!5e0!3m2!1ses-419!2smx!4v1777948266752!5m2!1ses-419!2smx"
  },
  notaEmocional: "Nuestra mayor alegría es poder compartir este día tan especial con las personas que más amamos.",
  calendario: {
    google: "https://calendar.google.com/calendar/render?action=TEMPLATE&text=Mis+XV+Alisson+Sanju%C3%A1nero&dates=20260613T220000Z/20260614T070000Z&details=¡Los+esperamos!",
    apple: "#"
  }
};

const bgFoto = "https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componente Ubicacion</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'grad-bg': '#0f0e0f',
              'grad-secondary': '#d4a373',
            },
            fontFamily: {
              sans: ['"Montserrat"', '"Plus Jakarta Sans"', "sans-serif"],
              serif: ['"Playfair Display"', '"Noto Serif"', "serif"],
            }
          }
        }
      };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
      .font-nombres {
        font-family: 'Great Vibes', cursive !important;
      }
      .section-divider {
        height: 1px;
        width: 120px;
        background: linear-gradient(90deg, transparent, #D4AF37, transparent);
        margin: 2rem auto;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Componentes de Ubicación</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 17 diseños de ubicación premium para invitaciones de XV años, bodas y eventos especiales.
        </p>
      </header>

      <!-- ======================== EXISTENTES ======================== -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Vertical Style</span>
        </div>
        <div class="relative w-full">
          <UbicacionVertical 
            data={datosEjemplo} 
            bgImageCeremonia={bgFoto} 
            bgImageRecepcion={bgFoto} 
          />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Boho Style</span>
        </div>
        <div class="relative w-full">
          <UbicacionBoho data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. VIP Style (Graduación / Oscuro)</span>
        </div>
        <div class="relative w-full">
          <UbicacionVIP data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. Mini Mapas Style (Boda Minimalista)</span>
        </div>
        <div class="relative w-full">
          <UbicacionMiniMapas data={datosEjemplo} />
        </div>
      </section>

      <!-- ======================== NUEVOS ======================== -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. Rosada Style (Rosa Palo + Corazones)</span>
        </div>
        <div class="relative w-full">
          <UbicacionRosada data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. Nocturna Style (Dark Elegante + Estrellas)</span>
        </div>
        <div class="relative w-full">
          <UbicacionNocturna data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. Natural Style (Verde Oliva + Hojas Eco)</span>
        </div>
        <div class="relative w-full">
          <UbicacionNatural data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>8. Rustica Style (Campo / Kraft + Brújula)</span>
        </div>
        <div class="relative w-full">
          <UbicacionRustica data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. Lujo Style (Crema / Champagne + Oro)</span>
        </div>
        <div class="relative w-full">
          <UbicacionLujo data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>10. Fiesta Style (Colores Vibrantes + Festivo)</span>
        </div>
        <div class="relative w-full">
          <UbicacionFiesta data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. Mapa Full Style (Mapa como Protagonista)</span>
        </div>
        <div class="relative w-full">
          <UbicacionMapaFull data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>12. Timeline Style (Ceremonia → Recepción)</span>
        </div>
        <div class="relative w-full">
          <UbicacionTimeline data={datosEjemplo} />
        </div>
      </section>

      <!-- ======================== NUEVOS 10 CREADOS ======================== -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>13. Cyberpunk Style (Neon + Grid)</span>
        </div>
        <div class="relative w-full">
          <UbicacionCyberpunk data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>14. Minimalista Blanco Style (Limpio + Elegante)</span>
        </div>
        <div class="relative w-full">
          <UbicacionMinimalistaBlanco data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>15. Acuarela Style (Suave + Pastel)</span>
        </div>
        <div class="relative w-full">
          <UbicacionAcuarela data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>16. Retro Style (Sepia + Dashed Borders)</span>
        </div>
        <div class="relative w-full">
          <UbicacionRetro data={datosEjemplo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>17. Vintage Style (Paper + Typewriter)</span>
        </div>
        <div class="relative w-full">
          <UbicacionVintage data={datosEjemplo} />
        </div>
      </section>

    </main>
  </body>
</html>
