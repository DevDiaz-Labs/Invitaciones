---
// src/pages/pruebas/compartirmomentos-pruebas.astro
import CapturaMinimalista from "../../components/compartirmomentos/CapturaMinimalista.astro";
import CompartirMomentosXV from "../../components/compartirmomentos/CompartirMomentosXV.astro";
import CompartirBoho from "../../components/compartirmomentos/CompartirBoho.astro";
import CompartirDarkGlass from "../../components/compartirmomentos/CompartirDarkGlass.astro";
import CompartirRetro from "../../components/compartirmomentos/CompartirRetro.astro";
import CompartirNeon from "../../components/compartirmomentos/CompartirNeon.astro";
import CompartirPolaroid from "../../components/compartirmomentos/CompartirPolaroid.astro";
import CompartirElegantSerif from "../../components/compartirmomentos/CompartirElegantSerif.astro";
import CompartirPlayful from "../../components/compartirmomentos/CompartirPlayful.astro";
import CompartirGradient from "../../components/compartirmomentos/CompartirGradient.astro";
import CompartirCinematic from "../../components/compartirmomentos/CompartirCinematic.astro";
import CompartirNature from "../../components/compartirmomentos/CompartirNature.astro";

const mockData = {
  mostrar: true,
  nombres: 'Ana & Carlos',
  titulo: 'Compárteme tus fotos',
  fechaVista: '13 · Junio · 2026',
  fecha: '2026-06-13',
  frase: 'El mejor regalo es tu presencia y los recuerdos que capturemos.',
  imagenFondo: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  imagen: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  hashtag: '#AnaYCarlos',
  mensaje: 'Esperamos contar con tu presencia',
  texto: 'Haremos de este día algo inolvidable',
  urlSpotify: 'https://open.spotify.com/playlist/37i9dQZF1DWV7EzJMK2FUI',
  banco: 'BBVA',
  cuenta: '0123456789',
  clabe: '012345678901234567',
  titular: 'Ana Sofia Valdes',
  amazon: '#',
  liverpool: '#',
  eventos: [
    { hora: '16:00', nombre: 'Ceremonia', lugar: 'Templo Expiatorio', icono: 'iglesia' },
    { hora: '18:00', nombre: 'Recepción', lugar: 'Salón de Eventos', icono: 'fiesta' }
  ],
  itinerario: [
    { time: '16:00', event: 'Ceremonia', desc: 'Templo Expiatorio' },
    { time: '18:00', event: 'Recepción', desc: 'Salón de Eventos' }
  ],
  dressCode: {
    titulo: 'Formal',
    subtitulo: 'Traje oscuro y vestido largo',
    nota: 'La recepción será en un jardín, sugerimos considerar el calzado para tu comodidad.'
  },
  galeria: [
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800',
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800'
  ],
  urlBoton: 'https://wa.me/1234567890',
  textoBoton: 'Subir Fotos'
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componentes de COMPARTIRMOMENTOS</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
      .font-nombres {
        font-family: 'Great Vibes', cursive !important;
      }
      .section-divider {
        height: 1px;
        width: 120px;
        background: linear-gradient(90deg, transparent, #D4AF37, transparent);
        margin: 2rem auto;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24 overflow-hidden">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Compartir Momentos</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 12 diseños para invitar a tus invitados a subir fotos de tu evento.
        </p>
      </header>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Captura Minimalista</span>
        </div>
        <div class="relative w-full">
          <CapturaMinimalista data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Compartir Momentos XV</span>
        </div>
        <div class="relative w-full">
          <CompartirMomentosXV data={{
            ...mockData,
            titulo: "Compárteme tus fotos",
            frase: "Los recuerdos que tendré contigo serán muy importantes.<br><br>Agradezco que me compartas tus fotos y videos que tomes durante el evento en esta carpeta:",
            textoBoton: "SUBIR FOTOS"
          }} bgImage={mockData.imagenFondo} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. Compartir Boho Style</span>
        </div>
        <div class="relative w-full">
          <CompartirBoho data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. Compartir Dark Glass Style</span>
        </div>
        <div class="relative w-full">
          <CompartirDarkGlass data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. Compartir Retro Style</span>
        </div>
        <div class="relative w-full">
          <CompartirRetro data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. Compartir Neon Style</span>
        </div>
        <div class="relative w-full">
          <CompartirNeon data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. Compartir Polaroid Style</span>
        </div>
        <div class="relative w-full">
          <CompartirPolaroid data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>8. Compartir Elegant Serif Style</span>
        </div>
        <div class="relative w-full">
          <CompartirElegantSerif data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. Compartir Playful Style</span>
        </div>
        <div class="relative w-full">
          <CompartirPlayful data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>10. Compartir Gradient Style</span>
        </div>
        <div class="relative w-full">
          <CompartirGradient data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. Compartir Cinematic Style</span>
        </div>
        <div class="relative w-full">
          <CompartirCinematic data={mockData} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>12. Compartir Nature Style</span>
        </div>
        <div class="relative w-full">
          <CompartirNature data={mockData} />
        </div>
      </section>

    </main>
  </body>
</html>
