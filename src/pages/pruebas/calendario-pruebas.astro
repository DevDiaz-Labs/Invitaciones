---
// src/pages/pruebas/calendario-pruebas.astro
import CalendarioBoho from "../../components/calendario/CalendarioBoho.astro";
import CalendarioMinimalista from "../../components/calendario/CalendarioMinimalista.astro";
import CalendarioVIP from "../../components/calendario/CalendarioVIP.astro";
import CalendarioXV from "../../components/calendario/CalendarioXV.astro";
import CalendarioSTD from "../../components/calendario/CalendarioSTD.astro";
// Nuevos componentes
import CalendarioRosa from "../../components/calendario/CalendarioRosa.astro";
import CalendarioNeon from "../../components/calendario/CalendarioNeon.astro";
import CalendarioNatural from "../../components/calendario/CalendarioNatural.astro";
import CalendarioFiesta from "../../components/calendario/CalendarioFiesta.astro";
import CalendarioOscuro from "../../components/calendario/CalendarioOscuro.astro";
import CalendarioModerno from "../../components/calendario/CalendarioModerno.astro";
import CalendarioPastel from "../../components/calendario/CalendarioPastel.astro";
import CalendarioAzteca from "../../components/calendario/CalendarioAzteca.astro";
import CalendarioLujo from "../../components/calendario/CalendarioLujo.astro";
import CalendarioFloral from "../../components/calendario/CalendarioFloral.astro";
import CalendarioRetro from "../../components/calendario/CalendarioRetro.astro";
import CalendarioCyberpunk from "../../components/calendario/CalendarioCyberpunk.astro";
import CalendarioVintage from "../../components/calendario/CalendarioVintage.astro";
import CalendarioGlitch from "../../components/calendario/CalendarioGlitch.astro";

const mockCalendario = {
  google: "https://calendar.google.com/calendar/render?action=TEMPLATE&text=Evento+de+Prueba&dates=20260613T220000Z/20260614T070000Z",
  apple: "#",
  outlook: "https://outlook.live.com/calendar/0/deeplink/compose?path=/calendar/action/compose&rru=addevent&subject=Evento+de+Prueba"
};

const mockCalendarioSTD = {
  google: "https://calendar.google.com/calendar/render?action=TEMPLATE&text=Evento+de+Prueba&dates=20260613T220000Z/20260614T070000Z&details=¡No+te+lo+pierdas!",
  outlook: "https://outlook.live.com/calendar/0/deeplink/compose?path=/calendar/action/compose&rru=addevent&subject=Evento+de+Prueba",
  apple: "#"
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componentes de Calendario</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'grad-bg': '#0f0e0f',
              'grad-secondary': '#d4a373',
            },
            fontFamily: {
              sans: ['"Montserrat"', '"Plus Jakarta Sans"', "sans-serif"],
              serif: ['"Playfair Display"', '"Noto Serif"', "serif"],
            }
          }
        }
      };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
      .font-nombres {
        font-family: 'Great Vibes', cursive !important;
      }
      .section-divider {
        height: 1px;
        width: 120px;
        background: linear-gradient(90deg, transparent, #D4AF37, transparent);
        margin: 2rem auto;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Componentes de Calendario</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 19 diseños de calendario premium para invitaciones digitales.
        </p>
      </header>

      <!-- ── COMPONENTES EXISTENTES ── -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Boho Style</span>
        </div>
        <div class="relative w-full">
          <CalendarioBoho calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Minimalist Style</span>
        </div>
        <div class="relative w-full">
          <CalendarioMinimalista calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. VIP Style</span>
        </div>
        <div class="relative w-full">
          <CalendarioVIP calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. XV Style (Gold Button)</span>
        </div>
        <div class="relative w-full">
          <CalendarioXV calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. STD Style (Save the Date)</span>
        </div>
        <div class="relative w-full">
          <CalendarioSTD calendario={mockCalendarioSTD} />
        </div>
      </section>

      <!-- ── NUEVOS COMPONENTES ── -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. Rosa Style (Handwritten + Hearts)</span>
        </div>
        <div class="relative w-full">
          <CalendarioRosa calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. Neon Style (Dark + Glow Effects)</span>
        </div>
        <div class="relative w-full">
          <CalendarioNeon calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>8. Natural Style (Verde Oliva + Hojas)</span>
        </div>
        <div class="relative w-full">
          <CalendarioNatural calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. Fiesta Style (Gradiente Festivo)</span>
        </div>
        <div class="relative w-full">
          <CalendarioFiesta calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>10. Oscuro Style (Dark Elegante + Dorado)</span>
        </div>
        <div class="relative w-full">
          <CalendarioOscuro calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. Moderno Style (Tech / Startup)</span>
        </div>
        <div class="relative w-full">
          <CalendarioModerno calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>12. Pastel Style (Colores Suaves + Pills)</span>
        </div>
        <div class="relative w-full">
          <CalendarioPastel calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>13. Azteca Style (Tierra Mexicana + Geométrico)</span>
        </div>
        <div class="relative w-full">
          <CalendarioAzteca calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>14. Lujo Style (Crema / Champagne + Serif)</span>
        </div>
        <div class="relative w-full">
          <CalendarioLujo calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>15. Floral Style (Blanco + Flores SVG + Script)</span>
        </div>
        <div class="relative w-full">
          <CalendarioFloral calendario={mockCalendario} />
        </div>
      </section>

      <!-- ── 10 NEWEST COMPONENTS ── -->

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>16. Retro Style (Yellow + Bold)</span>
        </div>
        <div class="relative w-full">
          <CalendarioRetro calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>17. Cyberpunk Style (Neon + Dark)</span>
        </div>
        <div class="relative w-full">
          <CalendarioCyberpunk calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>18. Vintage Style (Classic)</span>
        </div>
        <div class="relative w-full">
          <CalendarioVintage calendario={mockCalendario} />
        </div>
      </section>

      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>19. Glitch Style</span>
        </div>
        <div class="relative w-full">
          <CalendarioGlitch calendario={mockCalendario} />
        </div>
      </section>

    </main>
  </body>
</html>
