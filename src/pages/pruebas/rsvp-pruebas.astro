---
// src/pages/pruebas/rsvp-pruebas.astro
import RSVPBoho from "../../components/rsvp/RSVPBoho.astro";
import RSVPMinimalista from "../../components/rsvp/RSVPMinimalista.astro";
import RSVPVIP from "../../components/rsvp/RSVPVIP.astro";
import RSVPXV from "../../components/rsvp/RSVPXV.astro";
import RSVPGlassmorphism from "../../components/rsvp/RSVPGlassmorphism.astro";
import RSVPElegantSerif from "../../components/rsvp/RSVPElegantSerif.astro";
import RSVPMonochrome from "../../components/rsvp/RSVPMonochrome.astro";
import RSVPPlayful from "../../components/rsvp/RSVPPlayful.astro";
import RSVPFuturistic from "../../components/rsvp/RSVPFuturistic.astro";
import RSVPNature from "../../components/rsvp/RSVPNature.astro";

// New advanced interactive ones:
import RSVPStepWizard from "../../components/rsvp/RSVPStepWizard.astro";
import RSVPDigitalEnvelope from "../../components/rsvp/RSVPDigitalEnvelope.astro";
import RSVPRoyalSplit from "../../components/rsvp/RSVPRoyalSplit.astro";
import RSVPChicPopup from "../../components/rsvp/RSVPChicPopup.astro";
import RSVPWatercolorInteractive from "../../components/rsvp/RSVPWatercolorInteractive.astro";
import RSVPGraduationInteractive from "../../components/rsvp/RSVPGraduationInteractive.astro";
import RSVPFestivalPass from "../../components/rsvp/RSVPFestivalPass.astro";
import RSVPMinimalistFloat from "../../components/rsvp/RSVPMinimalistFloat.astro";
import RSVPEcoFloral from "../../components/rsvp/RSVPEcoFloral.astro";

const mockBoho = {
  titulo: 'Confirmación de Asistencia',
  mensajeDespedida: '¡Tu confirmación alegra nuestro corazón!'
};

const mockMinimalista = {
  telefono: '521234567890',
  mensajeDefault: 'Confirmación para la Boda',
  fechaLimite: '1 de Septiembre de 2026',
  mostrarNinos: true,
  noNinos: false,
  pases: {
    mostrar: true,
    cantidad: 5
  }
};

const mockVIP = {
  titulo: 'Confirmar Asistencia',
  mensaje: 'Por favor, confírmanos tu asistencia para esperarte con mucha alegría.',
  numeroWhatsapp: '521234567890'
};

const mockXV = {
  telefono: '521234567890',
  mensajeDefault: 'Confirmación de Asistencia',
  fechaLimite: '24 de Octubre de 2026',
  urlCalendario: 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Mi+Fiesta+de+XV&dates=20261024T220000Z/20261025T080000Z',
  mostrarMensajeEspecial: true,
  pases: {
    mostrar: true,
    cantidad: 4
  },
  mostrarNinos: false
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catálogo: Componentes RSVP</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              boho: {
                terracota: '#b76e79',
                arena: '#f4e8d3',
                eucalipto: '#81B29A',
                rosa: '#E8C3B9',
                dorado: '#C5A059'
              },
              'boho-terracota': '#b76e79',
              'boho-arena': '#f4e8d3',
              'boho-eucalipto': '#81B29A',
              'boho-rosa': '#E8C3B9',
              'boho-dorado': '#C5A059',
              'grad-primary': '#1A202C',
              'grad-secondary': '#D4AF37',
              'grad-accent': '#2C3E50',
              'grad-text': '#E2E8F0',
              'grad-bg': '#0F172A'
            },
            fontFamily: {
              serif: ['"Playfair Display"', '"Noto Serif"', 'serif'],
              handwriting: ['"Dancing Script"', 'cursive']
            }
          }
        }
      }
    </script>
    <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --gold-rgb: 183, 110, 121;
        --bg-cream: #fdfbf7;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
      .gold-gradient-text {
        background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .gold-border {
        border-image: linear-gradient(to right, #BF953F, #FCF6BA, #AA771C) 1;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Componentes RSVP</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 24 diseños de RSVP premium para confirmaciones de asistencia interactivas y dinámicas.
        </p>
      </header>

      <!-- 1. RSVP Boho -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. RSVP Boho</span>
        </div>
        <div class="relative w-full">
          <RSVPBoho data={mockBoho} />
        </div>
      </section>

      <!-- 2. RSVP Minimalista -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. RSVP Minimalista</span>
        </div>
        <div class="relative w-full">
          <RSVPMinimalista data={mockMinimalista} />
        </div>
      </section>

      <!-- 3. RSVP VIP -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. RSVP VIP</span>
        </div>
        <div class="relative w-full">
          <RSVPVIP data={mockVIP} params={{ nombre: 'Prueba' }} />
        </div>
      </section>

      <!-- 4. RSVP XV -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. RSVP XV</span>
        </div>
        <div class="relative w-full">
          <RSVPXV data={mockXV} />
        </div>
      </section>



      <!-- 6. RSVP Glassmorphism -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>6. RSVP Glassmorphism</span>
        </div>
        <div class="relative w-full">
          <RSVPGlassmorphism data={mockBoho} />
        </div>
      </section>

      <!-- 7. RSVP Elegant Serif -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>7. RSVP Elegant Serif</span>
        </div>
        <div class="relative w-full" style="--color-texto: #1a1a1a;">
          <RSVPElegantSerif data={mockBoho} bgColor="#ffffff" />
        </div>
      </section>



      <!-- 9. RSVP Monochrome -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>9. RSVP Monochrome</span>
        </div>
        <div class="relative w-full">
          <RSVPMonochrome data={mockBoho} />
        </div>
      </section>



      <!-- 11. RSVP Playful -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>11. RSVP Playful</span>
        </div>
        <div class="relative w-full">
          <RSVPPlayful data={mockBoho} />
        </div>
      </section>



      <!-- 13. RSVP Futuristic -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>13. RSVP Futuristic</span>
        </div>
        <div class="relative w-full">
          <RSVPFuturistic data={mockBoho} />
        </div>
      </section>

      <!-- 14. RSVP Nature -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>14. RSVP Nature</span>
        </div>
        <div class="relative w-full">
          <RSVPNature data={mockBoho} />
        </div>
      </section>

      <!-- 15. RSVP Step Wizard -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>15. RSVP Step Wizard</span>
        </div>
        <div class="relative w-full">
          <RSVPStepWizard data={mockBoho} />
        </div>
      </section>

      <!-- 16. RSVP Digital Envelope -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>16. RSVP Digital Envelope</span>
        </div>
        <div class="relative w-full">
          <RSVPDigitalEnvelope data={mockBoho} />
        </div>
      </section>

      <!-- 17. RSVP Royal Split -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>17. RSVP Royal Split</span>
        </div>
        <div class="relative w-full">
          <RSVPRoyalSplit data={mockBoho} />
        </div>
      </section>

      <!-- 18. RSVP Chic Popup -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>18. RSVP Chic Popup</span>
        </div>
        <div class="relative w-full">
          <RSVPChicPopup data={mockBoho} />
        </div>
      </section>



      <!-- 20. RSVP Watercolor Interactive -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>20. RSVP Watercolor Interactive</span>
        </div>
        <div class="relative w-full">
          <RSVPWatercolorInteractive data={mockBoho} />
        </div>
      </section>

      <!-- 21. RSVP Graduation Interactive -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>21. RSVP Graduation Interactive</span>
        </div>
        <div class="relative w-full">
          <RSVPGraduationInteractive data={mockBoho} />
        </div>
      </section>

      <!-- 22. RSVP Festival Pass -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>22. RSVP Festival Pass</span>
        </div>
        <div class="relative w-full">
          <RSVPFestivalPass data={mockBoho} />
        </div>
      </section>

      <!-- 23. RSVP Minimalist Float -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>23. RSVP Minimalist Float</span>
        </div>
        <div class="relative w-full">
          <RSVPMinimalistFloat data={mockBoho} />
        </div>
      </section>

      <!-- 24. RSVP Eco Floral -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>24. RSVP Eco Floral</span>
        </div>
        <div class="relative w-full">
          <RSVPEcoFloral data={mockBoho} />
        </div>
      </section>

    </main>
  </body>
</html>
