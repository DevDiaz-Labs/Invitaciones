---
// src/pages/pruebas/footer-pruebas.astro
import FooterBoho from "../../components/footer/FooterBoho.astro";
import FooterMinimalista from "../../components/footer/FooterMinimalista.astro";
import FooterXV from "../../components/footer/FooterXV.astro";

import FooterClassic from "../../components/footer/FooterClassic.astro";
import FooterModern from "../../components/footer/FooterModern.astro";
import FooterDark from "../../components/footer/FooterDark.astro";
import FooterElegant from "../../components/footer/FooterElegant.astro";
import FooterFloral from "../../components/footer/FooterFloral.astro";
import FooterVibrant from "../../components/footer/FooterVibrant.astro";
import FooterGlass from "../../components/footer/FooterGlass.astro";
import FooterVintage from "../../components/footer/FooterVintage.astro";
import FooterNeon from "../../components/footer/FooterNeon.astro";
import FooterLuxury from "../../components/footer/FooterLuxury.astro";

const mockData = {
  mostrar: true,
  nombres: 'Ana & Carlos',
  titulo: 'Mesa de Regalos / Lluvia de Sobres',
  fechaVista: '13 · Junio · 2026',
  fecha: '2026-06-13',
  frase: 'El mejor regalo es tu presencia',
  imagenFondo: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  imagen: 'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800&auto=format&fit=crop',
  hashtag: '#AnaYCarlos',
  mensaje: 'Esperamos contar con tu presencia',
  texto: 'Haremos de este día algo inolvidable',
  urlSpotify: 'https://open.spotify.com/playlist/37i9dQZF1DWV7EzJMK2FUI',
  banco: 'BBVA',
  cuenta: '0123456789',
  clabe: '012345678901234567',
  titular: 'Ana Sofia Valdes',
  amazon: '#',
  liverpool: '#',
  eventos: [
    { hora: '16:00', nombre: 'Ceremonia', lugar: 'Templo Expiatorio', icono: 'iglesia' },
    { hora: '18:00', nombre: 'Recepción', lugar: 'Salón de Eventos', icono: 'fiesta' }
  ],
  itinerario: [
    { time: '16:00', event: 'Ceremonia', desc: 'Templo Expiatorio' },
    { time: '18:00', event: 'Recepción', desc: 'Salón de Eventos' }
  ],
  dressCode: {
    titulo: 'Formal',
    subtitulo: 'Traje oscuro y vestido largo',
    nota: 'La recepción será en un jardín, sugerimos considerar el calzado para tu comodidad.'
  },
  galeria: [
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800',
    'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=800'
  ]
};
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componentes de FOOTER</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js" defer></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #f3f4f6;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-white min-h-screen pb-20">
      
      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERBOHO STYLE
      </div>
      <div class="relative w-full">
        <FooterBoho data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERMINIMALISTA STYLE
      </div>
      <div class="relative w-full">
        <FooterMinimalista data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERXV STYLE
      </div>
      <div class="relative w-full">
        <FooterXV data={{
          nombre: "Sofia Valeria",
          agradecimiento: "¡TE ESPERO PARA CELEBRAR JUNTOS!"
        }} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERCLASSIC STYLE
      </div>
      <div class="relative w-full">
        <FooterClassic data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERMODERN STYLE
      </div>
      <div class="relative w-full">
        <FooterModern data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERDARK STYLE
      </div>
      <div class="relative w-full">
        <FooterDark data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERELEGANT STYLE
      </div>
      <div class="relative w-full">
        <FooterElegant data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERFLORAL STYLE
      </div>
      <div class="relative w-full">
        <FooterFloral data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERVIBRANT STYLE
      </div>
      <div class="relative w-full">
        <FooterVibrant data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERGLASS STYLE
      </div>
      <div class="relative w-full">
        <FooterGlass data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERVINTAGE STYLE
      </div>
      <div class="relative w-full">
        <FooterVintage data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERNEON STYLE
      </div>
      <div class="relative w-full">
        <FooterNeon data={mockData} />
      </div>

      <div class="p-4 bg-gray-100 text-center font-bold text-gray-700 border-b border-gray-200 mt-8">
        FOOTERLUXURY STYLE
      </div>
      <div class="relative w-full">
        <FooterLuxury data={mockData} />
      </div>

    </main>
  </body>
</html>
