---
// src/pages/pruebas/noninos-pruebas.astro
import NoninosMinimalista from "../../components/noninos/NoninosMinimalista.astro";
import NoninosXV from "../../components/noninos/NoninosXV.astro";
import NoninosDivertido from "../../components/noninos/NoninosDivertido.astro";
import NoninosElegante from "../../components/noninos/NoninosElegante.astro";
import NoninosIcono from "../../components/noninos/NoninosIcono.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componentes de No Niños (Adults Only)</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #c5a059;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">No Niños</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 5 de los mejores avisos para eventos exclusivos para adultos.
        </p>
      </header>

      <!-- 1. Estilo Minimalista -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>1. Estilo Minimalista</span>
        </div>
        <div class="p-6 bg-white">
          <NoninosMinimalista />
        </div>
      </section>

      <!-- 2. Estilo Quinceañera / Clásico Gold -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Estilo Quinceañera / Clásico Gold</span>
        </div>
        <div class="p-6 bg-[#fffbf2]">
          <NoninosXV />
        </div>
      </section>

      <!-- 3. Estilo Divertido / Despreocupado -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>3. Estilo Divertido / Despreocupado</span>
        </div>
        <div class="p-6 bg-white">
          <NoninosDivertido />
        </div>
      </section>

      <!-- 4. Estilo Elegante Clásico -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>4. Estilo Elegante Clásico</span>
        </div>
        <div class="p-6 bg-white">
          <NoninosElegante />
        </div>
      </section>

      <!-- 5. Estilo Ilustrativo / Icono -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>5. Estilo Ilustrativo / Icono</span>
        </div>
        <div class="p-6 bg-[#fffbf2]">
          <NoninosIcono />
        </div>
      </section>

    </main>
  </body>
</html>
