---
// src/pages/pruebas/noninos-pruebas.astro
import NoninosBoho from "../../components/noninos/NoninosBoho.astro";
import NoninosMinimalista from "../../components/noninos/NoninosMinimalista.astro";
import NoninosXV from "../../components/noninos/NoninosXV.astro";
import NoninosDivertido from "../../components/noninos/NoninosDivertido.astro";

// Optional customized text examples
const customTitulo = "Paz y Tranquilidad";
const customMensaje = "Con el fin de permitir a todos los invitados, incluyendo a los padres, un día de descanso y relajación, nuestro día especial será solo para adultos.";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test: Componentes de No Niños (Adults Only)</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #c5a059;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #f9fafb;
      }
    </style>
  </head>
  <body class="py-12">
    <main class="w-full max-w-xl mx-auto space-y-12 px-4">
      
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-serif text-stone-850">Playground de Notas "No Niños"</h1>
        <p class="text-sm text-stone-500">Visualización de las diferentes variaciones del aviso de evento exclusivo para adultos.</p>
      </div>

      <!-- 1. Estilo Boho -->
      <div class="space-y-3">
        <div class="p-2 bg-stone-200/50 rounded-lg text-center font-mono text-xs font-bold text-stone-600 uppercase tracking-widest">
          Estilo Boho (NoninosBoho)
        </div>
        <div class="p-4 bg-white rounded-2xl border border-stone-200">
          <NoninosBoho />
        </div>
      </div>

      <!-- 2. Estilo Minimalista -->
      <div class="space-y-3">
        <div class="p-2 bg-stone-200/50 rounded-lg text-center font-mono text-xs font-bold text-stone-600 uppercase tracking-widest">
          Estilo Minimalista (NoninosMinimalista)
        </div>
        <div class="p-4 bg-white rounded-2xl border border-stone-200">
          <NoninosMinimalista />
        </div>
      </div>

      <!-- 3. Estilo XV / Elegante -->
      <div class="space-y-3">
        <div class="p-2 bg-stone-200/50 rounded-lg text-center font-mono text-xs font-bold text-stone-600 uppercase tracking-widest">
          Estilo Quinceañera / Clásico Gold (NoninosXV)
        </div>
        <div class="p-4 bg-white rounded-2xl border border-stone-200">
          <NoninosXV />
        </div>
      </div>

      <!-- 4. Estilo Divertido / Moderno -->
      <div class="space-y-3">
        <div class="p-2 bg-stone-200/50 rounded-lg text-center font-mono text-xs font-bold text-stone-600 uppercase tracking-widest">
          Estilo Divertido / Despreocupado (NoninosDivertido)
        </div>
        <div class="p-4 bg-white rounded-2xl border border-stone-200">
          <NoninosDivertido />
        </div>
      </div>

      <!-- 5. Ejemplo Personalizado (Uso de Props) -->
      <div class="space-y-3">
        <div class="p-2 bg-stone-200/50 rounded-lg text-center font-mono text-xs font-bold text-stone-600 uppercase tracking-widest">
          Ejemplo con Textos Personalizados (Props)
        </div>
        <div class="p-4 bg-white rounded-2xl border border-stone-200">
          <NoninosBoho titulo={customTitulo} mensaje={customMensaje} />
        </div>
      </div>

    </main>
  </body>
</html>
