---
// src/pages/pruebas/countdown-pruebas.astro
import CountdownMinimalista from "../../components/countdown/CountdownMinimalista.astro";
import CountdownBurbujas from "../../components/countdown/CountdownBurbujas.astro";
import CountdownAnillos from "../../components/countdown/CountdownAnillos.astro";
import CountdownSimple from "../../components/countdown/CountdownSimple.astro";
import CountdownXV from "../../components/countdown/CountdownXV.astro";

// Target date set to a future date in 2026
const mockData = {
  fechaObjetivo: "2026-10-24T17:00:00",
  urlCalendario: "https://calendar.google.com/calendar/render?action=TEMPLATE&text=Gran+Evento&dates=20261024T220000Z/20261025T070000Z"
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catálogo: Componentes Cuenta Regresiva</title>
    
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style is:global>
      :root {
        --gold: #b76e79;
        --dark-text: #2c2523;
        --boho-arena: #f4e8d3;
        --boho-terracota: #b76e79;
      }
      body, html {
        margin: 0;
        padding: 0;
        width: 100%;
        background-color: #0f1012;
        color: #f3f4f6;
      }
    </style>
  </head>
  <body>
    <main class="w-full max-w-md mx-auto shadow-2xl bg-neutral-900 min-h-screen pb-24">
      
      <!-- Header Panel -->
      <header class="p-8 md:p-12 text-center border-b border-white/10 bg-black/30">
        <span class="text-xs uppercase tracking-widest text-amber-500 font-semibold font-mono">Catálogo digital</span>
        <h1 class="text-3xl md:text-5xl font-serif italic text-white mt-3">Cuenta Regresiva</h1>
        <p class="text-gray-400 text-xs md:text-sm mt-3 max-w-xl mx-auto font-sans leading-relaxed">
          Una colección de 5 diseños de cuenta regresiva (countdown) interactivos para invitaciones digitales.
        </p>
      </header>

      <!-- 1. Minimalista Elegante -->
      <section class="border-b border-white/5 bg-white p-6">
        <div class="mb-4 text-xs tracking-wider text-amber-500 uppercase font-mono bg-neutral-900 p-2 rounded text-center">
          <span>1. Minimalista Elegante</span>
        </div>
        <div class="relative w-full">
          <CountdownMinimalista data={mockData} />
        </div>
      </section>

      <!-- 2. Burbujas Flotantes (Glassmorphism) -->
      <section class="border-b border-white/5">
        <div class="p-4 bg-black/20 flex justify-between items-center text-xs tracking-wider text-amber-500 uppercase font-mono">
          <span>2. Burbujas Flotantes (Glassmorphism)</span>
        </div>
        <div class="relative w-full">
          <CountdownBurbujas data={mockData} />
        </div>
      </section>

      <!-- 3. Reloj de Arena / Anillos SVG -->
      <section class="border-b border-white/5 bg-white p-6">
        <div class="mb-4 text-xs tracking-wider text-amber-500 uppercase font-mono bg-neutral-900 p-2 rounded text-center">
          <span>3. Reloj de Arena / Anillos SVG</span>
        </div>
        <div class="relative w-full">
          <CountdownAnillos data={mockData} />
        </div>
      </section>

      <!-- 4. Componente Simple -->
      <section class="border-b border-white/5 bg-slate-50 p-6">
        <div class="mb-4 text-xs tracking-wider text-amber-500 uppercase font-mono bg-neutral-900 p-2 rounded text-center">
          <span>4. Componente Simple</span>
        </div>
        <div class="relative w-full">
          <CountdownSimple data={mockData} />
        </div>
      </section>

      <!-- 5. Estilo XV Años -->
      <section class="border-b border-white/5 bg-[#ffecfb] p-6" style="--gold: #b30000; --dark-text: #6e201b;">
        <div class="mb-4 text-xs tracking-wider text-amber-500 uppercase font-mono bg-neutral-900 p-2 rounded text-center">
          <span>5. Estilo XV Años (Fondo Rosa y Letras Rojas)</span>
        </div>
        <div class="relative w-full">
          <CountdownXV data={mockData} />
        </div>
      </section>

    </main>
  </body>
</html>
