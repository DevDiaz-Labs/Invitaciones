// src/pages/preview/[categoria]/[id].astro
import { CATALOG } from '../../../data/estudio/catalog.js';

export function getStaticPaths() {
  const paths = [];
  for (const [catId, category] of Object.entries(CATALOG)) {
    for (const item of category.items) {
      paths.push({ params: { categoria: catId, id: item.id } });
    }
  }
  return paths;
}

const { categoria, id } = Astro.params;

// Find all components dynamically
const allComponents = import.meta.glob('/src/components/**/*.astro');

let Component;
for (const path in allComponents) {
  if (path.endsWith(`/${id}.astro`)) {
    Component = (await allComponents[path]()).default;
    break;
  }
}

// Genérico Mock Data aplicable a cualquier componente
