---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Preview: {id}</title>
  
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script defer src="https://unpkg.com/alpinejs@3.13.3/dist/cdn.min.js"></script>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Great+Vibes&display=swap" rel="stylesheet" />

  <script is:inline id="tw-config">
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            accent: '#B76E79',
            surface: '#161516',
            bg: '#0F0E0F',
          },
          fontFamily: {
            serif: ['Cormorant Garamond', 'serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            script: ['Great Vibes', 'cursive'],
          },
        },
      },
    };
  </script>

  <style is:global define:vars={{ bodyBg: bodyBgColor }}>
    :root {
      --gold: #b76e79;
      --dark-text: #2c2523;
    }
    body, html {
      margin: 0;
      padding: 0;
      background-color: var(--bodyBg) !important;
      background-image: none !important;
      overflow-x: hidden;
      /* Remove scrollbar */
      scrollbar-width: none; 
      -ms-overflow-style: none;
    }
    body::-webkit-scrollbar { 
      display: none; 
    }
    .font-nombres { font-family: 'Great Vibes', cursive !important; }
    
    /* Disable all pointer events to prevent clicking links inside the preview */
    .preview-wrapper {
      pointer-events: none !important;
      user-select: none;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Force the component's root section or div to fill the card height and center its contents */
    .preview-wrapper > section,
    .preview-wrapper > div,
    .preview-wrapper > main {
      flex-grow: 1;
      min-height: 100vh !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
    }

    iframe {
      border: none;
    }
  </style>
</head>
<body class="bg-bg text-white font-sans antialiased">
  <div class="preview-wrapper w-full relative">
    {Component ? <Component data={categoria.includes('galeria') ? componentData.galeria : componentData} params={{ nombre: 'Prueba' }} /> : (
      <div class="flex items-center justify-center h-screen">
        <p class="text-white/50 text-sm">Preview no disponible</p>
      </div>
    )}
  </div>
  <script>
    if (window.location.search.includes('interactive=true')) {
      document.querySelector('.preview-wrapper').classList.remove('preview-wrapper');
    }
  </script>
</body>
</html>
