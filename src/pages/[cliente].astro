---
import XVDulceLayout from "../layouts/XV.astro";
import Hero from "../components/xv-plantilla/Hero.astro";
import Dedicatoria from "../components/xv-plantilla/Dedicatoria.astro";
import Countdown from "../components/xv-plantilla/Countdown.astro";
import Ceremonia from "../components/xv-plantilla/Ceremonia.astro";
import Recepcion from "../components/xv-plantilla/Recepcion.astro";
import DressCode from "../components/xv-plantilla/DressCode.astro";
import Galeria from "../components/xv-plantilla/Galeria.astro";
import Regalos from "../components/xv-plantilla/Regalos.astro";
import RSVP from "../components/xv-plantilla/RSVP.astro";
import Footer from "../components/xv-plantilla/Footer.astro";
import MusicPlayer from "../components/xv-plantilla/MusicPlayer.astro";
import * as fs from 'fs';
import * as path from 'path';

// Generar rutas estáticas en build time
export async function getStaticPaths() {
	const clientesDir = path.resolve('./src/data/clientes');
	let clientesFiles: string[] = [];
	
	try {
		clientesFiles = fs.readdirSync(clientesDir).filter(f => f.endsWith('.json'));
	} catch(e) {
		console.log("Directorio de clientes no encontrado, retornando paths vacios.");
	}

	return clientesFiles.map(file => {
		const clienteId = file.replace('.json', '');
		const data = JSON.parse(fs.readFileSync(path.join(clientesDir, file), 'utf-8'));
		return {
			params: { cliente: clienteId },
			props: { data },
		};
	});
}

const { data } = Astro.props;
---

<XVDulceLayout title={data.hero.etiqueta} tema={data.tema}>
	<!-- Usamos el script de Tailwind por CDN -->
	<script slot="head" src="https://cdn.tailwindcss.com"></script>

	<main>
		<Hero data={data.hero} />
		<Dedicatoria data={data.dedicatoria} />
		<Countdown data={data.countdown} />
		<Ceremonia data={data.eventos.ceremonia} />
		<Recepcion data={data.eventos.recepcion} />
		<DressCode data={data.dressCode} />
		<Regalos data={data.regalos} />
		<Galeria data={data.galeria} />
		<RSVP data={{ ...data.rsvp, urlCalendario: data.countdown.urlCalendario }} />
	</main>
	<Footer data={{ ...data.footer, nombre: data.hero.nombre }} />
	{data.musica?.url && <MusicPlayer url={data.musica.url} />}
</XVDulceLayout>
