---
interface Props {
	title: string;
	tema?: {
		colorPrincipal?: string;
		colorFondo?: string;
		colorTexto?: string;
		fuentePrincipal?: string;
		fuenteTitulos?: string;
        fuenteNombres?: string;
	};
}

const { title, tema } = Astro.props;

// Valores por defecto
const fuentePrincipal = tema?.fuentePrincipal || "Montserrat";
const fuenteTitulos = tema?.fuenteTitulos || "Playfair Display";
const fuenteNombres = tema?.fuenteNombres || "Great Vibes";

const colorP = tema?.colorPrincipal || "#c5a059";
const colorF = tema?.colorFondo || "#fdfbf7";
const colorT = tema?.colorTexto || "#333333";

function hexToRgb(hex: string) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}` : "197, 160, 89";
}
const colorPRgb = hexToRgb(colorP);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>

        <!-- Open Graph / Facebook / WhatsApp -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={`Te invito a celebrar mis XV Años`} />
        <meta property="og:image" content={new URL('/imagenes/preview.png', Astro.site ?? Astro.url)} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={Astro.url} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={`Te invito a celebrar mis XV Años`} />
        <meta name="twitter:image" content={new URL('/imagenes/preview.png', Astro.site ?? Astro.url)} />
		
        		<!-- Fuentes Base Pre-cargadas -->
		<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Sacramento&family=Dancing+Script&display=swap" rel="stylesheet" />
        
        <!-- Fuentes Dinámicas Adicionales -->
        {fuentePrincipal !== "Montserrat" && (
            <link href={`https://fonts.googleapis.com/css2?family=${fuentePrincipal.replace(' ', '+')}:wght@300;400;600&display=swap`} rel="stylesheet" />
        )}
        {fuenteNombres !== "Great Vibes" && fuenteNombres !== "Sacramento" && (
            <link href={`https://fonts.googleapis.com/css2?family=${fuenteNombres.replace(' ', '+')}&display=swap`} rel="stylesheet" />
        )}
        {fuenteTitulos !== "Playfair Display" && fuenteTitulos !== "Great Vibes" && (
            <link href={`https://fonts.googleapis.com/css2?family=${fuenteTitulos.replace(' ', '+')}&display=swap`} rel="stylesheet" />
        )}

        <slot name="head" />
        <!-- Alpine.js -->
        <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" is:inline></script>
	</head>
	<body>
		<slot />
        
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const observerOptions = {
                    root: null,
                    rootMargin: '0px',
                    threshold: 0.15
                };

                const observer = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, observerOptions);

                const elementsToAnimate = document.querySelectorAll('.observe-me');
                elementsToAnimate.forEach(el => observer.observe(el));
            });
        </script>
	</body>
</html>

<style is:global define:vars={{ 
    mainFont: `'${fuentePrincipal}', sans-serif`, 
    titleFont: `'${fuenteTitulos}', serif`,
    nameFont: `'${fuenteNombres}', cursive`,
    primaryColor: colorP,
    primaryColorRgb: colorPRgb,
    bgColor: colorF,
    textColor: colorT
}}>
    :root {
        --gold: var(--primaryColor);
        --gold-rgb: var(--primaryColorRgb);
        --dark-text: var(--textColor);
        --bg-cream: var(--bgColor);
    }

    body {
        font-family: var(--mainFont);
        background-color: var(--bg-cream);
        color: var(--dark-text);
        scroll-behavior: smooth;
        overflow-x: hidden;
    }
    
    .font-titulo { 
        font-family: var(--titleFont) !important; 
    }
    .font-nombres { 
        font-family: var(--nameFont) !important; 
    }
    
    /* Global Animations */
    @keyframes float {
        0% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
        100% { transform: translateY(0px) rotate(0deg); }
    }
    .animate-float { animation: float 6s ease-in-out infinite; }

    .observe-me {
        opacity: 0;
        transition: opacity 1s cubic-bezier(0.5, 0, 0, 1), transform 1s cubic-bezier(0.5, 0, 0, 1);
    }

    .fade-up {
        transform: translateY(40px);
    }
    .fade-up.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .scale-in {
        transform: scale(0.9);
    }
    .scale-in.is-visible {
        opacity: 1;
        transform: scale(1);
    }

    .fade-in-slow {
        transition-duration: 2s;
    }
    .fade-in-slow.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-divider {
        height: 1px;
        width: 120px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        margin: 2rem auto;
    }

    .btn-gold {
        border: 1px solid var(--gold);
        color: var(--gold);
        transition: all 0.4s ease;
        background-color: transparent;
    }
    .btn-gold:hover {
        background-color: var(--gold);
        color: white;
        box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
    }
</style>


