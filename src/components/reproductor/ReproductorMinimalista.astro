---
export interface Props {
  audioSrc?: string;
  autoplay?: boolean;
}

const { 
  audioSrc = "https://upload.wikimedia.org/wikipedia/commons/b/b4/Pachelbel_-_Canon_in_D_Major.ogg",
  autoplay = false
} = Astro.props;
---

<!-- Reproductor de Música Oculto e Icono Flotante -->
<audio 
  id="audioPlayer" 
  loop 
  src={audioSrc}
></audio>

<button 
  id="toggleMusicBtn"
  class="fixed bottom-6 right-6 z-50 p-4 bg-white/90 backdrop-blur-sm rounded-full shadow-lg border border-stone-100 text-stone-600 hover:text-stone-900 transition-all hover:scale-105"
  aria-label="Reproducir música"
>
  <!-- Icono de Música (Play por defecto) -->
  <svg id="iconMusic" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block">
    <path d="M9 18V5l12-2v13"></path>
    <circle cx="6" cy="18" r="3"></circle>
    <circle cx="18" cy="16" r="3"></circle>
  </svg>
  
  <!-- Icono de Pausa (Oculto por defecto) -->
  <svg id="iconPause" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
    <rect x="6" y="4" width="4" height="16"></rect>
    <rect x="14" y="4" width="4" height="16"></rect>
  </svg>
</button>

<script define:vars={{ autoplay }}>
  (function() {
    function initMusicPlayer() {
      const audio = document.getElementById('audioPlayer');
      const btn = document.getElementById('toggleMusicBtn');
      const iconMusic = document.getElementById('iconMusic');
      const iconPause = document.getElementById('iconPause');
      
      if (!btn || !audio || !iconMusic || !iconPause) return;
      if (btn.dataset.musicInitialized) return;
      btn.dataset.musicInitialized = "true";

      let isPlaying = false;

      function startPlaying() {
        if (isPlaying || !audio) return;
        audio.play().catch(e => console.log('Autoplay prevent:', e));
        isPlaying = true;
        if (iconMusic && iconPause) {
          iconMusic.classList.add('hidden');
          iconMusic.classList.remove('block');
          iconPause.classList.add('block');
          iconPause.classList.remove('hidden');
        }
      }

      function stopPlaying() {
        if (!isPlaying || !audio) return;
        audio.pause();
        isPlaying = false;
        if (iconMusic && iconPause) {
          iconPause.classList.add('hidden');
          iconPause.classList.remove('block');
          iconMusic.classList.add('block');
          iconMusic.classList.remove('hidden');
        }
      }

      // Toggle manual con el botón
      btn.addEventListener('click', () => {
        if (isPlaying) {
          stopPlaying();
        } else {
          startPlaying();
        }
      });

      // Autoplay al abrir el sobre (solo si autoplay=true en el JSON)
      if (autoplay) {
        const envelopeClasico = document.getElementById('envelope-clasico');
        if (envelopeClasico) {
          envelopeClasico.addEventListener('click', () => {
            // Esperamos a que termine la animación del sobre (~1800ms) para empezar
            setTimeout(() => {
              startPlaying();
            }, 1800);
          }, { once: true }); // once: true para que solo dispare en el primer clic
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener('DOMContentLoaded', initMusicPlayer);
    } else {
      initMusicPlayer();
    }
    document.addEventListener('astro:page-load', initMusicPlayer);
  })();
</script>
