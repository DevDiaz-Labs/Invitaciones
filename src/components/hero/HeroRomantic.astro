---
interface Props {
  data: {
    imagenFondo: string;
    fechaVista: string;
    fecha: string;
    nombres: string;
    frase: string;
  };
}
const { data } = Astro.props;
---
<section class="relative w-full h-screen flex flex-col items-center justify-center text-center overflow-hidden bg-pink-50">
  <div class="absolute inset-0 z-0">
    <img src={data.imagenFondo} alt="Fondo" class="w-full h-full object-cover object-center opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-tr from-pink-300/40 to-white/20 backdrop-blur-[1px]"></div>
  </div>
  <div class="relative z-10 flex flex-col items-center px-8 py-16 max-w-2xl bg-white/60 backdrop-blur-sm rounded-3xl border border-white/50 shadow-[0_8px_32px_rgba(255,192,203,0.3)]">
    <div class="text-pink-400 mb-4">
      <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
    </div>
    <h1 class="font-['Great_Vibes'] text-6xl md:text-8xl text-pink-600 mb-6 drop-shadow-sm">{data.nombres}</h1>
    <h2 class="text-sm md:text-md tracking-[0.2em] uppercase text-gray-600 mb-6 font-medium">{data.fechaVista}</h2>
    <p class="text-lg md:text-xl font-serif text-gray-500 italic">"{data.frase}"</p>
  </div>
</section>
