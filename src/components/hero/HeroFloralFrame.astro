---
interface Props {
  data: {
    imagenFondo: string;
    fechaVista: string;
    fecha: string;
    nombres: string;
    frase: string;
  };
}
const { data } = Astro.props;
---
<section class="relative w-full h-[100dvh] flex flex-col items-center justify-center overflow-hidden bg-[#fbfaf5]">
  <div class="absolute inset-0 z-0 w-full h-full max-w-lg mx-auto shadow-2xl">
    <!-- El marco floral de fondo -->
    <img src={data.imagenFondo} alt="Marco Floral" class="w-full h-full object-fill object-center" />
  </div>

  <!-- Contenedor del texto, ajustado para encajar exactamente en el rectángulo blanco del diseño proporcionado -->
  <div class="relative z-10 flex flex-col items-center justify-center text-center w-full max-w-lg mx-auto h-full"
       style="padding-top: 12%; padding-bottom: 22%; padding-left: 41%; padding-right: 11%;">
    
    <div class="flex flex-col items-center justify-center w-full h-full border-0 border-dashed border-gray-400 p-2 gap-4 sm:gap-6">
      
      <!-- Frase -->
      <p class="text-xs sm:text-sm md:text-md font-serif text-[#4a5d23] italic leading-relaxed">
        "{data.frase}"
      </p>

      <!-- Nombres -->
      <h1 class="font-['Cormorant_Garamond'] text-4xl sm:text-5xl text-[#3b4c1a] font-bold leading-none">
        {data.nombres}
      </h1>

      <!-- Fecha -->
      <div class="flex flex-col items-center gap-1 border-t border-b border-[#7b904b] py-2 mt-2 w-3/4">
        <h2 class="text-[0.65rem] sm:text-xs tracking-[0.2em] uppercase text-[#5a6b33] font-semibold">
          {data.fechaVista}
        </h2>
      </div>

    </div>
  </div>
</section>
