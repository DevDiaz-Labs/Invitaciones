---
// src/components/hero/HeroXVStarlight.astro
interface Props {
  data?: {
    etiqueta?: string;
    nombres?: string;
    nombre?: string;
    fechaVista?: string;
    fechaTexto?: string;
    frase?: string;
    imagenFondo?: string;
    imagen?: string;
  };
}

const { data = {} } = Astro.props;

const etiqueta = data.etiqueta || "Mis Quince Años";
const nombre = data.nombres || data.nombre || "Sofía Valeria";
const fecha = data.fechaVista || data.fechaTexto || "24 de Octubre de 2026";
const frase = data.frase || "Brillando con luz propia en la noche más especial.";
const imagenFondo = data.imagenFondo || data.imagen || "https://images.unsplash.com/photo-1566737236500-c8ac43014a67?q=80&w=1200&auto=format&fit=crop";
---

<header class="relative w-full h-screen flex flex-col justify-center items-center text-center p-4 overflow-hidden bg-[#090b16] text-[#e2e8f0]">
  <div class="absolute inset-0 z-0">
    <img src={imagenFondo} alt="Fondo Estrellado" class="w-full h-full object-cover object-center opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#090b16] via-transparent to-[#090b16]"></div>
  </div>

  <!-- Decorative Stars SVG -->
  <div class="absolute inset-0 z-1 pointer-events-none opacity-80">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10%" cy="10%" r="1" fill="#fff" class="animate-ping" style="animation-duration: 4s;" />
      <circle cx="90%" cy="20%" r="2" fill="#fff" class="animate-pulse" style="animation-duration: 3s;" />
      <circle cx="50%" cy="90%" r="1.5" fill="#fff" class="animate-ping" style="animation-duration: 5s;" />
      <circle cx="20%" cy="80%" r="1" fill="#fff" class="animate-pulse" style="animation-duration: 2s;" />
    </svg>
  </div>

  <div class="relative z-10 w-full max-w-lg">
    <!-- Star icon -->
    <div class="flex justify-center mb-4 text-[#fbbf24] animate-pulse">
      <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    </div>

    <span class="text-[11px] uppercase tracking-[0.4em] text-[#cbd5e1] mb-2 block">{etiqueta}</span>
    
    <h1 class="font-serif text-6xl md:text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-[#fbbf24] via-[#fef08a] to-[#fbbf24] uppercase tracking-wide my-4">
      {nombre}
    </h1>
    
    <div class="flex items-center justify-center gap-4 my-6">
      <div class="w-12 h-[1px] bg-[#fbbf24]/50"></div>
      <p class="font-sans text-sm uppercase tracking-[0.25em] text-[#fbbf24]">
        {fecha}
      </p>
      <div class="w-12 h-[1px] bg-[#fbbf24]/50"></div>
    </div>
    
    <p class="font-serif italic text-[#94a3b8] text-sm max-w-xs mx-auto">
      "{frase}"
    </p>
  </div>
</header>
