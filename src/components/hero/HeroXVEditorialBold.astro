---
// src/components/hero/HeroXVEditorialBold.astro
interface Props {
  data?: {
    etiqueta?: string;
    nombres?: string;
    nombre?: string;
    fechaVista?: string;
    fechaTexto?: string;
    frase?: string;
    imagenFondo?: string;
    imagen?: string;
  };
}

const { data = {} } = Astro.props;

const etiqueta = data.etiqueta || "Mis Quince Años";
const nombre = data.nombres || data.nombre || "Sofía Valeria";
const fecha = data.fechaVista || data.fechaTexto || "24 de Octubre de 2026";
const frase = data.frase || "Escribiendo mi propio destino con la elegancia de mis sueños.";
const imagenFondo = data.imagenFondo || data.imagen || "https://images.unsplash.com/photo-1549417229-aa67d3263c09?q=80&w=1200&auto=format&fit=crop";
---

<header class="relative w-full h-screen flex flex-col justify-between p-8 overflow-hidden bg-white text-black font-sans">
  <!-- Background Image - Fashion Portrait Style -->
  <div class="absolute inset-0 z-0">
    <img src={imagenFondo} alt="Editorial Portrait" class="w-full h-full object-cover object-center scale-100" />
    <!-- Gradient overlay for legibility (Editorial dark vignette/fade) -->
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-black/75"></div>
  </div>

  <!-- Editorial Top Watermark / Banner -->
  <div class="relative z-10 w-full flex justify-between items-center border-b border-white/20 pb-4">
    <span class="text-[9px] uppercase tracking-[0.5em] text-white/70 font-semibold">{etiqueta}</span>
    <span class="text-[9px] uppercase tracking-[0.2em] text-white/50">Edición Especial</span>
  </div>

  <!-- Giant Magazine Title Watermark (Behind names but on top of image) -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-1 overflow-hidden">
    <span class="text-[12rem] md:text-[18rem] font-serif font-bold text-white/[0.05] tracking-tighter uppercase leading-none select-none">
      XV
    </span>
  </div>

  <!-- Main Editorial Content Area (Aligned to the bottom or bottom-left) -->
  <div class="relative z-10 w-full max-w-lg mt-auto mb-12 text-left flex flex-col items-start gap-4">
    <!-- Fine luxury gold badge line -->
    <div class="w-16 h-[2px] bg-[#d4af37]"></div>

    <!-- Huge bold editorial serif title -->
    <h1 class="font-serif text-5xl md:text-7xl font-bold tracking-tight text-white uppercase leading-[0.95] drop-shadow-sm select-all">
      {nombre}
    </h1>

    <!-- Date block with magazine layout -->
    <div class="flex items-center gap-4 mt-2">
      <span class="text-xs uppercase tracking-[0.3em] font-semibold text-[#d4af37]">{fecha}</span>
      <span class="w-1.5 h-1.5 rounded-full bg-white/40"></span>
      <span class="text-xs uppercase tracking-[0.15em] text-white/70">Valeria's Ball</span>
    </div>

    <!-- Subtitle or Phrase aligned as a sidebar review/quote -->
    <p class="font-serif text-sm font-light text-white/80 leading-relaxed italic border-l-2 border-[#d4af37]/60 pl-4 mt-4 max-w-sm">
      "{frase}"
    </p>
  </div>

  <!-- Footer style scroll indicator -->
  <div class="relative z-10 w-full flex justify-between items-center border-t border-white/10 pt-4 text-white/40 text-[9px] tracking-widest uppercase">
    <span>Desliza para ver más</span>
    <div class="animate-bounce">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</header>
