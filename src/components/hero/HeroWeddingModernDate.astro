---
// src/components/hero/HeroWeddingModernDate.astro
interface Props {
  data: {
    nombres?: string;
    nombre?: string;
    fecha?: string;
    fechaTexto?: string;
    fechaVista?: string;
    imagenFondo?: string;
    imagen?: string;
  };
}

const { data } = Astro.props;

// Safe defaults
const displayNombres = data.nombres || data.nombre || "Daniel & Nohemí";
const displayImagen = data.imagen || data.imagenFondo || "/imagenes/imagenes/hero-wedding-modern-date.avif";

// Parse date into digits (e.g., "29 | 12 | 26")
let dateParts = ["29", "12", "26"];
if (data.fecha) {
  const parts = data.fecha.split(/[-/]/);
  if (parts.length === 3) {
    // Expect YYYY-MM-DD
    const fullYear = parts[0];
    const month = parts[1];
    const day = parts[2];
    dateParts = [day, month, fullYear.slice(-2)];
  }
} else if (data.fechaTexto) {
  // Try to parse text or fallback
}

// Split names by "&" or "y" to display them on separate lines
const namesList = displayNombres.split(/\s+&\s+|\s+y\s+/i);
const firstName = namesList[0] || "Daniel";
const secondName = namesList[1] || "Nohemí";
---

<header class="relative h-screen flex flex-col justify-between items-center text-center overflow-hidden bg-zinc-900 select-none">
  <!-- Full Screen Background Image -->
  <div class="absolute inset-0">
    <img 
      src={displayImagen} 
      alt={displayNombres} 
      class="w-full h-full object-cover object-[35%_center] scale-[1.02] transition-transform duration-1000 hover:scale-105"
    />
    <!-- Dark overlay for readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/75 z-10"></div>
  </div>

  <!-- Top Section: Big Bold Date (Styled to be massive and pushed to the top) -->
  <div class="w-full pt-8 md:pt-10 z-20 px-6">
    <div class="flex justify-center items-center gap-2 md:gap-4 text-white text-6xl md:text-8xl font-bold font-serif leading-none tracking-tight drop-shadow-md">
      <span>{dateParts[0]}</span>
      <span class="text-white/20 font-extralight text-5xl md:text-7xl select-none">|</span>
      <span>{dateParts[1]}</span>
      <span class="text-white/20 font-extralight text-5xl md:text-7xl select-none">|</span>
      <span>{dateParts[2]}</span>
    </div>
  </div>

  <!-- Center Section: Elegant Serif Names Overlay -->
  <div class="relative w-full px-6 py-10 z-20 flex flex-col justify-center items-center flex-grow">
    <div class="relative max-w-lg mx-auto flex flex-col items-center">
      <h1 class="text-white text-5xl md:text-6xl font-extrabold tracking-[0.15em] font-serif uppercase leading-none drop-shadow-lg">
        {firstName}
      </h1>
      
      <!-- Overlapping Cursive & -->
      <span class="text-6xl md:text-7xl font-handwriting text-[#d2ab67] my-1 select-none filter drop-shadow-md transform translate-y-1">
        &
      </span>

      <h1 class="text-white text-5xl md:text-6xl font-extrabold tracking-[0.15em] font-serif uppercase leading-none drop-shadow-lg">
        {secondName}
      </h1>
    </div>
  </div>

  <!-- Bottom Section: Textured White Block with Play Button -->
  <div class="relative w-full z-20 bg-[#faf6f0] pt-12 pb-14 px-6 border-t border-white/10 flex flex-col items-center shadow-[0_-10px_25px_rgba(0,0,0,0.15)] bg-paper-grain">
    <!-- Overlay Music Button -->
    <button 
      id="music-toggle-btn"
      class="absolute -top-7 w-14 h-14 bg-[#a1895a] hover:bg-[#8e764a] text-white rounded-full flex items-center justify-center shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 focus:outline-none group border-4 border-[#faf6f0]"
      aria-label="Reproducir música"
    >
      <!-- Play Icon (Centered with slight translation for optical alignment) -->
      <svg 
        id="play-icon"
        class="w-5 h-5 fill-current translate-x-[2px] transition-transform duration-300 group-hover:scale-110" 
        viewBox="0 0 24 24"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
      <!-- Pause Icon (Centered) -->
      <svg 
        id="pause-icon"
        class="w-5 h-5 fill-current hidden transition-transform duration-300 group-hover:scale-110" 
        viewBox="0 0 24 24"
      >
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
      </svg>
    </button>

    <!-- Scroll down indicator -->
    <div class="flex flex-col items-center text-[#8a7248] animate-bounce">
      <span class="text-[10px] tracking-[0.3em] uppercase mb-1 font-semibold">Desliza para continuar</span>
      <svg 
        class="w-4 h-4" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</header>

<style>
  .bg-paper-grain {
    background-color: #faf6f0;
    background-image: radial-gradient(rgba(161, 137, 90, 0.05) 0.5px, transparent 0.5px);
    background-size: 8px 8px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('music-toggle-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    let isPlaying = false;

    if (btn) {
      btn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        if (isPlaying) {
          playIcon.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
          window.dispatchEvent(new CustomEvent('play-global-music'));
        } else {
          playIcon.classList.remove('hidden');
          pauseIcon.classList.add('hidden');
          window.dispatchEvent(new CustomEvent('pause-global-music'));
        }
      });
    }
  });
</script>

