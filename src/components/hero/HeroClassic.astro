---
interface Props {
  data: {
    imagenFondo: string;
    fechaVista: string;
    fecha: string;
    nombres: string;
    frase: string;
  };
}
const { data } = Astro.props;
---
<section class="relative w-full h-screen flex flex-col items-center justify-center text-center overflow-hidden bg-white text-gray-800">
  <div class="absolute inset-0 z-0">
    <img src={data.imagenFondo} alt="Fondo" class="w-full h-full object-cover object-center opacity-30" />
    <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px]"></div>
  </div>
  <div class="relative z-10 flex flex-col items-center px-6 border-4 border-double border-gray-300 p-10 bg-white/70 backdrop-blur-md rounded-lg max-w-2xl shadow-xl">
    <h2 class="text-sm md:text-base tracking-[0.3em] uppercase font-serif mb-4 text-gray-500">{data.fechaVista}</h2>
    <h1 class="font-['Playfair_Display'] text-5xl md:text-7xl italic text-gray-800 mb-6">{data.nombres}</h1>
    <div class="w-24 h-[1px] bg-gray-400 mb-6"></div>
    <p class="text-lg md:text-xl font-light font-serif text-gray-600 mb-8 italic">"{data.frase}"</p>
  </div>
</section>
