---
// src/components/hero/HeroWeddingElegantPortal.astro
interface Props {
  data: {
    nombre?: string;
    nombres?: string;
    fecha?: string;
    fechaTexto?: string;
    fechaVista?: string;
    imagenFondo?: string;
    imagen?: string;
    etiqueta?: string;
    invitado?: string; // Optional guest name
  };
}

const { data } = Astro.props;

// Safe defaults
const displayNombres = data.nombres || data.nombre || "Janette & Arturo";
const displayImagen = data.imagen || data.imagenFondo || "https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200&auto=format&fit=crop";
const displayInvitado = data.invitado || "Familia Medina";

// Parse name components
const namesList = displayNombres.split(/\s+&\s+|\s+y\s+/i);
const name1 = namesList[0] || "Janette";
const name2 = namesList[1] || "Arturo";

// Format date to "DD.MMM.YYYY"
let formattedDate = "22.FEB.2025";
if (data.fecha) {
  try {
    const dateObj = new Date(data.fecha + 'T00:00:00');
    if (!isNaN(dateObj.getTime())) {
      const months = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC"];
      const day = String(dateObj.getDate()).padStart(2, '0');
      const month = months[dateObj.getMonth()];
      const year = dateObj.getFullYear();
      formattedDate = `${day}.${month}.${year}`;
    }
  } catch (e) {
    console.error("Error formatting date:", e);
  }
}
---

<header class="relative h-screen flex flex-col justify-between items-center text-center overflow-hidden bg-emerald-950 select-none">
  <!-- Full Screen Background Image -->
  <div class="absolute inset-0">
    <img 
      src={displayImagen} 
      alt={displayNombres} 
      class="w-full h-full object-cover object-center scale-[1.01] transition-transform duration-1000 hover:scale-[1.04]"
    />
    <!-- Dark subtle overlay for legibility -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/60 z-10"></div>
  </div>

  <!-- Left Floating Music Square Button -->
  <div class="absolute left-6 top-1/2 -translate-y-1/2 z-20">
    <button 
      id="elegant-music-btn"
      class="w-10 h-10 bg-white/10 hover:bg-white/20 active:scale-95 text-white backdrop-blur-sm border border-white/25 flex items-center justify-center rounded-lg shadow-md transition-all duration-300 focus:outline-none"
      aria-label="Activar música"
    >
      <svg id="e-play-icon" class="w-4 h-4 fill-current ml-0.5" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z" />
      </svg>
      <svg id="e-pause-icon" class="w-4 h-4 fill-current hidden" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
      </svg>
    </button>
  </div>

  <!-- Top Section: Invitation details -->
  <div class="w-full pt-16 z-20 px-6 flex flex-col items-center gap-1.5 text-white/95">
    <span class="text-[10px] tracking-[0.4em] font-sans font-bold uppercase text-white/70">
      INVITACIÓN PARA:
    </span>
    <span class="font-handwriting text-3xl text-white drop-shadow-md">
      {displayInvitado}
    </span>
  </div>

  <!-- Center Logo-Style Typography Block -->
  <div class="w-full px-6 z-20 flex flex-col justify-center items-center flex-grow py-12">
    <!-- Top ornamental line with diamond -->
    <div class="flex items-center gap-3 w-40 opacity-80">
      <div class="h-[1px] flex-grow bg-gradient-to-r from-transparent to-[#d2ab67]"></div>
      <div class="w-2.5 h-2.5 bg-[#d2ab67] rotate-45 border border-white/40"></div>
      <div class="h-[1px] flex-grow bg-gradient-to-l from-transparent to-[#d2ab67]"></div>
    </div>

    <!-- Names with Script and overlap -->
    <div class="flex flex-col items-center my-4">
      <span class="text-xs md:text-sm tracking-[0.3em] font-serif uppercase text-[#d2ab67] mb-1 font-bold">
        NUESTRA BODA
      </span>
      <h2 class="text-5xl md:text-6xl font-handwriting text-white leading-none drop-shadow-md filter select-none">
        {name1} <span class="text-3xl text-[#d2ab67] font-serif font-light font-style-normal mx-1">&</span> {name2}
      </h2>
    </div>

    <!-- Bottom ornamental line with diamond -->
    <div class="flex items-center gap-3 w-40 opacity-80 mb-4">
      <div class="h-[1px] flex-grow bg-gradient-to-r from-transparent to-[#d2ab67]"></div>
      <div class="w-2.5 h-2.5 bg-[#d2ab67] rotate-45 border border-white/40"></div>
      <div class="h-[1px] flex-grow bg-gradient-to-l from-transparent to-[#d2ab67]"></div>
    </div>

    <!-- Formatted date with dots -->
    <p class="text-sm font-serif tracking-[0.35em] text-white/90 drop-shadow-md">
      {formattedDate}
    </p>
  </div>

</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('elegant-music-btn');
    const playIcon = document.getElementById('e-play-icon');
    const pauseIcon = document.getElementById('e-pause-icon');
    let playing = false;

    if (btn) {
      btn.addEventListener('click', () => {
        playing = !playing;
        if (playing) {
          playIcon.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
          window.dispatchEvent(new CustomEvent('play-global-music'));
        } else {
          playIcon.classList.remove('hidden');
          pauseIcon.classList.add('hidden');
          window.dispatchEvent(new CustomEvent('pause-global-music'));
        }
      });
    }
  });
</script>
