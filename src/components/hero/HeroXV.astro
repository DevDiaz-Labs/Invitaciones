---
// src/components/hero/HeroXV.astro
interface Props {
  data: {
    etiqueta?: string;      // E.g., "MIS XV AÑOS"
    nombre?: string;        // E.g., "Sofia Valeria"
    nombres?: string;       // Fallback for names in wedding datasets
    fechaTexto?: string;    // E.g., "15 de Diciembre 2026"
    fechaVista?: string;    // Fallback for dates in wedding datasets
    frase?: string;         // E.g., "¡Prepárate para una noche mágica!"
    imagenFondo?: string;   // URL or local path
  };
}

const { data } = Astro.props;

// Fallbacks matching the mockup
const etiqueta = data?.etiqueta || "MIS XV AÑOS";
const nombre = data?.nombre || data?.nombres || "Sofia Valeria";
const fechaTexto = data?.fechaTexto || data?.fechaVista || "15 de Diciembre 2026";
const frase = data?.frase || "¡PREPÁRATE PARA UNA NOCHE MÁGICA!";
const imagenFondo = data?.imagenFondo || "/imagenes/xv/ejemplo/ejemplo2.jpg";
---

<section class="relative w-full h-screen flex flex-col items-center justify-center text-center overflow-hidden px-4">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Great+Vibes&family=Montserrat:wght@200;300;400;500;600&display=swap');

    .font-vibes {
      font-family: 'Great Vibes', cursive;
    }
    .font-cormorant {
      font-family: 'Cormorant Garamond', serif;
    }
    .font-montserrat {
      font-family: 'Montserrat', sans-serif;
    }
  </style>

  <!-- Background Image with overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src={imagenFondo} 
      alt="Quinceañera" 
      class="w-full h-full object-cover object-center" 
      onerror="this.src='https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200&auto=format&fit=crop';"
    />
    {/* Soft overlay matching the mockup */}
    <div class="absolute inset-0 bg-black/40 bg-gradient-to-t from-black/55 via-transparent to-black/20"></div>
  </div>

  {/* Content aligned centrally */}
  <div class="relative z-10 text-white flex flex-col items-center max-w-2xl space-y-4 md:space-y-5 pt-8">
    
    <h2 class="font-montserrat text-[10px] md:text-sm tracking-[0.4em] uppercase text-white/80 font-light drop-shadow-sm">
      {etiqueta}
    </h2>
    
    <h1 class="font-vibes text-[14vw] sm:text-6xl md:text-7xl lg:text-8xl text-white font-normal drop-shadow-md tracking-normal my-1 leading-none">
      {nombre}
    </h1>

    {/* Subtle custom color divider line with red gradient */}
    <div class="w-36 h-[1.5px] bg-gradient-to-r from-transparent via-[#b30000]/70 to-transparent my-4"></div>
    
    <p class="font-cormorant text-2xl md:text-3xl lg:text-4xl font-light text-white/95 drop-shadow-sm">
      {fechaTexto}
    </p>
    
    <p class="font-montserrat text-[8px] md:text-xs tracking-[0.3em] uppercase text-white/85 font-light pt-2">
      {frase}
    </p>
    
  </div>

  {/* Downward arrow at the bottom */}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 cursor-pointer animate-bounce" onclick="const next = document.getElementById('historia') || document.querySelector('section:nth-of-type(2)'); if(next) next.scrollIntoView({behavior: 'smooth'})">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l-4.5-4.5M12 19.5l4.5-4.5" />
    </svg>
  </div>
</section>
