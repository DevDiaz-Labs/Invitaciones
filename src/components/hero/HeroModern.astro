---
interface Props {
  data: {
    imagenFondo: string;
    fechaVista: string;
    fecha: string;
    nombres: string;
    frase: string;
  };
}
const { data } = Astro.props;
---
<section class="relative w-full h-screen flex flex-col md:flex-row overflow-hidden bg-gray-50">
  <div class="w-full md:w-1/2 h-1/2 md:h-full relative z-0">
    <img src={data.imagenFondo} alt="Fondo" class="w-full h-full object-cover object-center grayscale hover:grayscale-0 transition duration-700" />
  </div>
  <div class="w-full md:w-1/2 h-1/2 md:h-full flex flex-col justify-center items-start px-8 md:px-16 z-10 bg-white shadow-[-20px_0_30px_rgba(0,0,0,0.1)]">
    <span class="inline-block px-4 py-1 bg-black text-white text-xs font-bold tracking-widest uppercase mb-6 rounded-full">{data.fechaVista}</span>
    <h1 class="font-sans text-5xl md:text-7xl font-extrabold text-black leading-tight mb-4 tracking-tighter">{data.nombres}</h1>
    <p class="text-lg text-gray-500 font-medium mb-8 border-l-4 border-black pl-4">"{data.frase}"</p>
    <button class="bg-black text-white px-8 py-3 uppercase tracking-wider text-sm font-bold hover:bg-gray-800 transition">RSVP</button>
  </div>
</section>
