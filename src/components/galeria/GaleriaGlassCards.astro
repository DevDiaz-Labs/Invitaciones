---
// src/components/galeria/GaleriaGlassCards.astro
const { data = [] } = Astro.props;
---

<section 
  class="w-full py-20 px-4 bg-[#0d0c0a] relative overflow-hidden"
  x-data={`{ 
    isOpen: false, 
    currentIndex: 0, 
    photos: ${JSON.stringify(data)},
    openLightbox(index) {
      this.currentIndex = index;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
    },
    closeLightbox() {
      this.isOpen = false;
      document.body.style.overflow = '';
    },
    next() {
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
    },
    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
    }
  }`}
  @keydown.escape.window="closeLightbox()"
  @keydown.arrow-right.window="next()"
  @keydown.arrow-left.window="prev()"
>
  {/* Elegant Gold Accents background */}
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-yellow-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10">
    {/* Header */}
    <div class="text-center mb-16">
      <span class="text-amber-400 font-serif italic text-base tracking-widest block">Galería Premium</span>
      <h3 class="font-sans font-light uppercase tracking-[0.2em] text-white text-2xl md:text-3xl mt-2">Destellos de Amor</h3>
      <div class="h-[1px] w-24 bg-gradient-to-r from-transparent via-amber-400 to-transparent mx-auto mt-4"></div>
    </div>

    {data.length === 0 ? (
      <div class="text-center text-gray-500 font-serif italic py-12">No hay fotos en esta galería</div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {data.map((photo, index) => {
          return (
            <div 
              class="group relative rounded-3xl p-3 bg-white/[0.03] backdrop-blur-md border border-white/10 hover:border-amber-400/40 shadow-2xl transition-all duration-500 hover:-translate-y-2 cursor-pointer overflow-hidden"
              @click={`openLightbox(${index})`}
            >
              {/* Golden sweep effect container */}
              <div class="absolute inset-0 shimmer-effect opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-10"></div>
              
              {/* Photo wrapper */}
              <div class="relative w-full aspect-[4/5] overflow-hidden rounded-2xl bg-neutral-900 border border-white/[0.05]">
                <img 
                  src={photo} 
                  alt={`Glass card ${index + 1}`}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                
                {/* Subtle internal gold gradient glow */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 pointer-events-none"></div>
              </div>

              {/* Card Footer details */}
              <div class="mt-3 flex items-center justify-between px-1">
                <span class="text-[10px] uppercase font-sans tracking-widest text-amber-400/80">Recuerdo</span>
                <span class="font-serif italic text-white/60 text-xs">#{index + 1}</span>
              </div>
            </div>
          );
        })}
      </div>
    )}

    {/* CSS for custom gold shimmer animation */}
    <style>
      @keyframes shimmer {
        0% {
          background-position: -200% 0;
        }
        100% {
          background-position: 200% 0;
        }
      }
      .shimmer-effect {
        background: linear-gradient(120deg, rgba(255,255,255,0) 30%, rgba(217, 119, 6, 0.25) 50%, rgba(255,255,255,0) 70%);
        background-size: 200% 100%;
      }
      .group:hover .shimmer-effect {
        animation: shimmer 2s infinite linear;
      }
    </style>

    {/* Lightbox Modal */}
    <template x-teleport="body">
      <div 
        x-show="isOpen" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-[100] flex items-center justify-center bg-black/98 p-4 md:p-8 select-none"
        style="display: none;"
      >
        {/* Close Button */}
        <button 
          @click="closeLightbox()"
          class="absolute top-4 right-4 z-[110] p-3 text-amber-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        {/* Navigation Controls */}
        <button 
          @click="prev()"
          class="absolute left-4 z-[110] p-3 text-amber-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <button 
          @click="next()"
          class="absolute right-4 z-[110] p-3 text-amber-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full transition-all duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>

        {/* Content Display */}
        <div class="relative max-w-full max-h-full flex flex-col items-center justify-center">
          <div class="p-1 rounded-3xl bg-gradient-to-b from-amber-400/30 to-amber-500/0 shadow-2xl">
            <img 
              x-bind:src="photos[currentIndex]" 
              alt="Glass Card Zoom" 
              class="max-w-[95vw] max-h-[80vh] object-contain rounded-2xl border border-white/10"
            />
          </div>
          <div class="mt-5 text-center">
            <span class="text-amber-400 font-sans text-xs tracking-widest uppercase">
              RECUERDO PREMIUM &bull; <span x-text="currentIndex + 1"></span> de <span x-text="photos.length"></span>
            </span>
          </div>
        </div>
      </div>
    </template>
  </div>
</section>
