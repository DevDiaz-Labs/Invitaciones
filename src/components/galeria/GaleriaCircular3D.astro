---
// src/components/galeria/GaleriaCircular3D.astro
const { data = [] } = Astro.props;
---

<section 
  class="w-full py-16 bg-neutral-900 overflow-hidden relative flex flex-col items-center justify-center min-h-[500px]"
  x-data={`{
    active: 0,
    total: ${data.length},
    isOpen: false,
    photos: ${JSON.stringify(data)},
    startX: 0,
    isSwiping: false,
    swipeX: 0,
    
    next() {
      this.active = (this.active + 1) % this.total;
    },
    prev() {
      this.active = (this.active - 1 + this.total) % this.total;
    },
    selectCard(idx) {
      if (this.active === idx) {
        this.isOpen = true;
        document.body.style.overflow = 'hidden';
      } else {
        this.active = idx;
      }
    },
    closeLightbox() {
      this.isOpen = false;
      document.body.style.overflow = '';
    },
    startSwipe(e) {
      this.startX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
      this.isSwiping = true;
      this.swipeX = 0;
    },
    moveSwipe(e) {
      if (!this.isSwiping) return;
      const currentX = e.type.startsWith('touch') ? e.touches[0].clientX : e.clientX;
      this.swipeX = currentX - this.startX;
    },
    endSwipe() {
      if (!this.isSwiping) return;
      this.isSwiping = false;
      if (this.swipeX > 50) {
        this.prev();
      } else if (this.swipeX < -50) {
        this.next();
      }
      this.swipeX = 0;
    }
  }`}
  @mousedown="startSwipe"
  @mousemove="moveSwipe"
  @mouseup="endSwipe"
  @mouseleave="endSwipe"
  @touchstart="startSwipe"
  @touchmove="moveSwipe"
  @touchend="endSwipe"
  @keydown.escape.window="closeLightbox()"
  @keydown.arrow-right.window="next()"
  @keydown.arrow-left.window="prev()"
>
  <!-- Background Glow -->
  <div class="absolute w-[300px] h-[300px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  {data.length === 0 ? (
    <div class="text-center text-gray-500 font-serif italic">No hay fotos en esta galería</div>
  ) : (
    <div class="w-full max-w-5xl flex flex-col items-center">
      {/* Title */}
      <div class="text-center mb-12">
        <span class="text-amber-500 text-xs font-mono uppercase tracking-widest">Galería Circular</span>
        <h3 class="font-serif italic text-white text-3xl mt-1">Gira y Descubre</h3>
      </div>

      {/* 3D viewport */}
      <div class="relative w-full h-[320px] flex items-center justify-center" style="perspective: 1200px; transform-style: preserve-3d;">
        <div class="relative w-[220px] h-[300px] flex items-center justify-center" style="transform-style: preserve-3d;">
          {data.map((photo, index) => {
            return (
              <div
                class="absolute w-[200px] h-[280px] rounded-2xl overflow-hidden shadow-2xl border border-white/10 cursor-pointer transition-all duration-500 ease-out select-none"
                style="transform-style: preserve-3d; backface-visibility: hidden;"
                @click={`selectCard(${index})`}
                x-data={`{ idx: ${index} }`}
                x-bind:style={`
                  let diff = idx - active;
                  // Handle wrapping for cyclical diff
                  if (diff < -total/2) diff += total;
                  if (diff > total/2) diff -= total;
                  
                  let absDiff = Math.abs(diff);
                  
                  let transX = diff * 120; // translation distance
                  let transZ = -absDiff * 150; // push back in 3D
                  let rotY = -diff * 35; // rotate side cards
                  let scale = 1 - (absDiff * 0.12);
                  let opacity = absDiff > 2 ? 0 : (1 - (absDiff * 0.35));
                  let zIndex = 100 - absDiff;
                  
                  // Adjust for active swipe transition preview
                  if (idx === active) {
                    transX += swipeX * 0.2;
                    rotY -= swipeX * 0.05;
                  }
                  
                  return {
                    transform: 'translate3d(' + transX + 'px, 0, ' + transZ + 'px) rotateY(' + rotY + 'deg) scale(' + scale + ')',
                    zIndex: zIndex,
                    opacity: opacity,
                    pointerEvents: absDiff > 1.5 ? 'none' : 'auto'
                  };
                `}
              >
                <img 
                  src={photo} 
                  alt={`Foto 3D ${index + 1}`}
                  class="w-full h-full object-cover select-none"
                  draggable="false"
                  loading="lazy"
                />
                {/* Dark shading gradient for depth */}
                <div 
                  class="absolute inset-0 transition-opacity duration-500 pointer-events-none"
                  x-bind:style={`
                    let diff = idx - active;
                    if (diff < -total/2) diff += total;
                    if (diff > total/2) diff -= total;
                    let opacity = Math.min(Math.abs(diff) * 0.4, 0.7);
                    return { backgroundColor: 'rgba(0, 0, 0, ' + opacity + ')' };
                  `}
                ></div>
              </div>
            );
          })}
        </div>
      </div>

      {/* Navigation Indicators */}
      <div class="flex items-center gap-6 mt-12 z-20">
        <button 
          @click="prev()"
          class="w-10 h-10 rounded-full border border-white/20 hover:border-white/60 text-white flex items-center justify-center transition-all bg-black/40 hover:bg-black/60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>
        
        {/* Bullets */}
        <div class="flex gap-2">
          {data.map((_, index) => (
            <button
              class="w-2 h-2 rounded-full transition-all duration-300"
              x-bind:class={`active === ${index} ? 'bg-amber-500 w-4' : 'bg-white/30'`}
              @click={`active = ${index}`}
            ></button>
          ))}
        </div>

        <button 
          @click="next()"
          class="w-10 h-10 rounded-full border border-white/20 hover:border-white/60 text-white flex items-center justify-center transition-all bg-black/40 hover:bg-black/60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>
      </div>

      {/* Lightbox Modal */}
      <template x-teleport="body">
        <div 
          x-show="isOpen" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 p-4 md:p-8 select-none"
          style="display: none;"
        >
          {/* Close button */}
          <button 
            @click="closeLightbox()"
            class="absolute top-4 right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          {/* Navigation Controls inside lightbox */}
          <button 
            @click="active = (active - 1 + total) % total"
            class="absolute left-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>

          <button 
            @click="active = (active + 1) % total"
            class="absolute right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          {/* Image display */}
          <div class="relative max-w-full max-h-full flex flex-col items-center justify-center">
            <img 
              x-bind:src="photos[active]" 
              alt="Ampliada 3D" 
              class="max-w-[95vw] max-h-[85vh] object-contain rounded-lg shadow-2xl border border-white/10"
            />
            {/* Info panel */}
            <div class="mt-4 text-center text-white/70 text-sm font-sans tracking-wide">
              Foto <span x-text="active + 1"></span> de <span x-text="total"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
  )}
</section>
