---
// src/components/galeria/GaleriaCineFilm.astro
const { data = [], titulo, bgImage, bgColor = "transparent", bgSize = "cover", bgRepeat = "no-repeat", bgPosition = "center", mostrarMarca = true } = Astro.props;
---

<section 
  class="w-full pt-16 pb-2 overflow-hidden select-none"
  style={`background-color: ${bgColor}; ${bgImage ? `background-image: url('${bgImage}'); background-size: ${bgSize}; background-position: ${bgPosition}; background-repeat: ${bgRepeat};` : ''}`}
  x-data={`{ 
    isOpen: false, 
    currentIndex: 0, 
    photos: ${JSON.stringify(data.map(photo => typeof photo === 'string' ? photo : (photo.url || '')))},
    openLightbox(index) {
      this.currentIndex = index;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
    },
    closeLightbox() {
      this.isOpen = false;
      document.body.style.overflow = '';
    },
    next() {
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
    },
    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
    }
  }`}
  @keydown.escape.window="closeLightbox()"
  @keydown.arrow-right.window="next()"
  @keydown.arrow-left.window="prev()"
>
  <!-- Title / Deco -->
  <div class="text-center mb-8 px-4">
    <h3 class="font-serif font-bold text-[var(--gold)] text-3xl tracking-wide">{titulo || 'Nuestros Momentos de Cine'}</h3>
    <div class="h-[1px] w-16 mx-auto mt-2" style="background-color: var(--gold); opacity: 0.4;"></div>
  </div>

  {data.length === 0 ? (
    <div class="text-center text-gray-500 font-serif italic">No hay fotos en esta galería</div>
  ) : (
    <div class="relative w-full py-4 flex items-center overflow-hidden">
      <!-- 35mm Film Strip Container -->
      <div class="flex gap-4 w-max animate-marquee hover:[animation-play-state:paused] cursor-pointer">
        {/* Double the array for seamless infinite marquee scrolling */}
        {[...data, ...data, ...data].map((photo, index) => {
          const originalIndex = index % data.length;
          const imgUrl = typeof photo === 'string' ? photo : (photo.url || '');
          const imgPosition = typeof photo === 'object' && photo.position ? photo.position : (originalIndex === 0 ? 'bottom' : ((originalIndex === 1 || originalIndex === 2 || originalIndex === 5) ? 'top' : 'center'));
          return (
            <div 
              class="relative flex-none w-[200px] md:w-[260px] bg-[#1a1a1a] p-3 border-y-8 border-dashed border-[#000] flex flex-col items-center group transition-all duration-300 hover:bg-[#262626]"
              @click={`openLightbox(${originalIndex})`}
            >
              {/* Top Film Sprockets */}
              <div class="absolute top-1 left-0 right-0 flex justify-between px-2 pointer-events-none">
                {[...Array(8)].map(() => (
                  <div class="w-3 h-4 bg-[#121212] rounded-sm border border-neutral-800"></div>
                ))}
              </div>

              {/* Photo Frame */}
              <div class="relative w-full aspect-[4/3] bg-neutral-900 overflow-hidden my-3 border border-neutral-950">
                <img 
                  src={imgUrl} 
                  alt={`Fotograma ${originalIndex + 1}`}
                  class="w-full h-full object-cover sepia-[30%] contrast-[1.05] brightness-90 group-hover:sepia-0 group-hover:brightness-100 group-hover:scale-105 transition-all duration-500"
                  style={`object-position: ${imgPosition};`}
                  loading="lazy"
                />
                
                {/* Vintage Vignette Overlay */}
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_40%,rgba(0,0,0,0.4))] pointer-events-none"></div>
              </div>

              {/* Bottom Film Sprockets */}
              <div class="absolute bottom-1 left-0 right-0 flex justify-between px-2 pointer-events-none">
                {[...Array(8)].map(() => (
                  <div class="w-3 h-4 bg-[#121212] rounded-sm border border-neutral-800"></div>
                ))}
              </div>

              {/* Frame counter */}
              <div class="w-full flex justify-between text-[10px] text-neutral-500 font-mono tracking-widest px-1">
                <span>{mostrarMarca ? "KODAK 5028" : ""}</span>
                <span>{String(originalIndex + 1).padStart(2, '0')}</span>
              </div>
            </div>
          );
        })}
      </div>
      
      {/* CSS Styles for the infinite loop animation */}
      <style>
        @keyframes marquee {
          0% {
            transform: translate3d(0, 0, 0);
          }
          100% {
            transform: translate3d(-33.3333%, 0, 0);
          }
        }
        .animate-marquee {
          animation: marquee 25s linear infinite;
        }
      </style>

      {/* Lightbox Modal */}
      <template x-teleport="body">
        <div 
          x-show="isOpen" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 p-4 md:p-8 select-none"
          style="display: none;"
        >
          {/* Close button */}
          <button 
            @click="closeLightbox()"
            class="absolute top-4 right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          {/* Navigation Controls */}
          <button 
            @click="prev()"
            class="absolute left-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>

          <button 
            @click="next()"
            class="absolute right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          {/* Image display */}
          <div class="relative max-w-full max-h-full flex flex-col items-center justify-center">
            <img 
              x-bind:src="photos[currentIndex]" 
              alt="Cine Ampliada" 
              class="max-w-[95vw] max-h-[85vh] object-contain rounded border-4 border-neutral-900 shadow-2xl"
            />
            {/* Film info inside lightbox */}
            <div class="mt-4 text-center font-mono text-sm tracking-widest uppercase" style="color: var(--gold);">
              REEL &bull; FOTOGRAMA <span x-text="String(currentIndex + 1).padStart(2, '0')"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
  )}
</section>
