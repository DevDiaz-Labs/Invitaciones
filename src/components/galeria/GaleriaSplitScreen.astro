---
// GaleriaSplitScreen.astro
// Split screen gallery. Left: high-res active preview. Right: scrollable thumbnail list/grid.
const { data = [] } = Astro.props;

const defaultImages = [
  "https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1606800052052-a08af7148866?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1583939003579-730e3918a45a?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1532712938310-34cb3982ef74?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1515934751635-c81c6bc9a2d8?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
];

const images = data && data.length > 0 ? data : defaultImages;
---

<section class="py-12 bg-stone-100 px-4 md:px-6 w-full flex items-center justify-center">
  <div 
    class="w-full max-w-6xl flex flex-col md:flex-row h-auto md:h-[750px] bg-white rounded-3xl overflow-hidden shadow-xl border border-stone-200/40"
    x-data={`{ 
      active: '${images[0]}', 
      activeIndex: 0,
      setActive(src, idx) {
        this.active = src;
        this.activeIndex = idx;
      }
    }`}
  >
    <!-- Columna Izquierda: Visualización Activa (Fija/Sticky en md) -->
    <div class="w-full md:w-1/2 h-[350px] md:h-full bg-stone-950 relative overflow-hidden flex items-center justify-center group shrink-0">
      <!-- Overlay Gradiente -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/60 z-10 pointer-events-none"></div>

      <!-- Renderizamos todas las imágenes apiladas para poder hacer transiciones suaves -->
      {images.map((src, index) => (
        <div 
          x-show={`activeIndex === ${index}`}
          x-transition:enter="transition duration-700 ease-out"
          x-transition:enter-start="opacity-0 scale-105"
          x-transition:enter-end="opacity-100 scale-100"
          x-transition:leave="transition duration-500 ease-in"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="absolute inset-0 w-full h-full"
          style={index !== 0 ? "display: none;" : ""}
        >
          <img 
            src={src} 
            alt="Momento Destacado" 
            class="w-full h-full object-cover transition-transform duration-[8000ms] ease-out scale-100 group-hover:scale-110"
          />
        </div>
      ))}

      <!-- Textos flotantes del item activo -->
      <div class="absolute bottom-8 left-8 right-8 z-20 text-white pointer-events-none">
        <span class="text-xs uppercase tracking-widest text-white/70 font-sans block mb-1">
          Momento Seleccionado
        </span>
        <h3 class="text-2xl font-light font-serif" x-text="'Fotografía N° ' + (activeIndex + 1)">
          Fotografía N° 1
        </h3>
      </div>
    </div>

    <!-- Columna Derecha: Interaction y Grid Scrollable -->
    <div class="w-full md:w-1/2 h-full flex flex-col justify-between p-6 md:p-10 overflow-hidden bg-stone-50">
      <div class="mb-6">
        <span class="text-xs uppercase tracking-widest text-stone-500 font-semibold font-sans">Detalles de Boda</span>
        <h2 class="text-2xl md:text-3xl font-light text-stone-800 mt-1 font-serif">Nuestros Recuerdos</h2>
        <p class="text-sm text-stone-500 mt-2">Haz clic o pasa el mouse sobre las miniaturas para verlas en grande.</p>
      </div>

      <!-- Grid con Scroll en desktop -->
      <div class="flex-grow overflow-y-auto pr-1 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-2 gap-4 max-h-[300px] md:max-h-[480px] scroll-smooth py-1">
        {images.map((src, index) => (
          <div 
            @click={`setActive('${src}', ${index})`}
            @mouseenter={`setActive('${src}', ${index})`}
            class="relative aspect-[4/3] rounded-2xl overflow-hidden cursor-pointer border-2 transition-all duration-300 group bg-stone-200"
            :class={`activeIndex === ${index} ? 'border-stone-800 shadow-md scale-95' : 'border-transparent opacity-75 hover:opacity-100'`}
          >
            <img 
              src={src} 
              alt={`Miniatura ${index + 1}`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" 
              loading="lazy"
            />
            <div class="absolute inset-0 bg-stone-900/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
        ))}
      </div>

      <!-- Footer sutil en la sección de interacción -->
      <div class="border-t border-stone-200 mt-6 pt-4 flex items-center justify-between text-xs text-stone-400">
        <span>Seleccionada: <strong class="text-stone-700" x-text="activeIndex + 1">1</strong> de {images.length}</span>
        <span>Invitación Premium</span>
      </div>
    </div>
  </div>
</section>
