---
// src/components/galeria/GaleriaTimelineGrowth.astro
const { data = [] } = Astro.props;

// Milestones corresponding to timeline indices
const milestones = [
  { title: "El Comienzo", desc: "El día en que cruzamos miradas y decidimos empezar a escribir nuestra historia juntos." },
  { title: "Primeros Viajes", desc: "Descubriendo nuevos lugares, risas y aventuras que fortalecieron nuestro amor." },
  { title: "Nuestros Logros", desc: "Apoyándonos mutuamente en cada paso y construyendo un hogar lleno de sueños." },
  { title: "El Compromiso", desc: "Bajo un cielo inolvidable, respondimos con un 'Sí' que durará toda la vida." },
  { title: "El Gran Día", desc: "El inicio de nuestra mayor y más hermosa aventura. ¡Bienvenidos a nuestra boda!" }
];
---

<section 
  class="w-full py-20 px-4 bg-[#FAF9F5] overflow-hidden"
  x-data={`{ 
    isOpen: false, 
    currentIndex: 0, 
    photos: ${JSON.stringify(data)},
    openLightbox(index) {
      this.currentIndex = index;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
    },
    closeLightbox() {
      this.isOpen = false;
      document.body.style.overflow = '';
    },
    next() {
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
    },
    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
    }
  }`}
  @keydown.escape.window="closeLightbox()"
  @keydown.arrow-right.window="next()"
  @keydown.arrow-left.window="prev()"
>
  <div class="max-w-4xl mx-auto relative">
    {/* Section header */}
    <div class="text-center mb-16">
      <span class="text-amber-600/70 text-xs font-mono uppercase tracking-[0.25em]">Nuestra Línea del Tiempo</span>
      <h3 class="font-serif italic text-3xl md:text-4xl text-stone-800 mt-2">Nuestra Historia de Crecimiento</h3>
      <div class="h-[1px] w-20 bg-amber-600/30 mx-auto mt-4"></div>
    </div>

    {data.length === 0 ? (
      <div class="text-center text-stone-400 font-serif italic py-12">No hay fotos en esta galería</div>
    ) : (
      <div class="relative">
        {/* Central Vertical Line (alternating layout) */}
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-[2px] bg-gradient-to-b from-amber-600/10 via-amber-600/30 to-amber-600/10 transform md:-translate-x-1/2"></div>

        {/* Timeline Items */}
        <div class="space-y-12 md:space-y-24">
          {data.map((photo, index) => {
            const isEven = index % 2 === 0;
            const milestone = milestones[index % milestones.length];
            
            return (
              <div 
                class={`relative flex flex-col md:flex-row items-start md:items-center ${isEven ? 'md:flex-row-reverse' : ''} w-full`}
              >
                {/* Timeline Dot */}
                <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-amber-600 border-4 border-[#FAF9F5] rounded-full transform -translate-x-1/2 z-10 shadow"></div>

                {/* Photo Side */}
                <div class="w-full md:w-1/2 pl-12 md:pl-0 md:px-8">
                  <div 
                    class="group relative bg-white p-3 rounded-2xl shadow-sm hover:shadow-xl border border-stone-200/40 cursor-pointer overflow-hidden transition-all duration-500"
                    @click={`openLightbox(${index})`}
                  >
                    <div class="relative w-full aspect-[4/3] overflow-hidden rounded-xl bg-stone-100">
                      <img 
                        src={photo} 
                        alt={milestone.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                    {/* Hover effect highlight */}
                    <div class="absolute inset-0 bg-amber-900/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"></div>
                  </div>
                </div>

                {/* Description Side */}
                <div class="w-full md:w-1/2 pl-12 md:pl-0 md:px-8 mt-4 md:mt-0 flex flex-col justify-center">
                  <div class={`max-w-md ${isEven ? 'md:text-left' : 'md:text-right md:ml-auto'}`}>
                    <span class="text-[10px] md:text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold bg-amber-50 px-2.5 py-1 rounded-full">
                      Paso {index + 1}
                    </span>
                    <h4 class="font-serif text-xl md:text-2xl text-stone-800 mt-2 font-medium">
                      {milestone.title}
                    </h4>
                    <p class="text-stone-500 text-xs md:text-sm mt-2 leading-relaxed font-sans font-light">
                      {milestone.desc}
                    </p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {/* Lightbox Modal */}
    <template x-teleport="body">
      <div 
        x-show="isOpen" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-[100] flex items-center justify-center bg-stone-950/95 p-4 md:p-8 select-none"
        style="display: none;"
      >
        {/* Close Button */}
        <button 
          @click="closeLightbox()"
          class="absolute top-4 right-4 z-[110] p-3 text-stone-300 hover:text-white bg-stone-900/60 rounded-full transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        {/* Navigation Controls */}
        <button 
          @click="prev()"
          class="absolute left-4 z-[110] p-3 text-stone-300 hover:text-white bg-stone-900/60 rounded-full transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
        </button>

        <button 
          @click="next()"
          class="absolute right-4 z-[110] p-3 text-stone-300 hover:text-white bg-stone-900/60 rounded-full transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </button>

        {/* Content Display */}
        <div class="relative max-w-full max-h-full flex flex-col items-center justify-center">
          <img 
            x-bind:src="photos[currentIndex]" 
            alt="Timeline Zoom" 
            class="max-w-[95vw] max-h-[85vh] object-contain shadow-2xl border border-stone-850 rounded-lg"
          />
          <div class="mt-4 text-center">
            <span class="text-amber-500 font-serif italic text-base block" x-text="milestones[currentIndex % milestones.length] ? milestones[currentIndex % milestones.length].title : 'Momento'"></span>
            <span class="text-stone-400 font-sans text-xs tracking-wider mt-1 block">
              Foto <span x-text="currentIndex + 1"></span> de <span x-text="photos.length"></span>
            </span>
          </div>
        </div>
      </div>
    </template>
  </div>
</section>
