---
// GaleriaSwipeDeck.astro
// Tarjetas deslizables estilo Tinder con gestos táctiles y controles de botón
const { data = [] } = Astro.props;

const defaultImages = [
  "https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1606800052052-a08af7148866?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1583939003579-730e3918a45a?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80",
  "https://images.unsplash.com/photo-1532712938310-34cb3982ef74?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80"
];

const images = data && data.length > 0 ? data : defaultImages;
const imagesJson = JSON.stringify(images);
---

<section class="py-16 bg-stone-100 flex flex-col items-center justify-center overflow-hidden min-h-[700px] w-full px-4 relative select-none">
  <div class="max-w-md w-full text-center mb-6">
    <span class="text-xs uppercase tracking-widest text-stone-500 font-semibold">Interactúa</span>
    <h2 class="text-3xl font-light text-stone-800 mt-1 font-serif">Desliza las Fotos</h2>
    <p class="text-xs text-stone-400 mt-1">Desliza a la izquierda o derecha para ver más momentos</p>
  </div>

  <!-- Contenedor del Deck -->
  <div class="relative w-full max-w-[320px] aspect-[3/4] md:max-w-[350px] flex items-center justify-center" id="swipe-deck-container" data-images={imagesJson}>
    
    <!-- Pantalla de reinicio cuando se acaban las fotos -->
    <div id="deck-empty-state" class="absolute inset-0 bg-white/80 backdrop-blur-md rounded-3xl shadow-xl flex flex-col items-center justify-center p-6 text-center opacity-0 pointer-events-none transition-opacity duration-300 z-0">
      <div class="w-16 h-16 rounded-full bg-stone-200 flex items-center justify-center mb-4 text-stone-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 15H19" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-stone-700 font-serif">¡Has visto todas!</h3>
      <p class="text-xs text-stone-400 mt-1 mb-5">¿Quieres volver a empezar el recorrido?</p>
      <button id="btn-reset-deck" class="px-6 py-2 bg-stone-800 text-white rounded-full text-sm font-light hover:bg-stone-700 transition-colors shadow-md">
        Reiniciar Deck
      </button>
    </div>

    <!-- Render dinámico por JS. Añadimos marcadores para SSR mientras carga el JS -->
    {images.map((src, index) => {
      // Crear un stack visual simulado antes de que cargue el script
      const rotate = index * 2 - 2;
      const scale = 1 - (index * 0.03);
      const translate = index * 8;
      const zIndex = images.length - index;
      
      return (
        <div 
          class="absolute inset-0 bg-white p-3 pb-8 rounded-3xl shadow-lg border border-stone-200/50 flex flex-col cursor-grab active:cursor-grabbing transition-transform duration-300 origin-bottom deck-card-ssr"
          style={`transform: translate3d(0, ${translate}px, 0) rotate(${rotate}deg) scale(${scale}); z-index: ${zIndex};`}
        >
          <div class="w-full flex-grow overflow-hidden rounded-2xl bg-stone-50">
            <img src={src} alt={`Momento de la boda ${index + 1}`} class="w-full h-full object-cover pointer-events-none" />
          </div>
          <div class="mt-4 text-center font-serif text-stone-600 font-light text-sm italic">
            Momento #{index + 1}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Botones de Acción inferior -->
  <div class="flex items-center gap-6 mt-8 z-10" id="deck-controls">
    <button id="btn-dislike" class="w-14 h-14 rounded-full bg-white shadow-lg hover:shadow-xl border border-stone-200/50 flex items-center justify-center text-red-400 hover:text-red-500 transition-all hover:scale-105 active:scale-95" aria-label="Descartar">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    
    <button id="btn-like" class="w-14 h-14 rounded-full bg-white shadow-lg hover:shadow-xl border border-stone-200/50 flex items-center justify-center text-emerald-400 hover:text-emerald-500 transition-all hover:scale-105 active:scale-95" aria-label="Me gusta">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </button>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("swipe-deck-container");
    if (!container) return;

    try {
      const images: string[] = JSON.parse(container.dataset.images || "[]");
      if (images.length === 0) return;

      // Limpiamos los elementos estáticos SSR y los volvemos a generar para poder gestionarlos dinámicamente con JS
      container.querySelectorAll(".deck-card-ssr").forEach(el => el.remove());

      const emptyState = document.getElementById("deck-empty-state");
      const btnReset = document.getElementById("btn-reset-deck");
      const btnLike = document.getElementById("btn-like");
      const btnDislike = document.getElementById("btn-dislike");

      let cards: HTMLDivElement[] = [];
      let activeIndex = 0; // Apunta a la tarjeta superior del deck (índice 0)

      function createDeck() {
        // Limpiamos tarjetas existentes si las hay
        cards.forEach(card => card.remove());
        cards = [];
        activeIndex = 0;

        if (emptyState) {
          emptyState.classList.add("opacity-0", "pointer-events-none");
          emptyState.classList.remove("opacity-100");
        }

        // Creamos de atrás hacia adelante para que el índice 0 quede al frente (encima)
        images.forEach((src, idx) => {
          const card = document.createElement("div");
          card.className = "absolute inset-0 bg-white p-3 pb-8 rounded-3xl shadow-lg border border-stone-200/50 flex flex-col cursor-grab active:cursor-grabbing transition-transform duration-300 origin-bottom select-none z-10 touch-none";
          
          card.innerHTML = `
            <div class="w-full flex-grow overflow-hidden rounded-2xl bg-stone-50 pointer-events-none">
              <img src="${src}" alt="Momento ${idx + 1}" class="w-full h-full object-cover pointer-events-none" />
            </div>
            <div class="mt-4 text-center font-serif text-stone-600 font-light text-sm italic pointer-events-none">
              Momento #${idx + 1}
            </div>
          `;

          container.appendChild(card);
          cards.push(card);
        });

        // Re-ordenar el DOM para que se apilen correctamente
        updateCardStyles();
        setupDrag();
      }

      function updateCardStyles() {
        const visibleCount = 3; // Cuántas tarjetas queremos ver detrás de la activa
        let relativeIdx = 0;

        cards.forEach((card, idx) => {
          if (idx < activeIndex) {
            // Ya fue deslizada
            return;
          }

          if (relativeIdx < visibleCount) {
            // Tarjeta visible en el stack
            const rotate = relativeIdx * 2.5 - 1.25 * relativeIdx;
            const scale = 1 - (relativeIdx * 0.04);
            const translate = relativeIdx * 10;
            const zIndex = 100 - relativeIdx;

            card.style.opacity = "1";
            card.style.transform = `translate3d(0, ${translate}px, 0) rotate(${rotate}deg) scale(${scale})`;
            card.style.zIndex = zIndex.toString();
            card.style.pointerEvents = relativeIdx === 0 ? "auto" : "none";
          } else {
            // Oculta en el fondo del deck
            card.style.opacity = "0";
            card.style.transform = `translate3d(0, 30px, 0) scale(0.9)`;
            card.style.zIndex = "10";
            card.style.pointerEvents = "none";
          }
          relativeIdx++;
        });

        if (activeIndex >= cards.length) {
          showEmptyState();
        }
      }

      function showEmptyState() {
        if (emptyState) {
          emptyState.classList.remove("opacity-0", "pointer-events-none");
          emptyState.classList.add("opacity-100", "z-20");
        }
      }

      function swipeCard(direction: "left" | "right") {
        if (activeIndex >= cards.length) return;
        
        const card = cards[activeIndex];
        card.style.transition = "transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease";
        
        const flyX = direction === "left" ? -500 : 500;
        const flyRotation = direction === "left" ? -25 : 25;
        
        card.style.transform = `translate3d(${flyX}px, 50px, 0) rotate(${flyRotation}deg)`;
        card.style.opacity = "0";
        card.style.pointerEvents = "none";

        activeIndex++;
        
        setTimeout(() => {
          updateCardStyles();
        }, 200);
      }

      function setupDrag() {
        cards.forEach((card, idx) => {
          let startX = 0;
          let startY = 0;
          let currentX = 0;
          let currentY = 0;
          let isDragging = false;

          const onStart = (e: PointerEvent) => {
            if (idx !== activeIndex) return;
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            card.style.transition = "none";
          };

          const onMove = (e: PointerEvent) => {
            if (!isDragging) return;
            currentX = e.clientX - startX;
            currentY = e.clientY - startY;

            // Rotación proporcional al desplazamiento
            const rotation = currentX * 0.08;
            card.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) rotate(${rotation}deg) scale(1.02)`;
          };

          const onEnd = () => {
            if (!isDragging) return;
            isDragging = false;
            
            const threshold = 120; // Umbral de swipe
            if (currentX > threshold) {
              swipeCard("right");
            } else if (currentX < -threshold) {
              swipeCard("left");
            } else {
              // Snap back
              card.style.transition = "transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)";
              card.style.transform = "translate3d(0, 0, 0) rotate(0deg) scale(1)";
            }
            currentX = 0;
            currentY = 0;
          };

          card.addEventListener("pointerdown", onStart);
          window.addEventListener("pointermove", onMove);
          window.addEventListener("pointerup", onEnd);
        });
      }

      // Eventos de botones
      btnLike?.addEventListener("click", () => {
        swipeCard("right");
      });

      btnDislike?.addEventListener("click", () => {
        swipeCard("left");
      });

      btnReset?.addEventListener("click", () => {
        createDeck();
      });

      // Crear deck inicial
      createDeck();

    } catch (e) {
      console.error("Error al inicializar Tinder deck:", e);
    }
  });
</script>
