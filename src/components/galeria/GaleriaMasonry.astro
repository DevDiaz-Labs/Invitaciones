---
// src/components/galeria/GaleriaMasonry.astro
const { data = [] } = Astro.props;
---

<section 
  class="w-full py-12 px-4 bg-white" 
  x-data={`{ 
    isOpen: false, 
    currentIndex: 0, 
    photos: ${JSON.stringify(data)},
    openLightbox(index) {
      this.currentIndex = index;
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
    },
    closeLightbox() {
      this.isOpen = false;
      document.body.style.overflow = '';
    },
    next() {
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
    },
    prev() {
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
    }
  }`}
  @keydown.escape.window="closeLightbox()"
  @keydown.arrow-right.window="next()"
  @keydown.arrow-left.window="prev()"
>
  {data.length === 0 ? (
    <div class="text-center text-gray-400 font-serif italic">No hay fotos en esta galería</div>
  ) : (
    <div class="max-w-6xl mx-auto">
      {/* Masonry Grid using CSS columns for natural height flow */}
      <div class="columns-2 md:columns-3 lg:columns-4 gap-3 md:gap-4 [column-fill:_balance] w-full">
        {data.map((photo, index) => {
          // Create subtle variations in height ratios to ensure staggered look even if photos are similar
          const heightClasses = [
            "aspect-[3/4]",
            "aspect-[2/3]",
            "aspect-[4/5]",
            "aspect-[1/1]",
            "aspect-[9/16]",
            "aspect-[3/4]"
          ];
          const ratio = heightClasses[index % heightClasses.length];
          
          return (
            <div 
              class={`break-inside-avoid mb-3 md:mb-4 relative group overflow-hidden rounded-2xl shadow-sm hover:shadow-lg transition-all duration-500 bg-gray-50 cursor-pointer ${ratio}`}
              @click={`openLightbox(${index})`}
            >
              <img 
                src={photo} 
                alt={`Mosaico ${index + 1}`}
                class="w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-105"
                loading="lazy"
              />
              
              {/* Premium Overlay on Hover */}
              <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <div class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center shadow-md transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-800">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.636z" />
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* Lightbox Modal */}
      <template x-teleport="body">
        <div 
          x-show="isOpen" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 p-4 md:p-8 select-none"
          style="display: none;"
        >
          {/* Close button */}
          <button 
            @click="closeLightbox()"
            class="absolute top-4 right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>

          {/* Navigation Controls */}
          <button 
            @click="prev()"
            class="absolute left-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>

          <button 
            @click="next()"
            class="absolute right-4 z-[110] p-3 text-white/80 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          {/* Image display */}
          <div class="relative max-w-full max-h-full flex flex-col items-center justify-center">
            <img 
              x-bind:src="photos[currentIndex]" 
              alt="Ampliada" 
              class="max-w-[95vw] max-h-[85vh] object-contain rounded-lg shadow-2xl transition-all duration-300"
            />
            {/* Info panel */}
            <div class="mt-4 text-center text-white/70 text-sm font-sans tracking-wide">
              <span x-text="currentIndex + 1"></span> de <span x-text="photos.length"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
  )}
</section>
