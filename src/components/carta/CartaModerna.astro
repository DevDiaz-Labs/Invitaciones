---
// src/components/carta/CartaModerna.astro
interface Props {
  data: {
    mostrar: boolean;
    texto: string;
    firmaTexto?: string;
    firmaColor?: string;
    colorTexto?: string;
    colorFondo?: string;
  };
}

const { data } = Astro.props;
const firmaColor = data.firmaColor || '#1a1a2e';
const colorTexto = data.colorTexto || '#1a1a2e';
const colorFondo = data.colorFondo || '#ffffff';
---

{data.mostrar && (
<section class="cm-section" style={`background-color: ${colorFondo};`}>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet" />

  <div class="cm-wrapper">
    <!-- Accent bar -->
    <div class="cm-accent-bar"></div>

    <!-- Label -->
    <p class="cm-label">PALABRAS DE LA FESTEJADA</p>

    <!-- Main text -->
    <div class="cm-text" style={`color: ${colorTexto};`} set:html={data.texto}></div>

    <!-- Bottom row -->
    <div class="cm-bottom-row">
      <div class="cm-line"></div>
      {data.firmaTexto && (
        <p class="cm-firma" style={`color: ${firmaColor};`}>{data.firmaTexto}</p>
      )}
    </div>
  </div>
</section>
)}

<style>
  .cm-section {
    position: relative;
    padding: 3.5rem 2rem;
    text-align: left;
    overflow: hidden;
  }



  .cm-wrapper {
    position: relative;
    z-index: 1;
    max-width: 360px;
    margin: 0 auto;
  }

  .cm-accent-bar {
    width: 48px;
    height: 5px;
    background: #1a1a2e;
    margin-bottom: 1.6rem;
    border-radius: 2px;
  }

  .cm-label {
    font-family: 'Inter', 'Arial', sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #888;
    margin: 0 0 1.6rem 0;
  }

  .cm-text {
    font-family: 'Inter', 'Arial', sans-serif;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1.7;
    letter-spacing: -0.01em;
  }

  .cm-text :global(br) {
    content: "";
    display: block;
    margin-bottom: 0.5rem;
  }

  .cm-bottom-row {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cm-line {
    width: 100%;
    height: 1px;
    background: #1a1a2e;
    opacity: 0.12;
  }

  .cm-firma {
    font-family: 'Inter', 'Arial', sans-serif;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }
</style>
