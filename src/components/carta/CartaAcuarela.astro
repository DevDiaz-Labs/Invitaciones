---
// src/components/carta/CartaAcuarela.astro
interface Props {
  data: {
    mostrar: boolean;
    texto: string;
    firmaTexto?: string;
    firmaColor?: string;
    colorTexto?: string;
    colorFondo?: string;
  };
  bgImage?: string;
}

const { data, bgImage } = Astro.props;
---

{data.mostrar && (
<section class="cacu-section">
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap" rel="stylesheet" />
  <div class="cacu-card">
    <div class="cacu-blob"></div>
    <div class="cacu-content">
      <div class="cacu-text" set:html={data.texto}></div>
      {data.firmaTexto && (
        <div class="cacu-firma">{data.firmaTexto}</div>
      )}
    </div>
  </div>
</section>
)}

<style>
  .cacu-section {
    padding: 3rem 1.5rem;
    background-color: #fdfcfb;
    display: flex;
    justify-content: center;
  }
  .cacu-card {
    position: relative;
    max-width: 380px;
    padding: 3rem 2rem;
    background: transparent;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  .cacu-blob {
    position: absolute;
    top: -20%;
    left: -20%;
    width: 140%;
    height: 140%;
    background: radial-gradient(circle at 30% 30%, rgba(255,182,193,0.4), transparent 40%),
                radial-gradient(circle at 70% 60%, rgba(173,216,230,0.4), transparent 50%),
                radial-gradient(circle at 40% 80%, rgba(221,160,221,0.4), transparent 50%);
    filter: blur(20px);
    z-index: 0;
  }
  .cacu-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .cacu-text {
    font-family: 'Caveat', cursive;
    font-size: 1.6rem;
    line-height: 1.4;
    color: #4a4a4a;
  }
  .cacu-text :global(br) {
    margin-bottom: 0.5rem;
    display: block;
    content: "";
  }
  .cacu-firma {
    margin-top: 2rem;
    font-family: 'Caveat', cursive;
    font-size: 1.8rem;
    font-weight: 700;
    color: #db7093;
    transform: rotate(-3deg);
  }
</style>
