---
// src/components/carta/CartaBohemia.astro
interface Props {
  data: {
    mostrar: boolean;
    texto: string;
    firmaTexto?: string;
    firmaColor?: string;
    colorTexto?: string;
    colorFondo?: string;
  };
  bgImage?: string;
}

const { data, bgImage } = Astro.props;
const firmaColor = data.firmaColor || '#b5541a';
const colorTexto = data.colorTexto || '#3d2612';
---

{data.mostrar && (
<section class="cb-section" style={bgImage ? `background-image: linear-gradient(rgba(245,230,215,0.9),rgba(245,230,215,0.9)),url('${bgImage}'); background-size:cover; background-position:center;` : ''}>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,300;0,400;1,300&family=Satisfy&display=swap" rel="stylesheet" />

  <div class="cb-wrapper">

    <!-- Background geometric circles (boho) -->
    <div class="cb-geo" aria-hidden="true">
      <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg" class="cb-geo-svg">
        <circle cx="150" cy="150" r="140" fill="none" stroke="#b5541a" stroke-width="0.8" opacity="0.15"/>
        <circle cx="150" cy="150" r="120" fill="none" stroke="#b5541a" stroke-width="0.5" opacity="0.1"/>
        <circle cx="150" cy="150" r="100" fill="none" stroke="#c8813a" stroke-width="1.2" opacity="0.2" stroke-dasharray="4 6"/>
        <line x1="10" y1="150" x2="290" y2="150" stroke="#b5541a" stroke-width="0.4" opacity="0.1"/>
        <line x1="150" y1="10" x2="150" y2="290" stroke="#b5541a" stroke-width="0.4" opacity="0.1"/>
        <!-- sun rays top -->
        <line x1="150" y1="30" x2="150" y2="50" stroke="#c8813a" stroke-width="1.5" opacity="0.3"/>
        <line x1="120" y1="36" x2="128" y2="53" stroke="#c8813a" stroke-width="1.2" opacity="0.25"/>
        <line x1="180" y1="36" x2="172" y2="53" stroke="#c8813a" stroke-width="1.2" opacity="0.25"/>
      </svg>
    </div>

    <!-- Feather SVG -->
    <div class="cb-feather-wrap">
      <svg viewBox="0 0 50 100" xmlns="http://www.w3.org/2000/svg" class="cb-feather-svg">
        <path d="M25 95 Q25 10, 25 5" stroke="#b5541a" stroke-width="1.2" fill="none" opacity="0.6"/>
        <path d="M25 20 Q15 22, 8 30 Q15 25, 25 25" fill="#c87a40" opacity="0.55"/>
        <path d="M25 30 Q12 33, 5 42 Q13 36, 25 36" fill="#d4935a" opacity="0.5"/>
        <path d="M25 40 Q10 44, 3 54 Q12 47, 25 47" fill="#c87a40" opacity="0.45"/>
        <path d="M25 20 Q35 22, 42 30 Q35 25, 25 25" fill="#c87a40" opacity="0.55"/>
        <path d="M25 30 Q38 33, 45 42 Q37 36, 25 36" fill="#d4935a" opacity="0.5"/>
        <path d="M25 40 Q40 44, 47 54 Q38 47, 25 47" fill="#c87a40" opacity="0.45"/>
        <path d="M25 50 Q11 56, 6 65 Q14 58, 25 58" fill="#d4935a" opacity="0.4"/>
        <path d="M25 50 Q39 56, 44 65 Q36 58, 25 58" fill="#d4935a" opacity="0.4"/>
      </svg>
    </div>

    <!-- Boho tag -->
    <p class="cb-tag">✦ con amor ✦</p>

    <!-- Text -->
    <div class="cb-text" style={`color: ${colorTexto};`} set:html={data.texto}></div>

    <!-- Triangle geometric divider -->
    <div class="cb-triangle-row" aria-hidden="true">
      <svg viewBox="0 0 160 20" xmlns="http://www.w3.org/2000/svg" width="140" height="18">
        <polygon points="50,2 60,18 40,18" fill="none" stroke="#b5541a" stroke-width="1" opacity="0.4"/>
        <polygon points="80,2 90,18 70,18" fill="#b5541a" opacity="0.3"/>
        <polygon points="110,2 120,18 100,18" fill="none" stroke="#b5541a" stroke-width="1" opacity="0.4"/>
        <line x1="5" y1="10" x2="35" y2="10" stroke="#b5541a" stroke-width="0.8" opacity="0.3"/>
        <line x1="125" y1="10" x2="155" y2="10" stroke="#b5541a" stroke-width="0.8" opacity="0.3"/>
      </svg>
    </div>

    <!-- Firma -->
    {data.firmaTexto && (
      <p class="cb-firma" style={`color: ${firmaColor};`}>{data.firmaTexto}</p>
    )}
  </div>
</section>
)}

<style>
  .cb-section {
    position: relative;
    padding: 3rem 2rem;
    background-color: #f5e0c8;
    text-align: center;
    overflow: hidden;
  }

  .cb-wrapper {
    position: relative;
    max-width: 360px;
    margin: 0 auto;
  }

  .cb-geo {
    position: absolute;
    inset: -20px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .cb-geo-svg {
    width: 100%;
    height: 100%;
  }

  .cb-feather-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 0.4rem;
    position: relative;
    z-index: 1;
  }

  .cb-feather-svg {
    width: 36px;
    height: 72px;
  }

  .cb-tag {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #b5541a;
    margin: 0 0 1.6rem 0;
    opacity: 0.8;
    position: relative;
    z-index: 1;
  }

  .cb-text {
    font-family: 'Satisfy', 'Dancing Script', cursive;
    font-size: 1.2rem;
    line-height: 2;
    position: relative;
    z-index: 1;
  }

  .cb-text :global(br) {
    content: "";
    display: block;
    margin-bottom: 0.4rem;
  }

  .cb-triangle-row {
    display: flex;
    justify-content: center;
    margin: 1.4rem 0 1rem;
    position: relative;
    z-index: 1;
  }

  .cb-firma {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin: 0;
    position: relative;
    z-index: 1;
    font-style: italic;
  }
</style>
