---
// src/components/carta/CartaVintage.astro
interface Props {
  data: {
    mostrar: boolean;
    texto: string;
    firmaTexto?: string;
    firmaColor?: string;
    colorTexto?: string;
    colorFondo?: string;
  };
  bgImage?: string;
}

const { data, bgImage } = Astro.props;
---

{data.mostrar && (
<section class="cvin-section" style={bgImage ? `background-image: url('${bgImage}');` : ''}>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&display=swap" rel="stylesheet" />
  
  <div class="cvin-paper">
    <div class="cvin-text" set:html={data.texto}></div>
    {data.firmaTexto && (
      <div class="cvin-firma-container">
        <p class="cvin-firma">{data.firmaTexto}</p>
      </div>
    )}
  </div>
</section>
)}

<style>
  .cvin-section {
    padding: 3rem 1rem;
    background-color: #e3d9c6;
    display: flex;
    justify-content: center;
  }
  .cvin-paper {
    background: #f4ead5;
    padding: 3rem 2rem;
    max-width: 380px;
    box-shadow: inset 0 0 50px rgba(150, 120, 80, 0.2), 3px 3px 10px rgba(0,0,0,0.1);
    border: 1px solid #d4c5ab;
    position: relative;
  }
  .cvin-paper::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('https://www.transparenttextures.com/patterns/old-wall.png');
    opacity: 0.4;
    pointer-events: none;
  }
  .cvin-text {
    font-family: 'Courier Prime', monospace;
    font-size: 1rem;
    line-height: 1.6;
    color: #4a4031;
    text-align: left;
    position: relative;
    z-index: 1;
  }
  .cvin-text :global(br) {
    margin-bottom: 0.8rem;
    display: block;
    content: "";
  }
  .cvin-firma-container {
    margin-top: 2rem;
    text-align: right;
    position: relative;
    z-index: 1;
  }
  .cvin-firma {
    font-family: 'Courier Prime', monospace;
    font-size: 0.9rem;
    color: #5a4b38;
    font-weight: bold;
    border-bottom: 1px dashed #5a4b38;
    display: inline-block;
  }
</style>
