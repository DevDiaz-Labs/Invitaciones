---
// FooterMinimalista.astro
const { data } = Astro.props;

const iniciales = data?.iniciales || "S & M";
const fecha = data?.fechaFooter || "24 . 10 . 2026";
---

<footer class="py-12 text-center border-t border-stone-200 fade-up">
  <h2 class="text-2xl font-serif text-stone-400 mb-2">{iniciales}</h2>
  <p class="text-xs uppercase tracking-widest text-stone-400 mb-6">{fecha}</p>
  <a
    href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información."
    target="_blank"
    class="text-[10px] opacity-45 font-sans hover:text-stone-700 hover:opacity-100 transition-all duration-300 uppercase tracking-widest"
  >
    Desarrollado por DevDiaz Labs
  </a>
</footer>
