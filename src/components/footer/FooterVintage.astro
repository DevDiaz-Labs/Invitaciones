---
const { data } = Astro.props;
const bgColor = data?.colorFondo || 'var(--primaryColor, #2a3b29)';
const textColor = data?.colorTexto || '#fff7ed';
const accentColor = data?.colorAccent || 'var(--gold, #5a7350)';
---
<footer class="py-16 px-8 text-center border-t-8 border-double" style={`background-color: ${bgColor}; color: ${textColor}; border-color: ${accentColor};`}>
  <div class="max-w-xl mx-auto">
    <h2 class="text-5xl font-['Playfair_Display'] mb-4 italic" style={`color: ${textColor};`}>
      {data.nombres}
    </h2>
    <p class="text-lg uppercase tracking-widest font-serif mb-6 border-b inline-block pb-2" style={`color: ${textColor}; border-color: ${accentColor}; opacity: 0.85;`}>
      {data.fechaVista}
    </p>
    {data.hashtag && (
      <div class="font-['Dancing_Script'] text-2xl mb-8" style={`color: ${accentColor};`}>
        {data.hashtag}
      </div>
    )}
    {data.agradecimiento && (
      <p class="text-base font-serif italic mb-8 opacity-75" style={`color: ${textColor};`}>
        {data.agradecimiento}
      </p>
    )}
    <div class="text-sm font-sans tracking-wide flex flex-col items-center gap-3" style={`color: ${textColor}; opacity: 0.6;`}>
      <a href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información." target="_blank" class="transition-colors duration-300 hover:opacity-100" style={`color: ${textColor};`}>
        DevDiaz-Labs
      </a>
      <a href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información." target="_blank" class="transition-colors duration-300 flex items-center justify-center hover:opacity-100" aria-label="Contactar por WhatsApp" style={`color: ${textColor};`}>
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
