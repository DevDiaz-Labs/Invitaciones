---
const { data } = Astro.props;
---
<footer class="bg-black py-20 px-8 text-center border-t border-zinc-800">
  <div class="max-w-md mx-auto">
    <h2 class="text-4xl text-zinc-100 font-['Montserrat'] font-light mb-4">
      {data.nombres}
    </h2>
    <p class="text-zinc-500 tracking-[0.3em] text-xs uppercase mb-8">
      {data.fechaVista}
    </p>
    {data.hashtag && (
      <div class="inline-block px-4 py-2 border border-zinc-700 rounded-full text-zinc-400 hover:bg-zinc-900 transition">
        {data.hashtag}
      </div>
    )}
    <p class="text-zinc-600 text-[10px] mt-16 uppercase tracking-wider">
      © DevDiaz-Labs
    </p>
  </div>
</footer>
