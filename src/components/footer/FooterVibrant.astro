---
const { data } = Astro.props;
---
<footer class="bg-gradient-to-br from-pink-500 to-orange-400 py-12 px-6 text-white text-center">
  <div class="max-w-md mx-auto space-y-4">
    <h2 class="text-4xl font-bold font-['Plus_Jakarta_Sans'] drop-shadow-md">
      {data.nombres}
    </h2>
    <p class="text-lg font-medium opacity-90 drop-shadow-sm">
      {data.fechaVista}
    </p>
    {data.hashtag && (
      <p class="text-xl font-bold bg-white/20 inline-block px-4 py-1 rounded-full backdrop-blur-sm">
        {data.hashtag}
      </p>
    )}
    <div class="pt-8 text-sm font-semibold opacity-75">
      Creado por DevDiaz-Labs
    </div>
  </div>
</footer>
