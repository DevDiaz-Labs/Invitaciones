---
// FooterXV.astro
interface Props {
    data?: {
        nombre?: string;
        agradecimiento?: string;
        mostrarWhatsappCTA?: boolean;
    };
}
const { data } = Astro.props;
const nombre = data?.nombre || "Sofia Valeria";
const agradecimiento = data?.agradecimiento || "¡TE ESPERO PARA CELEBRAR JUNTOS!";
---

<footer class="py-24 text-center relative overflow-hidden bg-[#ffecfb] select-none">
    <!-- Curved rose-pink overlay at the bottom (matching production) -->
    <div class="absolute inset-0 z-0 opacity-10">
        <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            class="w-full h-full"
        >
            <path fill="#b30000" d="M0,100 C30,50 70,50 100,100 Z"></path>
        </svg>
    </div>

    <!-- Main Content -->
    <div class="observe-me fade-up relative z-10">
        <h2
            class="font-handwriting text-6xl md:text-7xl text-[#b30000] mb-6 font-light"
        >
            {nombre}
        </h2>
        <p
            class="text-[10px] md:text-xs tracking-[0.5em] md:tracking-[0.6em] text-[#8A5243]/80 uppercase font-sans font-light"
        >
            {agradecimiento}
        </p>
    </div>

    <!-- Clickable Credits & WhatsApp Icon inside the rose-pink arc -->
    <div
        class="mt-16 text-[10px] text-[#8A5243]/70 tracking-[0.2em] uppercase relative z-10 px-4 observe-me fade-in-slow flex flex-col items-center gap-3"
    >
        <a
            href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información."
            target="_blank"
            class="hover:text-[#b30000] transition-colors duration-300 font-sans font-medium"
        >
            DESARROLLADO POR DEVDIAZ LABS
        </a>

        <a 
            href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información." 
            target="_blank"
            class="text-[#8A5243]/60 hover:text-[#b30000] transition-colors duration-300 flex items-center justify-center"
            aria-label="Contactar por WhatsApp"
        >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
        </a>
    </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');

  .font-handwriting {
    font-family: 'Great Vibes', cursive;
  }
</style>
