---
const { data } = Astro.props;
---
<footer class="bg-gray-900 py-14 px-6 text-white text-center font-sans">
  <div class="max-w-2xl mx-auto flex flex-col items-center">
    <h3 class="text-2xl font-bold tracking-tight mb-2">
      {data.nombres}
    </h3>
    <p class="text-gray-400 text-sm mb-8 font-medium">
      {data.fechaVista}
    </p>
    <div class="flex items-center space-x-2">
      <span class="w-12 h-[2px] bg-indigo-500"></span>
      {data.hashtag && (
        <span class="text-indigo-400 font-semibold">{data.hashtag}</span>
      )}
      <span class="w-12 h-[2px] bg-indigo-500"></span>
    </div>
    <div class="mt-12 text-xs text-gray-500 hover:text-white transition">
      Desarrollado por DevDiaz-Labs
    </div>
  </div>
</footer>
