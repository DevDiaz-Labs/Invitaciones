---
// src/components/ubicacion/UbicacionCompacta.astro
interface Evento {
  titulo?: string;
  lugar?: string;
  direccion?: string;
  hora?: string;
  urlMapa?: string;
  urlMapaDirecto?: string;
  iframeMapa?: string;
}

interface Props {
  data: {
    ceremonia?: Evento;
    recepcion?: Evento;
  };
}

const { data } = Astro.props;
const { ceremonia, recepcion } = data || {};
---

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<section class="ubc-wrap">
  <div class="ubc-header">
    <svg viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5" width="20" height="20"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    <h2 class="ubc-title">Dónde nos vemos</h2>
  </div>

  <div class="ubc-list">
    {ceremonia && (
      <div class="ubc-item">
        <div class="ubc-icon-col">
          <div class="ubc-icon-circle ubc-icon--cer">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="18" height="18">
              <path d="M12 14l9-5-9-5-9 5 9 5z"/>
              <path d="M12 14l6.16-3.42A12.08 12.08 0 0112 20.05a11.95 11.95 0 00-6.82-3-12.08 12.08 0 00.66-6.48L12 14z"/>
            </svg>
          </div>
          <div class="ubc-connector"></div>
        </div>
        <div class="ubc-detail">
          <div class="ubc-detail-top">
            <div>
              <span class="ubc-label">Ceremonia</span>
              <h3 class="ubc-lugar">{ceremonia.lugar}</h3>
              <p class="ubc-dir">{ceremonia.direccion}</p>
            </div>
            <div class="ubc-hora-box">
              <span class="ubc-hora">{ceremonia.hora}</span>
            </div>
          </div>
          {(ceremonia.urlMapaDirecto || ceremonia.urlMapa) && (
            <a href={ceremonia.urlMapaDirecto || ceremonia.urlMapa} target="_blank" rel="noopener noreferrer" class="ubc-btn">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Abrir en Maps
            </a>
          )}
        </div>
      </div>
    )}

    {recepcion && (
      <div class="ubc-item">
        <div class="ubc-icon-col">
          <div class="ubc-icon-circle ubc-icon--rec">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="18" height="18">
              <path d="M20 9V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10c0 1.1.9 2 2 2h8"/>
              <path d="M14 19l4-4 4 4"/><path d="M18 15v6"/>
            </svg>
          </div>
        </div>
        <div class="ubc-detail">
          <div class="ubc-detail-top">
            <div>
              <span class="ubc-label ubc-label--rec">Recepción</span>
              <h3 class="ubc-lugar">{recepcion.lugar}</h3>
              <p class="ubc-dir">{recepcion.direccion}</p>
            </div>
            <div class="ubc-hora-box ubc-hora-box--rec">
              <span class="ubc-hora">{recepcion.hora}</span>
            </div>
          </div>
          {(recepcion.urlMapaDirecto || recepcion.urlMapa) && (
            <a href={recepcion.urlMapaDirecto || recepcion.urlMapa} target="_blank" rel="noopener noreferrer" class="ubc-btn ubc-btn--rec">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Abrir en Maps
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .ubc-wrap {
    background: #fff;
    padding: 2rem 1.25rem 1.5rem;
    font-family: 'DM Sans', sans-serif;
    border-top: 3px solid #f3f4f6;
  }
  .ubc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f3f4f6;
  }
  .ubc-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }
  .ubc-list {
    display: flex;
    flex-direction: column;
  }
  .ubc-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .ubc-icon-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .ubc-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ubc-icon--cer {
    background: linear-gradient(135deg, #6366f1, #818cf8);
    box-shadow: 0 4px 12px rgba(99,102,241,0.3);
  }
  .ubc-icon--rec {
    background: linear-gradient(135deg, #f43f5e, #fb7185);
    box-shadow: 0 4px 12px rgba(244,63,94,0.3);
  }
  .ubc-connector {
    width: 2px;
    flex: 1;
    min-height: 20px;
    background: linear-gradient(to bottom, #e0e7ff, #fce7f3);
    margin: 6px 0;
  }
  .ubc-detail {
    flex: 1;
    min-width: 0;
    padding-bottom: 1.5rem;
  }
  .ubc-detail-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ubc-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6366f1;
    margin-bottom: 0.2rem;
  }
  .ubc-label--rec {
    color: #f43f5e;
  }
  .ubc-lugar {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }
  .ubc-dir {
    font-size: 0.75rem;
    color: #9ca3af;
    margin: 0;
    line-height: 1.4;
  }
  .ubc-hora-box {
    background: #eef2ff;
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
    flex-shrink: 0;
  }
  .ubc-hora-box--rec {
    background: #fff1f2;
  }
  .ubc-hora {
    font-size: 0.8rem;
    font-weight: 700;
    color: #6366f1;
    white-space: nowrap;
  }
  .ubc-hora-box--rec .ubc-hora {
    color: #f43f5e;
  }
  .ubc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1.5px solid #e0e7ff;
    background: #f8f9ff;
    color: #6366f1;
    border-radius: 8px;
    padding: 0.45rem 1rem;
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .ubc-btn--rec {
    border-color: #ffe0e6;
    background: #fff8f9;
    color: #f43f5e;
  }
  .ubc-btn:hover {
    background: #eef2ff;
  }
  .ubc-btn--rec:hover {
    background: #fff1f2;
  }
</style>
