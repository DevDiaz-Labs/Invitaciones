---
// src/components/ubicacion/UbicacionVertical.astro
interface Evento {
  titulo?: string;
  lugar: string;
  direccion: string;
  hora: string;
  fecha?: string;
  urlMapa: string;
  urlMapaDirecto?: string;
}

interface Props {
  data: {
    ceremonia?: Evento;
    recepcion?: Evento;
  };
  bgImageCeremonia?: string;
  bgImageRecepcion?: string;
}

const { data, bgImageCeremonia, bgImageRecepcion } = Astro.props;
const { ceremonia, recepcion } = data || {};
---

<div class="w-full flex flex-col">
  <!-- Ceremonia -->
  {ceremonia && (
    <section class="pt-24" style="background-color: #ffecfb;">
      <div class="max-w-3xl mx-auto text-center px-6 mb-16 observe-me fade-up">
        <h3 class="font-titulo text-4xl md:text-5xl mb-6 text-[var(--gold,rgb(183,110,121))]">
          {ceremonia.titulo || "Ceremonia Religiosa"}
        </h3>
        <p class="text-lg md:text-xl tracking-[0.2em] mb-2 uppercase text-[var(--dark-text,#1b1c17)] font-light">
          {ceremonia.lugar}
        </p>
        <p class="text-[var(--dark-text,#1b1c17)]/60 italic text-base md:text-lg">
          {ceremonia.direccion}<br />{ceremonia.hora}
        </p>
        {(ceremonia.urlMapaDirecto || ceremonia.urlMapa) && (
          <a 
            href={ceremonia.urlMapaDirecto || ceremonia.urlMapa} 
            target="_blank" 
            class="inline-flex items-center gap-2 mt-6 px-6 py-3 bg-white border border-[var(--gold,rgb(183,110,121))]/30 rounded-full text-[var(--gold,rgb(183,110,121))] hover:bg-[var(--gold,rgb(183,110,121))] hover:text-white transition-all text-sm uppercase tracking-widest font-bold shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"/></svg>
            Ver en Google Maps
          </a>
        )}
      </div>
      <div class="full-map-container observe-me fade-in-slow">
        <iframe
          src={ceremonia.urlMapa}
          class="w-full h-full min-h-[400px] grayscale-[30%] sepia-[15%] contrast-[110%]"
          style="border:0; min-height: 400px;"
          allowfullscreen=""
          loading="lazy"
        >
        </iframe>
      </div>
    </section>
  )}

  <!-- Recepción -->
  {recepcion && (
    <section class="pt-24" style="background-color: #ffecfb;">
      <div class="max-w-3xl mx-auto text-center px-6 mb-16 observe-me fade-up">
        <h3 class="font-titulo text-4xl md:text-5xl mb-6 text-[var(--gold,rgb(183,110,121))]">
          {recepcion.titulo || "Recepción"}
        </h3>
        <p class="text-lg md:text-xl tracking-[0.2em] mb-2 uppercase text-[var(--dark-text,#1b1c17)] font-light">
          {recepcion.lugar}
        </p>
        <p class="text-[var(--dark-text,#1b1c17)]/60 italic text-base md:text-lg">
          {recepcion.direccion}<br />{recepcion.hora}
        </p>
        {(recepcion.urlMapaDirecto || recepcion.urlMapa) && (
          <a 
            href={recepcion.urlMapaDirecto || recepcion.urlMapa} 
            target="_blank" 
            class="inline-flex items-center gap-2 mt-6 px-6 py-3 bg-white border border-[var(--gold,rgb(183,110,121))]/30 rounded-full text-[var(--gold,rgb(183,110,121))] hover:bg-[var(--gold,rgb(183,110,121))] hover:text-white transition-all text-sm uppercase tracking-widest font-bold shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"/></svg>
            Ver en Google Maps
          </a>
        )}
      </div>
      <div class="full-map-container observe-me fade-in-slow">
        <iframe
          src={recepcion.urlMapa}
          class="w-full h-full min-h-[400px] grayscale-[30%] sepia-[15%] contrast-[110%]"
          style="border:0; min-height: 400px;"
          allowfullscreen=""
          loading="lazy"
        >
        </iframe>
      </div>
    </section>
  )}
</div>

<style>
  .full-map-container {
    width: 100%;
    height: 400px;
  }
</style>
