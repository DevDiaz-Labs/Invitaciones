---
interface Evento {
  titulo?: string;
  lugar: string;
  direccion: string;
  hora: string;
  urlMapa: string;
  iframeMapa?: string;
}
interface Props {
  data: { ceremonia?: Evento; recepcion?: Evento; };
}
const { data } = Astro.props;
const { ceremonia, recepcion } = data || {};
---

<section class="py-24 px-6 bg-white w-full">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl tracking-[0.2em] uppercase mb-16 text-center text-black font-light">Ubicaciones</h2>
    
    <div class="space-y-24">
      {ceremonia && (
        <div class="flex flex-col items-center text-center">
          <span class="text-sm uppercase tracking-widest text-gray-400 mb-2">01</span>
          <h3 class="text-xl uppercase tracking-widest text-black mb-4">{ceremonia.titulo || "Ceremonia"}</h3>
          <p class="text-black font-light mb-4">{ceremonia.hora}</p>
          <div class="w-10 h-px bg-black mb-4"></div>
          <p class="text-black mb-1">{ceremonia.lugar}</p>
          <p class="text-gray-500 font-light text-sm mb-8 max-w-sm">{ceremonia.direccion}</p>
          
          {ceremonia.iframeMapa && (
            <div class="w-full max-w-lg aspect-video mb-8 grayscale hover:grayscale-0 transition-all duration-700">
              <iframe src={ceremonia.iframeMapa} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
          )}
          
          <a href={ceremonia.urlMapaDirecto || ceremonia.urlMapa} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-[0.1em] text-black hover:text-gray-400 transition-colors border-b border-black hover:border-gray-400 pb-1">
            Visualizar Mapa
          </a>
        </div>
      )}

      {recepcion && (
        <div class="flex flex-col items-center text-center">
          <span class="text-sm uppercase tracking-widest text-gray-400 mb-2">02</span>
          <h3 class="text-xl uppercase tracking-widest text-black mb-4">{recepcion.titulo || "Recepción"}</h3>
          <p class="text-black font-light mb-4">{recepcion.hora}</p>
          <div class="w-10 h-px bg-black mb-4"></div>
          <p class="text-black mb-1">{recepcion.lugar}</p>
          <p class="text-gray-500 font-light text-sm mb-8 max-w-sm">{recepcion.direccion}</p>
          
          {recepcion.iframeMapa && (
            <div class="w-full max-w-lg aspect-video mb-8 grayscale hover:grayscale-0 transition-all duration-700">
              <iframe src={recepcion.iframeMapa} width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
          )}
          
          <a href={recepcion.urlMapaDirecto || recepcion.urlMapa} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-[0.1em] text-black hover:text-gray-400 transition-colors border-b border-black hover:border-gray-400 pb-1">
            Visualizar Mapa
          </a>
        </div>
      )}
    </div>
  </div>
</section>
