---
// src/components/ubicacion/UbicacionNatural.astro
interface Evento {
  titulo?: string;
  lugar?: string;
  direccion?: string;
  hora?: string;
  urlMapa?: string;
  urlMapaDirecto?: string;
  iframeMapa?: string;
}

interface Props {
  data: {
    ceremonia?: Evento;
    recepcion?: Evento;
  };
}

const { data } = Astro.props;
const { ceremonia, recepcion } = data || {};
---

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet" />

<section class="ubn-nat-wrap">
  <!-- Decorative leaves top -->
  <div class="ubn-nat-leaves-top" aria-hidden="true">
    <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 70 Q30 10 80 20 Q50 60 10 70Z" fill="#7a9a5a" opacity="0.25"/>
      <path d="M5 75 Q20 30 60 40" stroke="#5a7a3a" stroke-width="1" opacity="0.4"/>
      <path d="M100 60 Q90 10 40 30 Q70 55 100 60Z" fill="#9ab070" opacity="0.18"/>
      <path d="M105 65 Q95 20 55 35" stroke="#5a7a3a" stroke-width="1" opacity="0.35"/>
    </svg>
  </div>

  <div class="ubn-nat-header">
    <div class="ubn-nat-icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="#5a7a3a" stroke-width="1.5" width="28" height="28">
        <path d="M17 8C8 10 5.9 16.17 3.82 19.64"/>
        <path d="M18.28 11.39C17.1 8.17 15.37 5.93 12 4"/>
        <path d="M3 21c3.93-1.83 7.63-4.33 11-8"/>
      </svg>
    </div>
    <h2 class="ubn-nat-title">El Encuentro</h2>
    <p class="ubn-nat-sub">Un día en armonía con la naturaleza y el amor</p>
    <div class="ubn-nat-ornament">
      <svg viewBox="0 0 200 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="160">
        <path d="M0 10 Q25 2 50 10 Q75 18 100 10 Q125 2 150 10 Q175 18 200 10" stroke="#7a9a5a" stroke-width="1" fill="none" opacity="0.6"/>
        <circle cx="100" cy="10" r="3" fill="#7a9a5a" opacity="0.5"/>
      </svg>
    </div>
  </div>

  <div class="ubn-nat-grid">
    {ceremonia && (
      <div class="ubn-nat-card">
        <div class="ubn-nat-card-top">
          <div class="ubn-nat-tag">Ceremonia</div>
          <div class="ubn-nat-card-leaf" aria-hidden="true">
            <svg viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 45 Q15 5 38 8 Q20 35 5 45Z" fill="#7a9a5a" opacity="0.3"/>
              <path d="M6 44 Q16 8 37 10" stroke="#5a7a3a" stroke-width="0.8" opacity="0.5"/>
            </svg>
          </div>
        </div>
        <h3 class="ubn-nat-lugar">{ceremonia.lugar}</h3>
        <div class="ubn-nat-meta">
          <span class="ubn-nat-hora">
            <svg viewBox="0 0 24 24" fill="none" stroke="#5a7a3a" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {ceremonia.hora}
          </span>
        </div>
        <p class="ubn-nat-dir">{ceremonia.direccion}</p>
        {(ceremonia.iframeMapa || ceremonia.urlMapa) && (
          <div class="ubn-nat-map">
            <iframe
              src={ceremonia.iframeMapa || ceremonia.urlMapa}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        )}
        {(ceremonia.urlMapaDirecto || ceremonia.urlMapa) && (
          <a href={ceremonia.urlMapaDirecto || ceremonia.urlMapa} target="_blank" rel="noopener noreferrer" class="ubn-nat-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Cómo llegar
          </a>
        )}
      </div>
    )}

    {recepcion && (
      <div class="ubn-nat-card ubn-nat-card--alt">
        <div class="ubn-nat-card-top">
          <div class="ubn-nat-tag ubn-nat-tag--alt">Recepción</div>
          <div class="ubn-nat-card-leaf" aria-hidden="true">
            <svg viewBox="0 0 40 50" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M35 45 Q25 5 2 8 Q20 35 35 45Z" fill="#9ab070" opacity="0.3"/>
              <path d="M34 44 Q24 8 3 10" stroke="#5a7a3a" stroke-width="0.8" opacity="0.5"/>
            </svg>
          </div>
        </div>
        <h3 class="ubn-nat-lugar">{recepcion.lugar}</h3>
        <div class="ubn-nat-meta">
          <span class="ubn-nat-hora">
            <svg viewBox="0 0 24 24" fill="none" stroke="#5a7a3a" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {recepcion.hora}
          </span>
        </div>
        <p class="ubn-nat-dir">{recepcion.direccion}</p>
        {(recepcion.iframeMapa || recepcion.urlMapa) && (
          <div class="ubn-nat-map">
            <iframe
              src={recepcion.iframeMapa || recepcion.urlMapa}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        )}
        {(recepcion.urlMapaDirecto || recepcion.urlMapa) && (
          <a href={recepcion.urlMapaDirecto || recepcion.urlMapa} target="_blank" rel="noopener noreferrer" class="ubn-nat-btn ubn-nat-btn--alt">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Cómo llegar
          </a>
        )}
      </div>
    )}
  </div>

  <!-- Bottom leaves -->
  <div class="ubn-nat-leaves-bottom" aria-hidden="true">
    <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 10 Q30 70 80 60 Q50 25 10 10Z" fill="#7a9a5a" opacity="0.2"/>
      <path d="M100 15 Q90 70 40 55 Q70 30 100 15Z" fill="#9ab070" opacity="0.15"/>
    </svg>
  </div>
</section>

<style>
  .ubn-nat-wrap {
    background: linear-gradient(160deg, #f4f7ef 0%, #eaf0e0 60%, #f4f7ef 100%);
    padding: 2.5rem 1.25rem;
    font-family: 'Source Sans 3', sans-serif;
    position: relative;
    overflow: hidden;
  }
  .ubn-nat-leaves-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
  }
  .ubn-nat-leaves-top svg {
    width: 100%;
    height: 80px;
  }
  .ubn-nat-leaves-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    transform: scaleX(-1);
  }
  .ubn-nat-leaves-bottom svg {
    width: 100%;
    height: 70px;
  }
  .ubn-nat-header {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }
  .ubn-nat-icon-wrap {
    width: 52px;
    height: 52px;
    background: rgba(122,154,90,0.12);
    border: 1.5px solid rgba(122,154,90,0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
  }
  .ubn-nat-title {
    font-family: 'Lora', serif;
    font-size: 2.1rem;
    font-weight: 400;
    color: #3d5c28;
    margin: 0 0 0.4rem;
  }
  .ubn-nat-sub {
    font-size: 0.82rem;
    color: #7a9a5a;
    font-style: italic;
    margin: 0 0 0.75rem;
  }
  .ubn-nat-ornament {
    display: flex;
    justify-content: center;
  }
  .ubn-nat-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
  }
  .ubn-nat-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    border: 1.5px solid rgba(122,154,90,0.25);
    box-shadow: 0 4px 20px rgba(90,122,58,0.1);
    position: relative;
    overflow: hidden;
  }
  .ubn-nat-card--alt {
    background: linear-gradient(135deg, #f9fdf4 0%, #fff 100%);
    border-color: rgba(154,176,112,0.3);
  }
  .ubn-nat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }
  .ubn-nat-card-leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 60px;
    height: 75px;
    opacity: 0.8;
  }
  .ubn-nat-tag {
    display: inline-block;
    background: rgba(122,154,90,0.15);
    color: #3d5c28;
    border: 1px solid rgba(122,154,90,0.35);
    border-radius: 20px;
    padding: 0.2rem 0.75rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .ubn-nat-tag--alt {
    background: rgba(154,176,112,0.15);
    color: #4a6e35;
    border-color: rgba(154,176,112,0.35);
  }
  .ubn-nat-lugar {
    font-family: 'Lora', serif;
    font-size: 1.2rem;
    color: #3d5c28;
    margin: 0 0 0.4rem;
  }
  .ubn-nat-meta {
    margin-bottom: 0.4rem;
  }
  .ubn-nat-hora {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: #7a9a5a;
    font-weight: 600;
  }
  .ubn-nat-dir {
    font-size: 0.8rem;
    color: #8a9e78;
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .ubn-nat-map {
    width: 100%;
    height: 175px;
    border-radius: 10px;
    overflow: hidden;
    border: 1.5px solid rgba(122,154,90,0.2);
    margin-bottom: 0.85rem;
  }
  .ubn-nat-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #5a7a3a;
    color: #fff;
    border-radius: 30px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ubn-nat-btn--alt {
    background: #7a9a5a;
  }
  .ubn-nat-btn:hover {
    background: #3d5c28;
  }
</style>
