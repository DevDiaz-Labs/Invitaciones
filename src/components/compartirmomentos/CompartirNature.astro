---
interface Props {
  data: {
    mostrar: boolean;
    titulo?: string;
    frase?: string;
    urlBoton?: string;
    textoBoton?: string;
    hashtag?: string;
  };
}

const { data } = Astro.props;
---

{data.mostrar && (
  <section class="py-24 px-6 bg-[#f0f4f1] relative overflow-hidden">
    <!-- Leaf decorations -->
    <svg class="absolute top-0 left-0 w-32 h-32 text-[#d1e0d7] transform -translate-x-10 -translate-y-10" viewBox="0 0 100 100" fill="currentColor">
      <path d="M50 0C50 0 20 20 20 50C20 80 50 100 50 100C50 100 80 80 80 50C80 20 50 0 50 0Z" />
    </svg>
    <svg class="absolute bottom-0 right-0 w-40 h-40 text-[#d1e0d7] transform translate-x-10 translate-y-10 rotate-180" viewBox="0 0 100 100" fill="currentColor">
      <path d="M50 0C50 0 20 20 20 50C20 80 50 100 50 100C50 100 80 80 80 50C80 20 50 0 50 0Z" />
    </svg>

    <div class="relative z-10 max-w-md mx-auto bg-white/80 backdrop-blur-sm p-10 rounded-2xl shadow-sm border border-[#e2ece6] text-center">
      <div class="w-16 h-16 mx-auto bg-[#84a98c] rounded-full flex items-center justify-center mb-6 shadow-md text-white">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>

      <h2 class="text-3xl font-['Playfair_Display'] text-[#2f3e46] mb-4">
        {data.titulo || "Nuestros Recuerdos"}
      </h2>
      
      <p class="text-[#52796f] font-light text-sm mb-8 leading-relaxed" set:html={data.frase || "Ayúdanos a capturar los mejores momentos"}>
      </p>

      <a 
        href={data.urlBoton || "#"} 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block w-full bg-[#52796f] text-white px-6 py-3 rounded text-sm tracking-wider uppercase hover:bg-[#354f52] transition-colors"
      >
        {data.textoBoton || "Subir Fotos"}
      </a>
    </div>
  </section>
)}
