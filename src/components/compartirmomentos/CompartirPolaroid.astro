---
interface Props {
  data: {
    mostrar: boolean;
    titulo?: string;
    frase?: string;
    urlBoton?: string;
    textoBoton?: string;
    hashtag?: string;
  };
}

const { data } = Astro.props;
---

{data.mostrar && (
  <section class="py-24 px-4 bg-gray-200 flex justify-center items-center">
    <div class="w-full max-w-sm bg-white p-4 pb-12 shadow-[0_20px_50px_rgba(0,0,0,0.2)] transform rotate-2 hover:rotate-0 transition-transform duration-500">
      <div class="w-full aspect-square bg-gray-900 mb-6 flex items-center justify-center relative overflow-hidden group">
        <svg class="w-16 h-16 text-gray-700 opacity-50 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      
      <h2 class="text-3xl font-['Dancing_Script'] text-center text-gray-800 mb-2">
        {data.titulo || "Nuestra Galería"}
      </h2>
      <p class="text-center font-['Dancing_Script'] text-xl text-gray-600 mb-6" set:html={data.frase || "Añade tu foto aquí"}>
      </p>

      <div class="text-center">
        <a 
          href={data.urlBoton || "#"} 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border-2 border-gray-800 text-gray-800 px-6 py-2 font-['Montserrat'] text-xs font-bold uppercase tracking-widest hover:bg-gray-800 hover:text-white transition-colors"
        >
          {data.textoBoton || "Subir"}
        </a>
      </div>
    </div>
  </section>
)}
