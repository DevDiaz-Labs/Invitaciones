---
// src/components/noninos/NoninosXV.astro
interface Props {
  titulo?: string;
  mensaje?: string;
}

const { 
  titulo = "NO NIÑOS", 
  mensaje = "Adoramos a tus pequeños pero este evento está destinado solo para adolescentes y adultos. Muchas gracias por tu comprensión." 
} = Astro.props;
---

<div class="noninos-xv max-w-md mx-auto bg-[var(--gold,#c5a059)]/10 p-6 md:p-8 rounded-2xl border border-[var(--gold,#c5a059)]/40 text-center shadow-sm">
  <h4 class="font-bold text-[var(--gold,#c5a059)] text-xl md:text-2xl tracking-[0.2em] mb-3 uppercase font-serif">
    {titulo}
  </h4>
  <p class="text-stone-700 text-sm md:text-base leading-relaxed italic font-light">
    {mensaje}
  </p>
</div>
