---
// src/components/noninos/NoninosMinimalista.astro
interface Props {
  titulo?: string;
  mensaje?: string;
}

const { 
  titulo = "Solo Adultos", 
  mensaje = "Respetuosamente te informamos que nuestro evento se celebrará en un ambiente de adultos. Disfruta de la noche con nosotros." 
} = Astro.props;
---

<div class="noninos-minimalista max-w-md mx-auto p-6 bg-stone-50 border border-stone-200/80 rounded-xl text-center">
  <h4 class="text-xs font-semibold uppercase tracking-[0.25em] text-stone-700 mb-2 font-mono">
    {titulo}
  </h4>
  <p class="text-stone-500 font-light text-xs md:text-sm leading-relaxed max-w-xs mx-auto">
    {mensaje}
  </p>
</div>
