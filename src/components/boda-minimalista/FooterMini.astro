---
// FooterMini.astro
const { data } = Astro.props;

const iniciales = data?.iniciales || "S & M";
const fecha = data?.fechaFooter || "24 . 10 . 2026";
---

<footer class="py-12 text-center border-t border-stone-200 fade-up">
  <h2 class="text-2xl font-serif text-stone-400 mb-2">{iniciales}</h2>
  <p class="text-xs uppercase tracking-widest text-stone-400">{fecha}</p>
</footer>
