---
// CapturaMini.astro
const { data } = Astro.props;
---

<section class="py-24 px-4 bg-stone-800 text-stone-50 text-center relative overflow-hidden fade-up">
  <div class="max-w-2xl mx-auto relative z-10">
    <svg class="mx-auto mb-6 text-stone-400" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
      <circle cx="12" cy="13" r="3"></circle>
    </svg>
    <h2 class="text-3xl md:text-4xl font-serif mb-4">Captura el Momento</h2>
    <p class="text-stone-300 font-light mb-10">
      Ayúdanos a documentar nuestro día especial. Si tomas fotos durante la boda, compártelas con nosotros aquí.
    </p>

    <div id="upload-container">
      <button 
        id="btn-upload"
        class="inline-flex items-center gap-2 bg-white text-stone-900 px-8 py-4 rounded hover:bg-stone-200 transition uppercase tracking-wider text-sm font-medium"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        Subir Fotografías
      </button>

      <div id="status-uploading" class="hidden inline-flex items-center gap-2 bg-stone-700 text-stone-300 px-8 py-4 rounded uppercase tracking-wider text-sm">
        <div class="w-4 h-4 border-2 border-stone-300 border-t-transparent rounded-full animate-spin"></div>
        Procesando...
      </div>

      <div id="status-success" class="hidden inline-flex items-center gap-2 bg-green-900/50 text-green-200 px-8 py-4 rounded border border-green-800 uppercase tracking-wider text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        ¡Gracias por compartir!
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnUpload = document.getElementById('btn-upload');
    const statusUploading = document.getElementById('status-uploading');
    const statusSuccess = document.getElementById('status-success');

    if(btnUpload && statusUploading && statusSuccess) {
      btnUpload.addEventListener('click', () => {
        btnUpload.classList.add('hidden');
        statusUploading.classList.remove('hidden');

        setTimeout(() => {
          statusUploading.classList.add('hidden');
          statusSuccess.classList.remove('hidden');
        }, 2000);
      });
    }
  });
</script>
