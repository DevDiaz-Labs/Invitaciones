---
// RSVPMini.astro
const { data } = Astro.props;
---

<section class="py-24 px-4 bg-[#FAFAFA] fade-up">
  <div class="max-w-xl mx-auto bg-white p-8 md:p-12 shadow-sm border border-stone-100 rounded-xl">
    <h2 class="text-3xl font-serif mb-2 text-center text-stone-800">Confirmar Asistencia</h2>
    <p class="text-center text-stone-500 font-light mb-8 text-sm">Por favor, confírmanos antes del 1 de Septiembre.</p>
    
    {data?.noNinos && (
      <div class="mb-8 p-4 bg-stone-100/50 border border-stone-200 rounded text-center">
        <h4 class="text-sm font-medium uppercase tracking-widest text-stone-700 mb-2">Solo Adultos</h4>
        <p class="text-sm text-stone-500 font-light">
          {data?.mensajeNoNinos || "Respetuosamente te informamos que nuestra recepción será únicamente para adultos. Disfruta la noche con nosotros."}
        </p>
      </div>
    )}

    <div id="rsvp-success" class="hidden text-center py-12">
      <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="text-stone-600" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3 class="text-2xl font-serif mb-2">¡Gracias!</h3>
      <p class="text-stone-500 font-light">Hemos recibido tu confirmación.</p>
    </div>

    <form id="rsvp-form" class="space-y-6">
      <div>
        <label class="block text-xs uppercase tracking-widest text-stone-500 mb-2">Nombre y Apellido</label>
        <input 
          type="text" 
          required
          class="w-full border-b border-stone-300 bg-transparent pb-2 focus:outline-none focus:border-stone-800 transition-colors placeholder:text-stone-300"
          placeholder="Ej. Familia Pérez"
        />
      </div>

      <div>
        <label class="block text-xs uppercase tracking-widest text-stone-500 mb-2">¿Asistirás?</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="attending" required class="accent-stone-800" checked />
            <span class="font-light">Sí, ahí estaré</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="attending" required class="accent-stone-800" />
            <span class="font-light">Lo siento, no podré</span>
          </label>
        </div>
      </div>

      <div class={data?.noNinos ? "grid grid-cols-1 gap-4" : "grid grid-cols-2 gap-4"}>
        <div>
          <label class="block text-xs uppercase tracking-widest text-stone-500 mb-2">Adultos</label>
          <select class="w-full border-b border-stone-300 bg-transparent pb-2 focus:outline-none focus:border-stone-800 font-light">
            <option>1</option>
            <option>2</option>
            <option>3</option>
            <option>4</option>
          </select>
        </div>
        {!data?.noNinos && (
          <div>
            <label class="block text-xs uppercase tracking-widest text-stone-500 mb-2">Niños</label>
            <select class="w-full border-b border-stone-300 bg-transparent pb-2 focus:outline-none focus:border-stone-800 font-light">
              <option>0</option>
              <option>1</option>
              <option>2</option>
            </select>
          </div>
        )}
      </div>

      <div>
        <label class="block text-xs uppercase tracking-widest text-stone-500 mb-2">Restricciones alimentarias (Opcional)</label>
        <input 
          type="text" 
          class="w-full border-b border-stone-300 bg-transparent pb-2 focus:outline-none focus:border-stone-800 transition-colors font-light placeholder:text-stone-300"
          placeholder="Alergias, menú vegetariano, etc."
        />
      </div>

      <button 
        id="btn-submit-rsvp"
        type="submit" 
        class="w-full bg-stone-800 text-white py-4 mt-4 uppercase tracking-widest text-sm hover:bg-stone-900 transition-colors disabled:opacity-50"
      >
        Confirmar
      </button>
    </form>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('rsvp-form');
    const successMsg = document.getElementById('rsvp-success');
    const btnSubmit = document.getElementById('btn-submit-rsvp') as HTMLButtonElement;

    if(form && successMsg && btnSubmit) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        btnSubmit.disabled = true;
        btnSubmit.innerText = 'Enviando...';

        setTimeout(() => {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
        }, 1500);
      });
    }
  });
</script>
