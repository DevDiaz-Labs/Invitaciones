---
// src/components/itinerario/ItinerarioCircularSteps.astro
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---

<section class="py-20 bg-[#FAF6F0] px-6 relative overflow-hidden font-sans">
  <div class="max-w-md mx-auto relative z-10">
    <h2 class="text-3xl font-serif text-amber-900 text-center mb-16 italic tracking-wide">Cronograma del Día</h2>
    
    <div class="relative min-h-[500px]">
      <!-- SVG path in background for S-curve (will display on mobile screen sizes well) -->
      <div class="absolute inset-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-20">
        <svg class="w-full h-full stroke-amber-800" fill="none" stroke-width="3" stroke-dasharray="8 8" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M 50 0 Q 85 25 50 50 T 50 100" />
        </svg>
      </div>

      <div class="space-y-16">
        {itinerary.map((item, idx) => {
          const isEven = idx % 2 === 0;
          return (
            <div class={`relative flex items-center justify-between w-full ${isEven ? 'flex-row' : 'flex-row-reverse'}`}>
              <!-- Left/Right Card -->
              <div class="w-[45%]">
                <div class="bg-white/80 backdrop-blur-sm p-4 rounded-2xl shadow-sm border border-amber-100 hover:shadow-md transition-shadow duration-300">
                  <span class="text-xs font-mono font-semibold tracking-wider text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full">{item.time}</span>
                  <h3 class="text-gray-800 font-serif font-bold text-sm mt-2">{item.event}</h3>
                  <p class="text-gray-500 text-xs mt-1 leading-relaxed">{item.desc}</p>
                </div>
              </div>
              
              <!-- Center step bubble -->
              <div class="absolute left-1/2 -translate-x-1/2 w-12 h-12 rounded-full bg-amber-800 border-4 border-amber-100 text-amber-50 flex items-center justify-center font-serif italic font-bold shadow-lg z-10 hover:scale-110 transition-transform duration-300">
                {idx + 1}
              </div>
              
              <!-- Placeholder for visual balance -->
              <div class="w-[45%]"></div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
