---
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---
<section class="py-24 bg-rose-50 px-4">
  <div class="max-w-md mx-auto">
    <h2 class="text-4xl font-['Dancing_Script'] text-rose-800 text-center mb-16">Horarios</h2>
    
    <div class="relative">
      <div class="absolute left-1/2 -translate-x-1/2 h-full w-0.5 bg-rose-200"></div>
      <div class="space-y-12">
        {itinerary.map((item, idx) => (
          <div class={`relative flex items-center justify-between w-full ${idx % 2 === 0 ? 'flex-row-reverse' : ''}`}>
            <div class="w-5/12"></div>
            <div class="absolute left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-white border-4 border-rose-300 flex items-center justify-center z-10 shadow-md">
              <div class="w-2 h-2 bg-rose-600 rounded-full"></div>
            </div>
            <div class={`w-5/12 ${idx % 2 === 0 ? 'text-left' : 'text-right'}`}>
              <div class="bg-white p-4 rounded-xl shadow-sm border border-rose-100">
                <div class="text-rose-600 font-bold mb-1">{item.time}</div>
                <h3 class="text-gray-800 font-medium">{item.event}</h3>
                <p class="text-gray-500 text-xs mt-1">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
