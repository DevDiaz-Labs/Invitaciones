---
// src/components/itinerario/ItinerarioHorizontalScroll.astro
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---

<section class="py-20 bg-rose-50/30 px-6 font-sans overflow-hidden">
  <div class="max-w-md mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-serif font-bold text-rose-950">El Cronograma</h2>
      <div class="flex items-center gap-1 text-[10px] text-rose-700/60 uppercase font-mono tracking-widest animate-pulse">
        <span>Desliza</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
    
    <!-- Horizontal snapping row -->
    <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 scroll-smooth scrollbar-thin scrollbar-thumb-rose-200">
      {itinerary.map((item, idx) => (
        <div class="w-[85%] shrink-0 snap-center">
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-rose-100 h-44 flex flex-col justify-between hover:shadow-md transition-shadow duration-300 relative overflow-hidden">
            <!-- Decorative circle overlay -->
            <div class="absolute -right-4 -top-4 w-20 h-20 bg-rose-100/30 rounded-full"></div>
            
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold tracking-widest text-rose-600 bg-rose-50 border border-rose-100 px-3 py-1 rounded-full">
                {item.time}
              </span>
              <span class="text-[10px] font-mono text-gray-400 font-bold">
                {idx + 1} / {itinerary.length}
              </span>
            </div>
            
            <div class="mt-4">
              <h3 class="text-base font-serif font-bold text-gray-800 tracking-wide">
                {item.event}
              </h3>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2">
                {item.desc}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
