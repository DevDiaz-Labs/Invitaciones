---
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---
<section class="py-20 px-6 bg-slate-900 text-slate-100">
  <div class="max-w-md mx-auto">
    <h2 class="text-4xl font-bold tracking-tighter mb-12 text-center text-indigo-400">Schedule</h2>
    <div class="relative border-l border-indigo-500/30 pl-6 space-y-10">
      {itinerary.map((item, idx) => (
        <div class="relative">
          <div class="absolute -left-[33px] top-1 w-4 h-4 bg-indigo-500 rounded-full shadow-[0_0_15px_rgba(99,102,241,0.6)] border-4 border-slate-900"></div>
          <div class="bg-slate-800/50 backdrop-blur-sm p-5 rounded-2xl border border-slate-700/50 hover:bg-slate-800 transition-colors">
            <span class="inline-block px-3 py-1 bg-indigo-500/20 text-indigo-300 text-xs font-mono rounded-full mb-3">{item.time}</span>
            <h3 class="text-xl font-semibold mb-1">{item.event}</h3>
            <p class="text-slate-400 text-sm">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
