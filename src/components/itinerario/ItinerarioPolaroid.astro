---
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---
<section class="py-20 px-6 bg-orange-50 bg-[url('https://www.transparenttextures.com/patterns/cream-paper.png')]">
  <div class="max-w-md mx-auto">
    <h2 class="text-3xl font-['Montserrat'] font-bold text-center text-stone-700 mb-10 tracking-widest uppercase">The Plan</h2>
    
    <div class="flex flex-wrap justify-center gap-6">
      {itinerary.map((item, idx) => (
        <div class={`bg-white p-4 pb-12 shadow-lg w-full max-w-[280px] transform ${idx % 2 === 0 ? 'rotate-2' : '-rotate-3'} transition-transform hover:rotate-0 hover:scale-105 hover:z-10`}>
          <div class="aspect-video bg-stone-200 mb-4 overflow-hidden border border-stone-100 flex items-center justify-center">
            <span class="text-4xl font-bold text-stone-300">{item.time}</span>
          </div>
          <h3 class="font-['Dancing_Script'] text-3xl text-stone-800 text-center">{item.event}</h3>
          <p class="text-center text-stone-500 text-sm mt-2">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
