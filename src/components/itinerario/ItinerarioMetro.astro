---
// src/components/itinerario/ItinerarioMetro.astro
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---

<section class="py-20 bg-slate-50 px-6 font-sans">
  <div class="max-w-md mx-auto">
    <h2 class="text-3xl font-serif text-slate-800 text-center mb-16 font-bold tracking-tight">Ruta de Celebración</h2>
    
    <div class="relative pl-10">
      <!-- Subway/Metro vertical trunk line -->
      <div class="absolute left-4 top-2 bottom-2 w-2.5 bg-indigo-600 rounded-full"></div>
      
      <div class="space-y-12">
        {itinerary.map((item, idx) => (
          <div class="relative group">
            <!-- Station Node -->
            <div class="absolute -left-[35px] top-1 w-7 h-7 rounded-full bg-white border-4 border-indigo-600 flex items-center justify-center shadow z-10 group-hover:scale-115 transition-transform duration-300">
              <span class="text-[9px] font-bold text-indigo-600 font-mono">{idx + 1}</span>
            </div>
            
            <!-- Event Card representing the station details -->
            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow duration-300">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono font-bold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded">
                  {item.time}
                </span>
                <span class="text-[9px] font-bold tracking-widest text-slate-400 uppercase font-mono">
                  Estación {idx + 1}
                </span>
              </div>
              <h3 class="text-sm font-bold text-slate-800 mt-2 font-sans tracking-wide">
                {item.event}
              </h3>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
