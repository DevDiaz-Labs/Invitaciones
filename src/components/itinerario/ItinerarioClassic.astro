---
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---
<section class="py-24 px-6 bg-white border-y-[12px] border-double border-gray-200">
  <div class="max-w-md mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-serif text-gray-900 mb-4 tracking-widest">PROGRAMA</h2>
      <div class="flex items-center justify-center gap-4">
        <div class="w-12 h-px bg-gray-400"></div>
        <span class="text-gray-400 text-xl">❧</span>
        <div class="w-12 h-px bg-gray-400"></div>
      </div>
    </div>
    
    <div class="space-y-10">
      {itinerary.map((item, idx) => (
        <div class="text-center">
          <h3 class="text-2xl font-serif text-gray-800 mb-1">{item.event}</h3>
          <p class="text-gray-500 italic mb-2">{item.desc}</p>
          <div class="inline-block px-4 py-1 border border-gray-300 text-gray-600 font-medium tracking-widest text-sm">
            {item.time}
          </div>
          {idx !== itinerary.length - 1 && (
            <div class="w-px h-8 bg-gray-300 mx-auto mt-8"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
