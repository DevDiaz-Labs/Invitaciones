---
const { data } = Astro.props;
const itinerary = data?.itinerario || [];
---
<section class="py-20 px-4 bg-gradient-to-br from-fuchsia-600 via-purple-600 to-indigo-700">
  <div class="max-w-md mx-auto">
    <h2 class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-pink-300 text-center mb-12 drop-shadow-sm">FIESTA</h2>
    
    <div class="flex flex-col gap-4">
      {itinerary.map((item, idx) => (
        <div class="bg-white/10 hover:bg-white/20 transition-all p-6 rounded-2xl flex items-center justify-between border-b-4 border-r-4 border-white/20 group">
          <div>
            <h3 class="text-2xl font-bold text-white group-hover:text-yellow-300 transition-colors">{item.event}</h3>
            <p class="text-indigo-200 mt-1">{item.desc}</p>
          </div>
          <div class="text-3xl font-black text-pink-300 opacity-80 rotate-[-5deg]">
            {item.time}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
