---
// src/components/dresscode/DressCodeGlitz.astro
interface Props {
  data: {
    estilo?: string;
    descripcion?: string;
    dressCode?: {
      titulo?: string;
      subtitulo?: string;
      nota?: string;
    };
  };
}
const { data } = Astro.props;

const dressCode = data?.dressCode || {
  titulo: data?.estilo || 'Cocktail Glam',
  subtitulo: data?.descripcion || 'Vestido de cóctel brillante o blazer elegante sin corbata',
  nota: '¡Saca tus mejores brillos y calzado elegante para lucir en la pista!'
};
---

<section class="py-16 px-6 bg-slate-950 text-white flex flex-col justify-center items-center relative overflow-hidden">
  <!-- Glowing light effect -->
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-80 h-80 rounded-full bg-yellow-500/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-md w-full border border-yellow-500/20 bg-slate-900/60 backdrop-blur-md p-8 rounded-3xl shadow-xl text-center relative">
    
    <!-- Sparkle icons at top -->
    <div class="flex justify-center gap-2 mb-4">
      <svg class="w-4 h-4 text-yellow-400 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z"/></svg>
      <svg class="w-6 h-6 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3 9 9 3-9 3-3 9-3-9-9-3 9-3 3-9z"/></svg>
      <svg class="w-4 h-4 text-yellow-400 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z"/></svg>
    </div>

    <h2 class="text-3xl font-bold tracking-widest bg-clip-text text-transparent bg-gradient-to-r from-yellow-200 via-yellow-400 to-amber-500 uppercase mb-2">
      {dressCode.titulo}
    </h2>
    <span class="text-2xs tracking-[0.4em] uppercase text-gray-400 block mb-6">Código de Vestir</span>

    <!-- Combined Suit & Dress Vector Illustration -->
    <div class="bg-gradient-to-b from-yellow-500/10 to-transparent p-6 rounded-2xl border border-yellow-500/10 mb-6 flex justify-center items-center gap-8">
      
      <!-- Suit -->
      <svg class="w-16 h-16 text-yellow-400/90" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 12L24 52H40L56 12L46 4H18L8 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M22 4L32 20L42 4" stroke="currentColor" stroke-width="1.5" />
        <path d="M32 20V52" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
        <circle cx="32" cy="28" r="2" fill="currentColor" />
        <circle cx="32" cy="36" r="2" fill="currentColor" />
      </svg>

      <div class="h-12 w-[1px] bg-yellow-500/20"></div>

      <!-- Elegant Dress -->
      <svg class="w-16 h-16 text-yellow-400/90" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 12C22 14 26 15 32 15C38 15 42 14 44 12L46 24H18L20 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M18 24L10 56C16 59 48 59 54 56L46 24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M32 15V58" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
        <path d="M18 24C24 26 40 26 46 24" stroke="currentColor" stroke-width="1.5" />
      </svg>

    </div>

    <p class="text-sm md:text-base font-light text-gray-300 leading-relaxed px-2">
      {dressCode.subtitulo}
    </p>

    {dressCode.nota && (
      <div class="mt-6 pt-4 border-t border-gray-800">
        <p class="text-xs text-yellow-500/70 italic">
          "{dressCode.nota}"
        </p>
      </div>
    )}

  </div>
</section>
