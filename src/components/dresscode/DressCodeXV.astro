---
// DressCode.astro
interface Props {
    data: {
        estilo?: string;
        descripcion?: string;
        colorSugerido?: string;
        dressCode?: {
            titulo?: string;
            subtitulo?: string;
            nota?: string;
        };
    };
    bgImage?: string;
    bgPos?: string;
}
const { data, bgImage, bgPos = "center" } = Astro.props;

const estilo = data?.estilo || data?.dressCode?.titulo || "Formal";
const descripcion = data?.descripcion || data?.dressCode?.subtitulo || "Se reserva el uso del color ROSA para la quinceañera";
---

<section
    class="py-32 md:py-40 px-6 text-center relative overflow-hidden flex flex-col justify-center items-center min-h-[60vh] bg-[var(--bg-cream)] dresscode-xv-card"
    style={`${bgImage ? `background-image: linear-gradient(rgba(252, 231, 243, 0.65), rgba(252, 231, 243, 0.65)), url('${bgImage}'); background-size: cover; background-position: center; background-repeat: no-repeat;` : ""}`}
>
    <div class="max-w-3xl mx-auto space-y-12 relative z-10 observe-me fade-up">
        <h3 class="font-titulo text-4xl text-[var(--gold)]">
            Código de Vestimenta
        </h3>

        <div class="observe-me fade-in-slow" style="transition-delay: 600ms;">
            <div class="flex justify-center items-center gap-6 mb-6">
                <!-- Icono de Vestido -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="56"
                    height="56"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--gold)"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="opacity-80"
                >
                    <path
                        d="M9.5 2C9.5 2 10.5 4 12 4C13.5 4 14.5 2 14.5 2L18 8L15 11L16 22H8L9 11L6 8L9.5 2Z"
                    ></path>
                    <path d="M8 11h8"></path>
                </svg>
                <!-- Icono de Traje -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="56"
                    height="56"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="var(--gold)"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="opacity-80"
                >
                    <path d="M4 8 V22 H20 V8 L16 3 H8 L4 8 Z"></path>
                    <path d="M8 3 L12 10 L16 3"></path>
                    <path d="M12 10 V22"></path>
                    <path d="M8 3 L6 7 L11 14"></path>
                    <path d="M16 3 L18 7 L13 14"></path>
                </svg>
            </div>
            <p
                class="text-2xl md:text-3xl font-serif tracking-[0.3em] uppercase text-[var(--dark-text)]"
            >
                {estilo}
            </p>
            <p
                class="text-[var(--dark-text)] font-semibold italic text-xl md:text-2xl px-4 md:px-8 mt-6"
            >
                "{descripcion}"
            </p>
            {data?.dressCode?.nota && (
                <p class="text-[var(--dark-text)] opacity-70 italic text-sm mt-4">
                    * {data.dressCode.nota}
                </p>
            )}
        </div>
    </div>
</section>

<style>
    .dresscode-xv-card {
        --gold: #b30000;
        --bg-cream: #fce7f3;
        --dark-text: #333333;
    }
</style>


