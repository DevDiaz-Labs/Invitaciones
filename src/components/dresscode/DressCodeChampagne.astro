---
// src/components/dresscode/DressCodeChampagne.astro
interface Props {
  data: {
    estilo?: string;
    descripcion?: string;
    dressCode?: {
      titulo?: string;
      subtitulo?: string;
      nota?: string;
      coloresSugeridos?: string[];
      coloresNoPermitidos?: string[];
    };
  };
}
const { data } = Astro.props;

const dressCode = data?.dressCode || {
  titulo: data?.estilo || 'Formal Coctel',
  subtitulo: data?.descripcion || 'Traje formal / Vestido de cóctel en tonos tierra o pastel',
  nota: 'Sugerimos vestir en la paleta de colores mostrada.',
  coloresSugeridos: ['#D4B996', '#E9D5C4', '#A0B49D', '#7E6B5A', '#E8C3B9'],
  coloresNoPermitidos: ['#FFFFFF', '#000000']
};
---

<section class="py-16 px-6 bg-[#fcf9f5] flex flex-col justify-center items-center">
  <div class="max-w-md w-full border-2 border-double border-[#d4af37]/60 bg-[#fffdfa] p-8 rounded-2xl shadow-lg text-center relative">
    
    <!-- Elegant hanger or scroll SVG at top -->
    <div class="flex justify-center mb-4 text-[#d4af37]">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9s2.015-9 4.5-9yM3 9h18M3 15h18" />
      </svg>
    </div>

    <h2 class="text-3xl font-serif tracking-widest text-[#8a7355] uppercase mb-1">
      {dressCode.titulo}
    </h2>
    <span class="text-3xs uppercase tracking-[0.35em] text-[#b09675] font-semibold mb-6 block">Código de Vestimenta</span>

    <!-- Modern elegant line art for suit and dress -->
    <div class="flex justify-center items-center gap-10 my-6">
      
      <!-- Elegant Blazer / Suit line art -->
      <div class="w-16 h-20 flex items-center justify-center border border-[#d4af37]/20 rounded-xl bg-white p-2">
        <svg class="w-10 h-14 text-[#8a7355]" fill="none" stroke="currentColor" viewBox="0 0 24 30" stroke-width="1">
          <path d="M2 8 C 4 8, 8 10, 12 10 C 16 10, 20 8, 22 8 L 19 28 L 5 28 Z" />
          <path d="M12 10 L 8 4 L 12 2 L 16 4 Z" />
          <path d="M12 10 V 28" />
          <circle cx="12" cy="15" r="1" fill="currentColor" />
          <circle cx="12" cy="19" r="1" fill="currentColor" />
        </svg>
      </div>

      <!-- Elegant Evening Gown line art -->
      <div class="w-16 h-20 flex items-center justify-center border border-[#d4af37]/20 rounded-xl bg-white p-2">
        <svg class="w-10 h-14 text-[#8a7355]" fill="none" stroke="currentColor" viewBox="0 0 24 30" stroke-width="1">
          <path d="M6 2 C 7 3, 9 4, 12 4 C 15 4, 17 3, 18 2 L 20 10 C 16 11, 8 11, 4 10 Z" />
          <path d="M4 10 L 1 29 C 4 30, 20 30, 23 29 L 20 10" />
          <path d="M4 10 C 7 11, 17 11, 20 10" />
          <path d="M12 10 V 29" stroke-dasharray="1 1" />
        </svg>
      </div>

    </div>

    <p class="text-sm font-light text-[#5c4f40] leading-relaxed mb-6">
      {dressCode.subtitulo}
    </p>

    <!-- Color Palettes Section -->
    {(dressCode.coloresSugeridos || dressCode.coloresNoPermitidos) && (
      <div class="mt-6 pt-4 border-t border-[#d4af37]/10 flex flex-col gap-4">
        
        {dressCode.coloresSugeridos && dressCode.coloresSugeridos.length > 0 && (
          <div class="flex flex-col items-center">
            <span class="text-3xs uppercase tracking-wider text-[#b09675] mb-2">Colores sugeridos</span>
            <div class="flex gap-2">
              {dressCode.coloresSugeridos.map((color: string) => (
                <div 
                  class="w-6 h-6 rounded-full border border-gray-200 shadow-sm"
                  style={`background-color: ${color};`}
                  title={color}
                />
              ))}
            </div>
          </div>
        )}

        {dressCode.coloresNoPermitidos && dressCode.coloresNoPermitidos.length > 0 && (
          <div class="flex flex-col items-center mt-1">
            <span class="text-3xs uppercase tracking-wider text-red-500/70 mb-2">Colores no permitidos</span>
            <div class="flex gap-2">
              {dressCode.coloresNoPermitidos.map((color: string) => (
                <div class="relative">
                  <div 
                    class="w-6 h-6 rounded-full border border-gray-200 shadow-sm opacity-60"
                    style={`background-color: ${color};`}
                  />
                  <!-- Cross overlay -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-7 h-[1px] bg-red-600 rotate-45"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    )}

    {dressCode.nota && (
      <p class="text-3xs italic text-[#8a7355]/70 mt-6">
        * {dressCode.nota}
      </p>
    )}

  </div>
</section>
