---
const { data } = Astro.props;
const dressCode = data?.dressCode || {
  titulo: 'Urbano',
  subtitulo: 'Casual Chic',
  nota: 'Estilo industrial urbano. Viste cómodo y moderno para bailar toda la noche.'
};
---
<section class="py-20 px-4 bg-gray-200 flex justify-center">
  <div class="max-w-sm w-full bg-gray-100 p-8 shadow-inner border border-gray-300 relative">
    <div class="absolute top-2 left-2 w-3 h-3 rounded-full bg-gray-400 shadow-sm border border-gray-500"></div>
    <div class="absolute top-2 right-2 w-3 h-3 rounded-full bg-gray-400 shadow-sm border border-gray-500"></div>
    <div class="absolute bottom-2 left-2 w-3 h-3 rounded-full bg-gray-400 shadow-sm border border-gray-500"></div>
    <div class="absolute bottom-2 right-2 w-3 h-3 rounded-full bg-gray-400 shadow-sm border border-gray-500"></div>

    <div class="text-center font-sans">
      <h2 class="text-4xl font-black text-gray-800 tracking-tighter uppercase mb-1">{dressCode.titulo}</h2>
      <div class="h-1 w-full bg-gray-800 mb-4"></div>
      <h3 class="text-xl font-bold text-gray-600 uppercase mb-6">{dressCode.subtitulo}</h3>
      <div class="bg-gray-800 text-gray-200 p-4 rounded-sm text-sm font-mono">
        > {dressCode.nota}
      </div>
    </div>
  </div>
</section>
