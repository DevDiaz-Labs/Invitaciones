---
// src/components/dresscode/DressCodeRosadoGlam.astro
interface Props {
  data: {
    estilo?: string;
    descripcion?: string;
    dressCode?: {
      titulo?: string;
      subtitulo?: string;
      nota?: string;
      coloresSugeridos?: string[];
      coloresNoPermitidos?: string[];
    };
  };
}
const { data } = Astro.props;

const dressCode = data?.dressCode || {
  titulo: 'Formal Glam',
  subtitulo: 'Vestimenta formal. Hombres: Traje formal / Mujeres: Vestido de cóctel o gala.',
  nota: 'Sugerimos vestir dentro de la paleta de tonos cálidos y tierras.',
  coloresSugeridos: ['#B8860B', '#C5A059', '#E0A899', '#D3B1A7', '#6E8A75'],
  coloresNoPermitidos: ['#FFFFFF', '#000000']
};
---

<section class="py-16 px-6 bg-gradient-to-br from-[#fbf5f3] via-[#f7eae6] to-[#f0ded8] text-[#3c2a25] flex flex-col justify-center items-center relative overflow-hidden">
  
  <!-- Subtle design circular elements in background -->
  <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full border border-[#c5a059]/10 pointer-events-none"></div>
  <div class="absolute -bottom-16 -left-16 w-64 h-64 rounded-full border border-[#c5a059]/10 pointer-events-none"></div>

  <div class="max-w-md w-full bg-[#fffcfb]/90 border border-[#e8d5cf] shadow-2xl p-8 rounded-3xl text-center relative backdrop-blur-sm">
    <!-- Rose gold top badge -->
    <div class="inline-block px-3 py-1 rounded-full bg-[#f5e2dc] text-[#c58d7f] text-[10px] tracking-[0.2em] uppercase font-bold mb-4">
      Elegancia & Estilo
    </div>

    <h2 class="text-3xl font-serif tracking-wider text-[#583f39] uppercase mb-1">
      {dressCode.titulo}
    </h2>
    <span class="text-3xs uppercase tracking-[0.25em] text-[#a88279] font-semibold mb-6 block">Código de Vestimenta</span>

    <!-- Elegant Divider -->
    <div class="flex justify-center items-center gap-2 mb-6">
      <div class="w-12 h-[1px] bg-[#d3b1a7]"></div>
      <svg class="w-3 h-3 text-[#c58d7f]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <div class="w-12 h-[1px] bg-[#d3b1a7]"></div>
    </div>

    <!-- Suit & Dress Illustrations -->
    <div class="flex justify-center items-center gap-10 my-8">
      
      <!-- Modern Blazer Card -->
      <div class="flex flex-col items-center flex-1">
        <div class="w-full aspect-[4/5] max-w-[110px] p-4 rounded-2xl bg-gradient-to-b from-[#fff] to-[#fbf7f6] border border-[#f0ded8] shadow-sm hover:shadow-md hover:border-[#c58d7f]/50 transition-all duration-300 flex items-center justify-center group">
          <svg class="w-16 h-20 text-[#c58d7f] group-hover:scale-105 transition-transform duration-300" viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Blazer outer outline -->
            <path d="M18 22 C 22 22, 28 25, 40 25 C 52 25, 58 22, 62 22 L 58 85 L 22 85 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.02"/>
            
            <!-- V neck inner shirt -->
            <path d="M28 22 L40 25 L52 22 L40 50 Z" fill="#ffffff" stroke="currentColor" stroke-width="1"/>
            
            <!-- Tie (corbata) -->
            <path d="M38 25 L42 25 L43 45 L40 50 L37 45 Z" fill="#0f4c3a" stroke="#0f4c3a" stroke-width="1"/>
            
            <!-- Wide Modern Lapels -->
            <path d="M18 22 L32 45 L25 52 L20 38" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.1"/>
            <path d="M62 22 L48 45 L55 52 L60 38" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.1"/>
            
            <!-- Pocket Square -->
            <path d="M22 34 H 30" stroke="currentColor" stroke-width="1.5"/>
            <path d="M24 30 L27 34 H 23 Z" fill="#0f4c3a"/>

            <!-- Buttons -->
            <circle cx="43" cy="56" r="1.5" fill="currentColor"/>
            <circle cx="43" cy="64" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <span class="text-[11px] uppercase tracking-widest text-[#583f39] font-medium mt-3 block">Hombres</span>
        <span class="text-[9px] text-[#a88279] mt-0.5">Saco & Pantalón</span>
      </div>

      <!-- Halter Mermaid Dress Card -->
      <div class="flex flex-col items-center flex-1">
        <div class="w-full aspect-[4/5] max-w-[110px] p-4 rounded-2xl bg-gradient-to-b from-[#fff] to-[#fbf7f6] border border-[#f0ded8] shadow-sm hover:shadow-md hover:border-[#c58d7f]/50 transition-all duration-300 flex items-center justify-center group">
          <svg class="w-16 h-20 text-[#c58d7f] group-hover:scale-105 transition-transform duration-300" viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Mermaid dress outline -->
            <path d="M30 14 C32 15, 48 15, 50 14 L 46 38 C 43 45, 47 62, 53 72 L 56 88 C 50 90, 30 90, 24 88 L 27 72 C 33 62, 37 45, 34 38 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.02"/>
            
            <!-- Halterneck strap curves -->
            <path d="M30 14 C32 10, 35 6, 40 6 C45 6, 48 10, 50 14" stroke="currentColor" stroke-width="1.5"/>
            
            <!-- Ruched Waist detail -->
            <path d="M33 34 C38 36, 42 36, 47 34" stroke="currentColor" stroke-width="1"/>
            <path d="M32 38 C38 40, 42 40, 48 38" stroke="currentColor" stroke-width="1"/>
            
            <!-- Dress patterns / pleats -->
            <path d="M30 75 C 33 80, 33 85, 30 89" stroke="currentColor" stroke-width="1" stroke-dasharray="1 1"/>
            <path d="M40 75 V 89" stroke="currentColor" stroke-width="1" stroke-dasharray="1 1"/>
            <path d="M50 75 C 47 80, 47 85, 50 89" stroke="currentColor" stroke-width="1" stroke-dasharray="1 1"/>
          </svg>
        </div>
        <span class="text-[11px] uppercase tracking-widest text-[#583f39] font-medium mt-3 block">Mujeres</span>
        <span class="text-[9px] text-[#a88279] mt-0.5">Vestido Formal</span>
      </div>

    </div>

    <!-- Description -->
    <p class="text-xs md:text-sm font-light text-[#6d5650] leading-relaxed mb-6 px-2">
      {dressCode.subtitulo}
    </p>

    <!-- Color Palettes Section -->
    {(dressCode.coloresSugeridos || dressCode.coloresNoPermitidos) && (
      <div class="mt-6 pt-5 border-t border-[#f0ded8] flex flex-col gap-4">
        
        {dressCode.coloresSugeridos && dressCode.coloresSugeridos.length > 0 && (
          <div class="flex flex-col items-center">
            <span class="text-[9px] uppercase tracking-wider text-[#a88279] font-bold mb-2">Paleta Sugerida</span>
            <div class="flex gap-2.5">
              {dressCode.coloresSugeridos.map((color: string) => (
                <div 
                  class="w-7 h-7 rounded-full border border-white shadow-md transform hover:scale-110 transition-transform relative group cursor-pointer"
                  style={`background-color: ${color};`}
                >
                  <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 bg-[#583f39] text-[#fffcfb] text-[8px] py-0.5 px-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">{color}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {dressCode.coloresNoPermitidos && dressCode.coloresNoPermitidos.length > 0 && (
          <div class="flex flex-col items-center">
            <span class="text-[9px] uppercase tracking-wider text-red-700/60 font-bold mb-2">Evitar estos colores</span>
            <div class="flex gap-2.5">
              {dressCode.coloresNoPermitidos.map((color: string) => (
                <div class="relative group cursor-pointer">
                  <div 
                    class="w-7 h-7 rounded-full border border-white shadow-md opacity-40"
                    style={`background-color: ${color};`}
                  />
                  <!-- Cross overlay -->
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-8 h-[1px] bg-red-600 rotate-45"></div>
                  </div>
                  <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 bg-[#583f39] text-[#fffcfb] text-[8px] py-0.5 px-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Restringido</span>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    )}

    {dressCode.nota && (
      <p class="text-[10px] italic text-[#a88279] mt-6">
        * {dressCode.nota}
      </p>
    )}
  </div>
</section>
