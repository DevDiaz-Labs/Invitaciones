---
// src/components/sobre/SobreDoblePuerta.astro
interface Props {
    nombre: string;
    fecha: string;
    evento?: string;
    mensajeTop?: string;
    pases?: {
        mostrar: boolean;
        cantidad: number;
        texto?: string;
    };
    colorFondoBase?: string;
    colorSobre?: string;
    colorSolapa?: string;
    colorSolapaLado?: string;
    colorSello?: string;
    colorSelloBorde?: string;
    colorCartaFondo?: string;
    colorCartaTexto?: string;
    fuenteNombres?: string;
    fuenteTitulos?: string;
    colorTitulo?: string;
    colorNombre?: string;
    colorMensajeTop?: string;
}

const {
    nombre,
    fecha,
    evento = "Mis XV Años",
    mensajeTop = "Te invito a celebrar",
    pases,
    colorFondoBase = "#0f172a",
    colorSobre = "#2c1b47", // Royal deep purple
    colorSolapa = "#3b225c",
    colorSolapaLado = "#52307c",
    colorSello = "#cca43b", // Old gold
    colorSelloBorde = "#b38f2e",
    colorCartaFondo = "#fffdfa",
    colorCartaTexto = "#2c1b47",
    fuenteNombres = "'Great Vibes', cursive",
    fuenteTitulos = "'Cinzel', serif",
    colorTitulo = "#cca43b",
    colorNombre = colorCartaTexto,
    colorMensajeTop,
} = Astro.props;

const resolvedColorMensajeTop = colorMensajeTop ?? colorSobre;
const inicial = nombre ? nombre.charAt(0).toUpperCase() : "";
---

<div
    id="envelope-screen"
    class="envelope-screen-overlay fixed inset-0 z-[99]"
    style={`background-color: ${colorFondoBase}; transition: opacity 1.2s ease-in-out, visibility 1.2s ease-in-out; display: flex; align-items: center; justify-content: center; flex-direction: column;`}
>
    <div class="text-center mb-8 px-4">
        <h2
            style={`font-family: ${fuenteTitulos}; letter-spacing: 0.2em; text-transform: uppercase; color: #faeedd; margin-bottom: 8px;`}
        >
            Puertas de Gala
        </h2>
        <p
            style={`font-family: ${fuenteNombres}; font-size: 3rem; color: ${colorTitulo};`}
        >
            {evento}
        </p>
        <p
            style="font-family: 'Montserrat', sans-serif; font-size: 0.875rem; font-weight: 300; margin-top: 24px; color: rgba(255,255,255,0.6); letter-spacing: 0.1em;"
        >
            Presiona el centro para abrir
        </p>
    </div>

    <!-- Gatefold container with 3D perspective -->
    <div class="envelope-container" style="perspective: 2000px; width: 340px; height: 230px; position: relative;">
        <div
            id="envelope-gatefold"
            class="envelope-wrapper"
            style="position: absolute; inset: 0; transition: transform 0.4s ease; transform-style: preserve-3d; cursor: pointer;"
        >
            <!-- Back casing -->
            <div
                class="gatefold-back"
                style={`position: absolute; inset: 0; background: ${colorSobre}; border-radius: 6px; box-shadow: 0 20px 40px rgba(0,0,0,0.5);`}
            >
            </div>

            <!-- Letter Inside (Stays in background, scales up) -->
            <div
                id="letter-gatefold"
                style={`position: absolute; top: 10px; left: 15px; right: 15px; bottom: 10px; background: ${colorCartaFondo}; border-radius: 4px; transition: transform 1s cubic-bezier(0.25, 1, 0.5, 1) 0.5s, opacity 0.8s ease; box-shadow: 0 0 12px rgba(0,0,0,0.15) inset; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; z-index: 5; transform: scale(0.92); opacity: 0.8;`}
            >
                <div
                    style={`font-family: ${fuenteTitulos}; font-size: 10px; letter-spacing: 0.2em; color: ${resolvedColorMensajeTop}; text-transform: uppercase; font-weight: 600;`}
                >
                    {mensajeTop}
                </div>
                <div
                    style={`font-family: ${fuenteNombres}; font-size: 2.4rem; color: ${colorNombre}; margin: 6px 0;`}
                    set:html={nombre}
                >
                </div>
                <div
                    style="font-family: 'Montserrat', sans-serif; font-size: 9px; letter-spacing: 0.2em; color: #6b7280; text-transform: uppercase; font-weight: 600;"
                >
                    {fecha}
                </div>
                {pases?.mostrar && (
                    <div
                        style="font-family: 'Montserrat', sans-serif; font-size: 8px; letter-spacing: 0.1em; color: #6b7280; text-transform: uppercase; margin-top: 10px; font-style: italic; opacity: 0.8;"
                    >
                        {pases.texto || "Invitación válida para:"} {pases.cantidad} pases
                    </div>
                )}
            </div>

            <!-- Left Door -->
            <div
                id="door-left"
                style={`position: absolute; top: 0; bottom: 0; left: 0; width: 170px; background: linear-gradient(to right, ${colorSolapaLado}, ${colorSolapa}); border-radius: 6px 0 0 6px; transform-origin: left; transition: transform 0.9s cubic-bezier(0.35, 1.3, 0.65, 1) 0.2s; z-index: 15; transform-style: preserve-3d; border-right: 1px solid rgba(255,255,255,0.1);`}
            >
                <!-- Decorative Laser-cut Pattern SVG on door -->
                <div style="position: absolute; inset: 12px; border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; pointer-events: none; opacity: 0.6; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px;">
                    <svg width="24" height="60" viewBox="0 0 24 60" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1">
                        <path d="M2 2 C10 15, 10 45, 2 58 M8 10 C15 20, 15 40, 8 50 M14 20 C18 25, 18 35, 14 40" />
                    </svg>
                </div>
            </div>

            <!-- Right Door -->
            <div
                id="door-right"
                style={`position: absolute; top: 0; bottom: 0; right: 0; width: 170px; background: linear-gradient(to left, ${colorSolapaLado}, ${colorSolapa}); border-radius: 0 6px 6px 0; transform-origin: right; transition: transform 0.9s cubic-bezier(0.35, 1.3, 0.65, 1) 0.2s; z-index: 15; transform-style: preserve-3d; border-left: 1px solid rgba(255,255,255,0.1);`}
            >
                <!-- Decorative Laser-cut Pattern SVG on door -->
                <div style="position: absolute; inset: 12px; border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; pointer-events: none; opacity: 0.6; display: flex; align-items: center; justify-content: flex-start; padding-left: 8px;">
                    <svg width="24" height="60" viewBox="0 0 24 60" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1">
                        <path d="M22 2 C14 15, 14 45, 22 58 M16 10 C9 20, 9 40, 16 50 M10 20 C6 25, 6 35, 10 40" transform="scale(-1, 1) translate(-24, 0)" />
                    </svg>
                </div>
            </div>

            <!-- Central Ribbon/Belt Sash -->
            <div
                id="gatefold-belt"
                style={`position: absolute; top: 0; bottom: 0; left: 125px; width: 90px; background: ${colorSello}; border: 1px solid ${colorSelloBorde}; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 25; transition: transform 0.7s cubic-bezier(0.6, -0.28, 0.735, 0.045), opacity 0.5s ease; display: flex; align-items: center; justify-content: center;`}
            >
                <!-- Decorative Seal on Ribbon -->
                <div style={`width: 44px; height: 44px; border-radius: 50%; background: ${colorSolapa}; border: 2px solid ${colorSelloBorde}; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);`}>
                    <span style={`font-family: ${fuenteTitulos}; font-size: 16px; font-weight: bold; color: ${colorTitulo};`}>
                        {inicial}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script is:inline>
    (function() {
        function initEnvelopeGatefold() {
            const envelopeScreen = document.querySelector("#envelope-screen");
            const envelope = document.querySelector("#envelope-gatefold");
            const doorLeft = document.querySelector("#door-left");
            const doorRight = document.querySelector("#door-right");
            const belt = document.querySelector("#gatefold-belt");
            const letter = document.querySelector("#letter-gatefold");

            if (!envelope || !doorLeft || !doorRight || !letter) return;
            if (envelope.dataset.envelopeInitialized) return;
            envelope.dataset.envelopeInitialized = "true";

            // Hide invitation content initially (if it is already in DOM)
            const invitationContentInit = document.querySelector("#invitation-content");
            if (envelopeScreen && invitationContentInit) {
                invitationContentInit.style.opacity = "0";
                invitationContentInit.style.visibility = "hidden";
            }

            let opened = false;

            envelope.addEventListener("click", () => {
                if (opened) return;
                opened = true;

                const invitationContent = document.querySelector("#invitation-content");
                const footerContent = document.querySelector("#footer-content");

                // 1. Desvanecer la faja deslizando hacia abajo
                if (belt) {
                    belt.style.transform = "translateY(240px)";
                    belt.style.opacity = "0";
                }

                // 2. Abrir las dos puertas
                doorLeft.style.transform = "rotateY(-145deg)";
                doorRight.style.transform = "rotateY(145deg)";

                // 3. Destacar la carta
                letter.style.transform = "scale(1.08) translateZ(30px)";
                letter.style.opacity = "1";
                letter.style.zIndex = "20";

                // 4. Ocultar pantalla y mostrar invitación
                setTimeout(() => {
                    if (envelopeScreen) {
                        envelopeScreen.style.opacity = "0";
                        envelopeScreen.style.visibility = "hidden";
                    }

                    if (invitationContent) {
                        invitationContent.style.opacity = "1";
                        invitationContent.style.transform = "translateY(0)";
                        invitationContent.style.visibility = "visible";
                    }

                    if (footerContent) {
                        footerContent.style.opacity = "1";
                        footerContent.style.visibility = "visible";
                    }

                    window.scrollTo(0, 0);
                }, 1800);

                setTimeout(() => {
                    if (envelopeScreen) {
                        envelopeScreen.style.display = "none";
                    }
                }, 3200);
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initEnvelopeGatefold);
        } else {
            initEnvelopeGatefold();
        }
        document.addEventListener("astro:page-load", initEnvelopeGatefold);
    })();
</script>
