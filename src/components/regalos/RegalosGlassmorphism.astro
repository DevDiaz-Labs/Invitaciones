---
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    textoEfectivo?: string;
    textoMesa?: string;
  };
  bgImage?: string;
}
const { data, bgImage } = Astro.props;
const defaultBg = bgImage || "https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80";
---
<section class="py-24 px-4 relative min-h-[70vh] flex items-center justify-center bg-fixed bg-center bg-cover" style={`background-image: url('${defaultBg}')`}>
  <div class="absolute inset-0 bg-black/30"></div>
  
  <div class="relative z-10 w-full max-w-4xl bg-white/20 backdrop-blur-xl border border-white/30 p-10 md:p-16 rounded-3xl shadow-2xl text-white">
    <h2 class="text-4xl font-serif text-center mb-6 drop-shadow-md">Nuestros Regalos</h2>
    <p class="text-center text-lg font-light mb-12 drop-shadow-md">{data.mensaje}</p>
    
    <div class="grid md:grid-cols-2 gap-8">
      {data.opcionEfectivo && (
        <div class="bg-white/10 p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all">
          <h3 class="text-xl font-medium mb-3">Lluvia de Sobres</h3>
          <p class="text-white/80 text-sm leading-relaxed">{data.textoEfectivo}</p>
        </div>
      )}
      
      {data.opcionMesa && (
        <div class="bg-white/10 p-6 rounded-2xl border border-white/20 hover:bg-white/20 transition-all flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-medium mb-3">Mesa de Regalos</h3>
            <p class="text-white/80 text-sm leading-relaxed mb-6">{data.textoMesa}</p>
          </div>
          <button class="bg-white text-black/80 px-6 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 mt-auto w-fit">Ver mesa</button>
        </div>
      )}
    </div>
  </div>
</section>
