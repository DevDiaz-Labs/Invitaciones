---
interface Props {
  data: {
    mensaje: string;
    banco?: string;
    tiendaURL?: string;
  };
}
const { data } = Astro.props;
const mensaje = data?.mensaje || "";
const banco = data?.banco || "";
const tiendaURL = data?.tiendaURL || "#";
---
<section class="py-24 px-6 bg-[#0B0F19] text-gray-300 font-sans border-t border-gray-800">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-sm tracking-[0.4em] text-blue-400 uppercase mb-4">Agradecimiento</h2>
      <p class="text-2xl md:text-3xl font-light text-white max-w-3xl mx-auto">"{mensaje}"</p>
    </div>
    
    <div class="grid md:grid-cols-2 gap-px bg-gray-800 rounded-2xl overflow-hidden border border-gray-800 shadow-2xl">
      <div class="bg-[#111827] p-10 flex flex-col justify-center transition-colors hover:bg-[#161f33]">
        <div class="mb-6 inline-flex p-3 bg-blue-500/10 rounded-xl text-blue-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
        </div>
        <h3 class="text-xl font-medium text-white mb-4">Datos Bancarios</h3>
        <pre class="font-mono text-sm text-gray-400 whitespace-pre-wrap">{banco}</pre>
      </div>
      
      <div class="bg-[#111827] p-10 flex flex-col justify-center items-start transition-colors hover:bg-[#161f33]">
        <div class="mb-6 inline-flex p-3 bg-purple-500/10 rounded-xl text-purple-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        </div>
        <h3 class="text-xl font-medium text-white mb-4">Mesa de Regalos</h3>
        <p class="text-gray-400 mb-8">Encuentra nuestra selección de regalos en la tienda oficial.</p>
        <a href={tiendaURL} target="_blank" class="inline-flex items-center gap-2 bg-white text-black px-6 py-3 rounded-lg font-medium hover:bg-gray-200 transition-colors">
          Ver artículos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>
  </div>
</section>
