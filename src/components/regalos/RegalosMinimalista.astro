---
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    textoEfectivo?: string;
    textoMesa?: string;
  };
}
const { data } = Astro.props;
---
<section class="py-32 px-4 bg-white text-black flex items-center justify-center min-h-[50vh]">
  <div class="max-w-3xl w-full text-center">
    <h2 class="text-xs uppercase tracking-[0.5em] text-gray-400 mb-10">Gifts</h2>
    <p class="text-2xl md:text-4xl font-light mb-16 text-gray-800">
      {data.mensaje}
    </p>
    
    <div class="flex flex-col md:flex-row justify-center gap-16 md:gap-24 text-left">
      {data.opcionEfectivo && (
        <div class="flex-1 border-t border-gray-200 pt-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest mb-4">Cash Fund</h3>
          <p class="text-gray-500 font-light text-sm leading-relaxed">{data.textoEfectivo}</p>
        </div>
      )}
      
      {data.opcionMesa && (
        <div class="flex-1 border-t border-gray-200 pt-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest mb-4">Registry</h3>
          <p class="text-gray-500 font-light text-sm leading-relaxed mb-6">{data.textoMesa}</p>
          <a href="#" class="text-xs border-b border-black pb-1 hover:text-gray-500 hover:border-gray-500 transition-colors uppercase tracking-widest">View Registry</a>
        </div>
      )}
    </div>
  </div>
</section>
