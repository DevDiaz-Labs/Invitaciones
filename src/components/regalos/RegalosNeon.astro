---
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    textoEfectivo?: string;
    textoMesa?: string;
  };
}
const { data } = Astro.props;
---
<section class="py-24 px-6 bg-[#09090b] text-white overflow-hidden relative">
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-[100px]"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-600/20 rounded-full blur-[100px]"></div>
  
  <div class="max-w-5xl mx-auto relative z-10 text-center">
    <h2 class="text-5xl font-black mb-6 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500 drop-shadow-[0_0_15px_rgba(34,211,238,0.5)]">
      PRESENTS
    </h2>
    <p class="text-xl text-gray-400 mb-16">{data.mensaje}</p>
    
    <div class="flex flex-col md:flex-row gap-10 justify-center items-stretch">
      {data.opcionEfectivo && (
        <div class="flex-1 bg-gray-900/50 p-8 rounded-xl border border-purple-500/30 shadow-[0_0_30px_rgba(168,85,247,0.1)] hover:shadow-[0_0_30px_rgba(168,85,247,0.3)] transition-all">
          <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mb-6 mx-auto">
            <span class="text-2xl">💸</span>
          </div>
          <h3 class="text-xl font-bold text-purple-400 mb-4">Cash Fund</h3>
          <p class="text-gray-400 text-sm">{data.textoEfectivo}</p>
        </div>
      )}
      
      {data.opcionMesa && (
        <div class="flex-1 bg-gray-900/50 p-8 rounded-xl border border-cyan-500/30 shadow-[0_0_30px_rgba(34,211,238,0.1)] hover:shadow-[0_0_30px_rgba(34,211,238,0.3)] transition-all">
          <div class="w-12 h-12 bg-cyan-500/20 rounded-lg flex items-center justify-center mb-6 mx-auto">
            <span class="text-2xl">🎁</span>
          </div>
          <h3 class="text-xl font-bold text-cyan-400 mb-4">Wishlist</h3>
          <p class="text-gray-400 text-sm mb-6">{data.textoMesa}</p>
          <button class="bg-cyan-500/20 text-cyan-300 border border-cyan-500/50 px-6 py-2 rounded-md hover:bg-cyan-500 hover:text-white transition-colors">Access Link</button>
        </div>
      )}
    </div>
  </div>
</section>
