---
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    textoEfectivo?: string;
    textoMesa?: string;
  };
}
const { data } = Astro.props;
---
<section class="py-24 px-6 bg-[#1A1A1A] text-[#D4AF37] border-y-8 border-[#D4AF37]">
  <div class="max-w-5xl mx-auto flex flex-col items-center">
    <div class="w-full flex justify-center mb-8">
      <div class="w-32 h-[1px] bg-[#D4AF37]"></div>
      <div class="mx-4 text-2xl">✧</div>
      <div class="w-32 h-[1px] bg-[#D4AF37]"></div>
    </div>
    
    <h2 class="text-5xl font-serif mb-6 text-center tracking-wider">Presentes</h2>
    <p class="text-lg text-center text-gray-300 max-w-2xl mb-16 font-light">{data.mensaje}</p>
    
    <div class="w-full grid md:grid-cols-2 gap-12">
      {data.opcionEfectivo && (
        <div class="border border-[#D4AF37] p-10 text-center relative">
          <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-[#1A1A1A] px-4">
            <span class="text-4xl">✉</span>
          </div>
          <h3 class="text-2xl font-serif mb-4 mt-4 uppercase tracking-widest text-white">Efectivo</h3>
          <p class="text-gray-400 font-light">{data.textoEfectivo}</p>
        </div>
      )}
      
      {data.opcionMesa && (
        <div class="border border-[#D4AF37] p-10 text-center relative">
          <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-[#1A1A1A] px-4">
            <span class="text-4xl">❁</span>
          </div>
          <h3 class="text-2xl font-serif mb-4 mt-4 uppercase tracking-widest text-white">Mesa de Regalos</h3>
          <p class="text-gray-400 font-light mb-6">{data.textoMesa}</p>
          <a href="#" class="inline-block border border-[#D4AF37] text-[#D4AF37] px-8 py-2 hover:bg-[#D4AF37] hover:text-black transition-colors uppercase text-sm tracking-widest">Descubrir</a>
        </div>
      )}
    </div>
  </div>
</section>
