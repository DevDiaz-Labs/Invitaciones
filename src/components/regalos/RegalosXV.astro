---
// Regalos.astro
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    mostrarDatosBancarios?: boolean;
    amazon_liverpool?: boolean;
    datosBancarios?: string;
    // Nuevas propiedades para flexibilidad
    layout?: "grid" | "vertical";
    textoEfectivo?: string;
    textoMesa?: string;
    tarjetaEfectivo?: boolean;
  };
  nombre: string;
  bgImage?: string;
  bgPos?: string;
}
const { data, nombre, bgImage, bgPos = "center" } = Astro.props;

// Defaults para mantener compatibilidad
const layout = data.layout || "grid";
const textEf = data.textoEfectivo || "Tu presencia es mi mejor regalo, pero si deseas tener un detalle conmigo, habrá un baúl para sobres en la recepción.";
const textMe = data.textoMesa || (data.amazon_liverpool ? 
    `Puedes encontrar mi mesa de regalos en Amazon o Liverpool a nombre de ${nombre}.` :
    "Si prefieres obsequiarme algo especial, también aceptaré tarjetas de regalo de mis tiendas favoritas.");
---

<section 
    class="py-32 md:py-40 px-6 text-center flex flex-col justify-center items-center min-h-[70vh] relative overflow-hidden" 
    style={`${bgImage ? `background-image: linear-gradient(rgba(255, 236, 251, 0.5), rgba(255, 236, 251, 0.5)), url('${bgImage}'); background-size: cover; background-position: center; background-repeat: no-repeat;` : "background-color: rgba(var(--gold-rgb), 0.05);"}`}
>
    <div class="max-w-4xl mx-auto space-y-12 md:space-y-16 w-full relative z-10">
        <h3 class="font-titulo text-5xl text-[var(--gold)] observe-me fade-up">
            Regalos
        </h3>

        <div class={`${layout === 'grid' ? 'grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-20' : 'flex flex-col items-center space-y-24 md:space-y-32'}`}>
            
            {/* Lado/Sección de Mesa de Regalos (si es vertical, la ponemos primero si queremos, o mantenemos el orden) */}
            {/* En el código original, Efectivo estaba primero. Si es vertical, el usuario pidió Mesa arriba */}
            
            {layout === "vertical" && data.opcionMesa && (
                <div class="space-y-6 observe-me fade-up max-w-lg" style="transition-delay: 200ms;">
                    <div class="w-20 h-20 mx-auto mb-8 text-[var(--gold)]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 12 20 22 4 22 4 12"></polyline>
                            <rect x="2" y="7" width="20" height="5"></rect>
                            <line x1="12" y1="22" x2="12" y2="7"></line>
                            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                        </svg>
                    </div>
                    <h4 class="text-2xl md:text-3xl tracking-[0.3em] uppercase text-[var(--gold)] font-medium">
                        Mesa de Regalos
                    </h4>
                    <p class="text-[var(--dark-text)] text-lg md:text-xl italic leading-relaxed px-4">
                        {textMe}
                    </p>
                </div>
            )}

            {data.opcionEfectivo && (
                <div class={`${layout === 'grid' ? 'space-y-6' : 'space-y-6 max-w-lg'} observe-me fade-up ${data.tarjetaEfectivo ? 'bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-black/5' : ''}`} style="transition-delay: 200ms;">
                    <div class="w-16 h-16 mx-auto mb-6 text-[var(--gold)]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <h4 class={`${layout === 'grid' ? 'text-lg md:text-xl' : 'text-2xl md:text-3xl'} tracking-[0.3em] uppercase text-[var(--gold)] font-medium`}>
                        Lluvia de Sobres
                    </h4>
                    <p class={`${layout === 'grid' ? 'text-[var(--dark-text)]/70 text-base' : 'text-[var(--dark-text)] text-lg md:text-xl'} italic leading-relaxed px-4`}>
                        {textEf}
                    </p>
                </div>
            )}

            {layout === "grid" && data.opcionMesa && (
                <div class="space-y-6 observe-me fade-up" style="transition-delay: 400ms;">
                    <div class="w-16 h-16 mx-auto mb-6 text-[var(--gold)]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 12 20 22 4 22 4 12"></polyline>
                            <rect x="2" y="7" width="20" height="5"></rect>
                            <line x1="12" y1="22" x2="12" y2="7"></line>
                            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                            <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                        </svg>
                    </div>
                    <h4 class="text-lg md:text-xl tracking-[0.3em] uppercase text-[var(--gold)] font-medium">
                        Mesa de Regalos
                    </h4>
                    <p class="text-[var(--dark-text)]/70 italic text-base leading-relaxed px-4">
                        {textMe}
                    </p>
                </div>
            )}
        </div>

        {/* Mensaje final mejorado */}
        <div class="pt-16 pb-8 observe-me fade-up" style="transition-delay: 600ms;">
            {(!data.opcionEfectivo && !data.opcionMesa) ? (
                <div class="flex justify-center items-center gap-8 mb-8 text-[var(--gold)]">
                    <svg class="w-14 h-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <svg class="w-14 h-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                </div>
            ) : (
                <div class="w-12 h-[1px] bg-[var(--gold)]/40 mx-auto mb-10"></div>
            )}
            
            <p 
                class="text-[var(--dark-text)] italic text-lg md:text-xl leading-relaxed max-w-2xl mx-auto font-medium"
                set:html={`"${data.mensaje}"`}
            >
            </p>
        </div>
    </div>
</section>
