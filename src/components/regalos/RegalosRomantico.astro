---
interface Props {
  data: {
    mensaje: string;
    banco?: string;
    tiendaURL?: string;
  };
}
const { data } = Astro.props;
const mensaje = data?.mensaje || "";
const banco = data?.banco || "";
const tiendaURL = data?.tiendaURL || "#";
---
<section class="py-20 px-6 bg-rose-50/30 text-center">
  <div class="max-w-3xl mx-auto">
    <div class="text-rose-300 mb-6 flex justify-center">
      <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
    </div>
    
    <h2 class="text-4xl font-serif italic text-rose-900 mb-6">Con mucho cariño</h2>
    <p class="text-lg text-rose-700/80 mb-12 font-light">{mensaje}</p>
    
    <div class="flex flex-col gap-10">
      <div class="border-b border-rose-200 pb-10">
        <h3 class="text-xl font-medium text-rose-800 mb-4 tracking-widest uppercase text-sm">Detalles Bancarios</h3>
        <pre class="font-sans text-gray-600 whitespace-pre-wrap max-w-sm mx-auto">{banco}</pre>
      </div>
      
      <div class="pt-2">
        <h3 class="text-xl font-medium text-rose-800 mb-6 tracking-widest uppercase text-sm">Mesa de Regalos</h3>
        <a href={tiendaURL} target="_blank" class="inline-block bg-white text-rose-600 border border-rose-200 px-10 py-3 rounded-full hover:bg-rose-50 transition-colors uppercase text-xs tracking-wider font-semibold shadow-sm">Descubrir opciones</a>
      </div>
    </div>
  </div>
</section>
