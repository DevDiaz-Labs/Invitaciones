---
interface Props {
  data: {
    mensaje: string;
    banco?: string;
    tiendaURL?: string;
  };
}
const { data } = Astro.props;
const mensaje = data?.mensaje || "";
const banco = data?.banco || "";
const tiendaURL = data?.tiendaURL || "#";
---
<section class="py-24 px-6 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-stretch gap-12">
    
    <div class="flex-1 flex flex-col justify-center items-start text-left border-l-4 border-gray-800 pl-8">
      <h2 class="text-5xl font-serif text-gray-900 mb-6 tracking-tight">Obsequios</h2>
      <p class="text-lg text-gray-500 font-light leading-relaxed max-w-md">{mensaje}</p>
    </div>
    
    <div class="flex-1 flex flex-col gap-6">
      <div class="p-8 bg-gray-50 flex items-start gap-6 border border-gray-100">
        <span class="text-gray-300">01</span>
        <div>
          <h3 class="text-lg uppercase tracking-widest text-gray-900 font-bold mb-3">Transferencia</h3>
          <pre class="font-sans text-sm text-gray-600 whitespace-pre-wrap leading-loose">{banco}</pre>
        </div>
      </div>
      
      <div class="p-8 bg-gray-900 text-white flex items-start gap-6">
        <span class="text-gray-600">02</span>
        <div>
          <h3 class="text-lg uppercase tracking-widest font-bold mb-3">Mesa de Regalos</h3>
          <p class="text-gray-400 text-sm mb-6">Explora nuestra selección en línea.</p>
          <a href={tiendaURL} target="_blank" class="border border-white/30 px-6 py-2 hover:bg-white hover:text-black transition-colors uppercase text-xs tracking-widest">Acceder</a>
        </div>
      </div>
    </div>
    
  </div>
</section>
