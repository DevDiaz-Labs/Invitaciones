---
const { data } = Astro.props;
const titulo = data?.titulo || 'Confirmar Asistencia';
const mensaje = data?.mensajeDespedida || 'Esperamos contar con tu presencia en este día tan especial.';
---

<section class="py-12 px-6 bg-slate-900 text-slate-100 font-sans relative overflow-hidden">
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-700 via-slate-900 to-slate-900"></div>
  <div class="max-w-lg mx-auto relative z-10 bg-slate-800/50 backdrop-blur-md p-8 border border-slate-700 rounded-2xl shadow-2xl">
    <h2 class="text-3xl font-bold mb-3 text-center text-blue-400">{titulo}</h2>
    <p class="text-center text-slate-400 mb-8 text-sm">{mensaje}</p>

    <form class="space-y-5">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Nombre Completo</label>
        <input type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 text-slate-200 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all placeholder-slate-600" placeholder="Ej. Familia López" required />
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Asistencia</label>
        <div class="flex gap-4">
          <label class="flex-1 cursor-pointer">
            <input type="radio" name="attending" class="peer sr-only" checked />
            <div class="text-center px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-all">Sí, asistiré</div>
          </label>
          <label class="flex-1 cursor-pointer">
            <input type="radio" name="attending" class="peer sr-only" />
            <div class="text-center px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg peer-checked:border-red-500 peer-checked:bg-red-900/30 peer-checked:text-red-400 transition-all">No asistiré</div>
          </label>
        </div>
      </div>

      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-lg shadow-[0_0_15px_rgba(37,99,235,0.5)] transition-all uppercase tracking-wider mt-4">
        Enviar Confirmación
      </button>
    </form>
  </div>
</section>
