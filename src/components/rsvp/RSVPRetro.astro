---
const { data } = Astro.props;
const titulo = data?.titulo || 'GROOVY RSVP';
const mensaje = data?.mensajeDespedida || 'Can you dig it? Let us know if you\'re coming!';
---

<section class="py-16 px-4 bg-[#F2E8CF] border-y-[12px] border-[#A72608]">
  <div class="max-w-md mx-auto bg-[#386641] p-8 rounded-[40px] shadow-[8px_8px_0_0_#A72608] border-4 border-[#F2E8CF]">
    <h2 class="text-4xl font-black mb-2 text-center text-[#F2E8CF] uppercase tracking-tighter" style="font-family: 'Courier New', Courier, monospace;">{titulo}</h2>
    <p class="text-center text-[#BC4749] mb-8 font-bold bg-[#F2E8CF] py-2 px-4 rounded-full inline-block w-full">{mensaje}</p>

    <form class="space-y-6">
      <div>
        <label class="block text-sm font-bold text-[#F2E8CF] mb-2 uppercase">Your Name</label>
        <input type="text" class="w-full bg-[#F2E8CF] border-4 border-[#BC4749] rounded-2xl px-4 py-3 text-[#386641] focus:outline-none focus:ring-4 focus:ring-[#F2E8CF] font-bold text-lg" required />
      </div>

      <div class="space-y-3">
        <label class="flex items-center gap-4 bg-[#F2E8CF] p-4 rounded-2xl cursor-pointer border-4 border-[#BC4749] hover:bg-[#fff9ea]">
          <input type="radio" name="attending" class="w-6 h-6 accent-[#386641]" checked />
          <span class="text-[#386641] font-bold text-xl uppercase">Right On! (Yes)</span>
        </label>
        <label class="flex items-center gap-4 bg-[#F2E8CF] p-4 rounded-2xl cursor-pointer border-4 border-[#BC4749] hover:bg-[#fff9ea]">
          <input type="radio" name="attending" class="w-6 h-6 accent-[#A72608]" />
          <span class="text-[#A72608] font-bold text-xl uppercase">Bummer (No)</span>
        </label>
      </div>

      <button type="submit" class="w-full bg-[#A72608] hover:bg-[#BC4749] text-[#F2E8CF] font-black py-4 rounded-2xl border-4 border-[#F2E8CF] text-2xl uppercase tracking-wider shadow-[4px_4px_0_0_#F2E8CF] active:translate-y-1 active:shadow-none transition-all mt-6">
        SEND IT
      </button>
    </form>
  </div>
</section>
