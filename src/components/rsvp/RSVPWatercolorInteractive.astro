---
// src/components/rsvp/RSVPWatercolorInteractive.astro
const { data } = Astro.props;
---

<section class="py-12 px-6 bg-[#faf6f0] text-[#5c544e] font-serif relative overflow-hidden">
  
  <!-- Watercolor soft decorative background shapes -->
  <div class="absolute -top-12 -left-12 w-64 h-64 bg-[#e6ded4] rounded-full blur-3xl opacity-60 pointer-events-none"></div>
  <div class="absolute -bottom-16 -right-12 w-72 h-72 bg-[#dfd3c3] rounded-full blur-3xl opacity-60 pointer-events-none"></div>
  
  <div class="max-w-md mx-auto relative z-10" x-data="{
    submitted: false,
    formData: {
      nombre: '',
      asistencia: 'si',
      adultos: 2,
      ninos: 0,
      jovenes: 0,
      consejo: ''
    },
    submitForm() {
      console.log('Watercolor RSVP Submitted:', this.formData);
      this.submitted = true;
    }
  }">
    <div class="text-center mb-8">
      <span class="text-xs uppercase tracking-widest text-[#a88f78] font-sans font-semibold">R. S. V. P.</span>
      <h3 class="text-3xl font-normal text-[#5c544e] mt-2 italic">Acompáñanos a Escribir esta Historia</h3>
      <div class="w-12 h-[1px] bg-[#a88f78]/40 mx-auto mt-4"></div>
    </div>

    <!-- Thanks State -->
    <div x-show="submitted" x-transition.opacity.duration.400ms class="bg-white/80 border border-[#e6ded4] p-8 rounded-2xl text-center shadow-lg backdrop-blur-sm">
      <h4 class="text-2xl italic text-[#5c544e] mb-3">¡Muchas Gracias!</h4>
      <p class="text-xs font-sans text-gray-500 leading-relaxed" x-text="formData.asistencia === 'si' ? 'Tu confirmación ha sido guardada en nuestro tintero. ¡Nos vemos en el día más feliz!' : 'Agradecemos tu respuesta sincera. Tu cariño nos acompaña a la distancia.'"></p>
      <button type="button" @click="submitted = false" class="text-[10px] uppercase font-sans tracking-widest text-[#a88f78] mt-4 hover:underline">Modificar</button>
    </div>

    <!-- Form Content -->
    <div x-show="!submitted" class="bg-white/95 border border-[#e6ded4] rounded-2xl p-6 md:p-8 shadow-xl backdrop-blur-sm">
      <form @submit.prevent="submitForm" class="space-y-6 text-left">
        
        <div>
          <label class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-gray-400 mb-2">Nombre y Apellido</label>
          <input type="text" required x-model="formData.nombre" class="w-full bg-[#fcfbfa] border-b border-gray-300 py-2 px-1 focus:outline-none focus:border-[#a88f78] transition-colors text-sm font-sans text-[#5c544e]" placeholder="Escribe tu nombre" />
        </div>

        <div>
          <label class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-gray-400 mb-3">¿Estarás con nosotros?</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer flex-1 py-2 px-3 border border-[#e6ded4] rounded-lg hover:bg-[#faf6f0] transition-colors">
              <input type="radio" value="si" x-model="formData.asistencia" class="text-[#a88f78] focus:ring-0 w-4 h-4 border-gray-300" />
              <span class="text-xs font-sans text-gray-700">Sí, asistiré</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer flex-1 py-2 px-3 border border-[#e6ded4] rounded-lg hover:bg-[#faf6f0] transition-colors">
              <input type="radio" value="no" x-model="formData.asistencia" class="text-[#a88f78] focus:ring-0 w-4 h-4 border-gray-300" />
              <span class="text-xs font-sans text-gray-700">No podré</span>
            </label>
          </div>
        </div>

        <!-- Conditional form section -->
        <div x-show="formData.asistencia === 'si'" x-transition:enter="transition ease-out duration-300" class="space-y-6 border-t border-[#e6ded4]/50 pt-4">
          
          <!-- Detailed Counters -->
          <div>
            <label class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-gray-400 mb-3">Número de pases solicitados</label>
            <div class="grid grid-cols-3 gap-2">
              <div class="text-center">
                <span class="text-[10px] font-sans text-gray-500 block mb-1">Adultos</span>
                <div class="flex items-center justify-between border border-[#e6ded4] rounded bg-[#fcfbfa] px-1 py-0.5">
                  <button type="button" @click="if(formData.adultos > 0) formData.adultos--" class="text-sm font-bold text-[#a88f78] px-1">-</button>
                  <span class="text-xs font-sans font-bold" x-text="formData.adultos"></span>
                  <button type="button" @click="if(formData.adultos < 8) formData.adultos++" class="text-sm font-bold text-[#a88f78] px-1">+</button>
                </div>
              </div>
              <div class="text-center">
                <span class="text-[10px] font-sans text-gray-500 block mb-1">Jóvenes</span>
                <div class="flex items-center justify-between border border-[#e6ded4] rounded bg-[#fcfbfa] px-1 py-0.5">
                  <button type="button" @click="if(formData.jovenes > 0) formData.jovenes--" class="text-sm font-bold text-[#a88f78] px-1">-</button>
                  <span class="text-xs font-sans font-bold" x-text="formData.jovenes"></span>
                  <button type="button" @click="if(formData.jovenes < 8) formData.jovenes++" class="text-sm font-bold text-[#a88f78] px-1">+</button>
                </div>
              </div>
              <div class="text-center">
                <span class="text-[10px] font-sans text-gray-500 block mb-1">Niños</span>
                <div class="flex items-center justify-between border border-[#e6ded4] rounded bg-[#fcfbfa] px-1 py-0.5">
                  <button type="button" @click="if(formData.ninos > 0) formData.ninos--" class="text-sm font-bold text-[#a88f78] px-1">-</button>
                  <span class="text-xs font-sans font-bold" x-text="formData.ninos"></span>
                  <button type="button" @click="if(formData.ninos < 8) formData.ninos++" class="text-sm font-bold text-[#a88f78] px-1">+</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Advice field -->
          <div>
            <label class="block text-[11px] uppercase tracking-wider font-sans font-semibold text-gray-400 mb-2">Un mensaje o consejo para la pareja</label>
            <textarea x-model="formData.consejo" rows="3" class="w-full bg-[#fcfbfa] border border-[#e6ded4] rounded-lg p-2.5 text-xs font-sans focus:outline-none focus:border-[#a88f78] resize-none text-[#5c544e]" placeholder="Escribe aquí unas palabras cariñosas..."></textarea>
          </div>

        </div>

        <button type="submit" class="w-full bg-[#a88f78] text-white py-3 rounded-lg uppercase tracking-widest text-xs font-sans font-bold hover:bg-[#917963] transition-colors duration-300 shadow-md shadow-amber-900/10">
          Confirmar Asistencia
        </button>
      </form>
    </div>

  </div>
</section>
