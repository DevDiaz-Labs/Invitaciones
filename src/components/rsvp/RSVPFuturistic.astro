---
const { data } = Astro.props;
const titulo = data?.titulo || 'SYS_RSVP_INIT';
const mensaje = data?.mensajeDespedida || 'Awaiting transmission...';
---

<section class="py-16 px-6 bg-black text-green-400 font-mono relative">
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSIjMDAwIj48L3JlY3Q+CjxyZWN0IHdpZHRoPSIxIiBoZWlnaHQ9IjEiIGZpbGw9IiMwZmYyIiBvcGFjaXR5PSIwLjEiPjwvcmVjdD4KPC9zdmc+')] opacity-50"></div>
  <div class="max-w-xl mx-auto relative z-10 border border-green-500/50 bg-black/80 p-8 shadow-[0_0_20px_rgba(34,197,94,0.2)]">
    <div class="flex items-center gap-2 mb-6">
      <div class="w-3 h-3 bg-green-500 animate-pulse"></div>
      <h2 class="text-2xl uppercase tracking-[0.2em]">{titulo}</h2>
    </div>
    
    <p class="mb-8 text-green-500/70">> {mensaje}</p>

    <form class="space-y-6">
      <div class="border-l-2 border-green-500 pl-4">
        <label class="block text-xs uppercase text-green-500/50 mb-2">>> INPUT_USER_ID</label>
        <input type="text" class="w-full bg-transparent border-b border-green-500/30 py-2 text-green-400 focus:outline-none focus:border-green-400 transition-colors placeholder-green-800" placeholder="Type your name..." required />
      </div>

      <div class="border-l-2 border-green-500 pl-4">
        <label class="block text-xs uppercase text-green-500/50 mb-2">>> SELECT_STATUS</label>
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="radio" name="attending" class="w-4 h-4 accent-green-500 bg-black border-green-500" checked />
            <span class="group-hover:text-green-300 transition-colors">ACKNOWLEDGE (YES)</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="radio" name="attending" class="w-4 h-4 accent-green-500 bg-black border-green-500" />
            <span class="group-hover:text-green-300 transition-colors">DECLINE (NO)</span>
          </label>
        </div>
      </div>

      <div class="pt-4">
        <button type="submit" class="w-full border border-green-500 bg-green-500/10 hover:bg-green-500 hover:text-black text-green-400 py-3 uppercase tracking-widest transition-all">
          EXECUTE_RSVP
        </button>
      </div>
    </form>
  </div>
</section>
