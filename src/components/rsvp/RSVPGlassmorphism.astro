---
const { data } = Astro.props;
const titulo = data?.titulo || 'Confirma tu Asistencia';
const mensaje = data?.mensajeDespedida || 'Nos encantaría que nos acompañes.';
---

<section class="py-16 px-6 relative bg-[url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80')] bg-cover bg-center">
  <div class="absolute inset-0 bg-white/20"></div>
  <div class="max-w-md mx-auto relative z-10 bg-white/30 backdrop-blur-xl p-8 rounded-3xl border border-white/50 shadow-[0_8px_32px_0_rgba(31,38,135,0.37)]">
    <h2 class="text-3xl font-serif mb-2 text-center text-gray-800 drop-shadow-sm">{titulo}</h2>
    <p class="text-center text-gray-700 mb-8 font-medium">{mensaje}</p>

    <form class="space-y-6">
      <div>
        <input type="text" class="w-full bg-white/50 border border-white/60 rounded-xl px-5 py-3 text-gray-800 focus:outline-none focus:bg-white/70 transition-all placeholder-gray-600 shadow-inner" placeholder="Tu Nombre Completo" required />
      </div>

      <div class="flex gap-4">
        <label class="flex items-center gap-2 cursor-pointer bg-white/50 px-4 py-2 rounded-xl flex-1 border border-white/60">
          <input type="radio" name="attending" class="accent-gray-800 w-4 h-4" checked />
          <span class="text-gray-800 font-medium">Asistiré</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer bg-white/50 px-4 py-2 rounded-xl flex-1 border border-white/60">
          <input type="radio" name="attending" class="accent-gray-800 w-4 h-4" />
          <span class="text-gray-800 font-medium">No podré</span>
        </label>
      </div>

      <button type="submit" class="w-full bg-gray-800/90 hover:bg-gray-900 text-white font-semibold py-4 rounded-xl shadow-lg transition-all backdrop-blur-sm mt-2">
        Confirmar
      </button>
    </form>
  </div>
</section>
