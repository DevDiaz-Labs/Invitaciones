---
// src/components/rsvp/RSVPFestivalPass.astro
const { data } = Astro.props;
---

<section class="py-12 px-4 bg-[#111115] text-[#f3f4f6] font-sans relative overflow-hidden">
  <!-- Glowing neon decorative circles -->
  <div class="absolute -top-24 -left-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-pink-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-sm mx-auto relative z-10" x-data="{
    submitted: false,
    formData: {
      nombre: '',
      asistencia: 'si',
      adultos: 2,
      ninos: 0,
      menuPlato: 'res'
    },
    submitForm() {
      console.log('Festival Ticket RSVP:', this.formData);
      this.submitted = true;
    }
  }">
    <div class="text-center mb-6">
      <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold font-mono">Pase de Acceso Especial</span>
      <h3 class="text-2xl font-black mt-1 uppercase text-white tracking-tight">VIP Festival Ticket</h3>
      <p class="text-xs text-gray-500 mt-2 font-mono">Confirma tu acceso en el boleto interactivo</p>
    </div>

    <!-- Ticket Body Layout -->
    <div class="w-full bg-[#181822] rounded-3xl border border-white/5 shadow-2xl relative overflow-hidden">
      
      <!-- Side Cut-Outs (Concert Ticket Styling) -->
      <div class="absolute left-0 top-1/3 -translate-y-1/2 w-6 h-6 bg-[#111115] rounded-full -ml-3 border-r border-white/5 z-20"></div>
      <div class="absolute right-0 top-1/3 -translate-y-1/2 w-6 h-6 bg-[#111115] rounded-full -mr-3 border-l border-white/5 z-20"></div>

      <!-- Header panel -->
      <div class="bg-gradient-to-r from-pink-500/20 to-cyan-500/20 p-5 pb-6 border-b border-dashed border-white/10 text-center">
        <h4 class="text-lg font-black uppercase text-white tracking-widest">ADMIT ONE</h4>
        <p class="text-[10px] text-gray-400 font-mono mt-1">FESTIVAL DE AMOR & AMISTAD</p>
      </div>

      <!-- Ticket Core -->
      <div class="p-6">
        
        <!-- Thanks State -->
        <div x-show="submitted" class="text-center py-8 space-y-4">
          <div class="inline-block py-1 px-3 bg-cyan-500/20 border border-cyan-400 text-cyan-400 rounded-full font-mono text-[10px] font-bold uppercase tracking-wider">TICKET CONFIRMADO</div>
          <h5 class="text-lg font-bold text-white uppercase tracking-wider" x-text="formData.nombre"></h5>
          <p class="text-xs text-gray-400 leading-relaxed font-mono" x-text="formData.asistencia === 'si' ? `Acceso concedido para ${parseInt(formData.adultos) + parseInt(formData.ninos)} personas. ¡Prepárate para la fiesta!` : 'Boleto cancelado con éxito. ¡Te extrañaremos en el evento!'"></p>
          <div class="flex justify-center pt-2">
            <!-- Simulated Barcode -->
            <div class="w-48 h-10 bg-white/10 flex items-center justify-between px-3 py-1 rounded">
              <div class="w-[3px] h-full bg-white/60"></div>
              <div class="w-[1px] h-full bg-white/60"></div>
              <div class="w-[5px] h-full bg-white/60"></div>
              <div class="w-[2px] h-full bg-white/60"></div>
              <div class="w-[1px] h-full bg-white/60"></div>
              <div class="w-[4px] h-full bg-white/60"></div>
              <div class="w-[2px] h-full bg-white/60"></div>
              <div class="w-[3px] h-full bg-white/60"></div>
              <div class="w-[1px] h-full bg-white/60"></div>
              <div class="w-[5px] h-full bg-white/60"></div>
            </div>
          </div>
          <button type="button" @click="submitted = false;" class="text-[9px] text-cyan-400 uppercase tracking-widest font-mono block mx-auto mt-4 hover:underline">Modificar Boleto</button>
        </div>

        <!-- Form content -->
        <form x-show="!submitted" @submit.prevent="submitForm" class="space-y-4 text-left font-mono">
          
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-gray-400 mb-1">Nombre Completo</label>
            <input type="text" required x-model="formData.nombre" class="w-full bg-[#111115] border border-white/10 rounded-lg py-2 px-3 text-xs text-white focus:outline-none focus:border-cyan-500 font-mono" placeholder="Ej. Carlos Ortiz" />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button type="button" @click="formData.asistencia = 'si'" :class="formData.asistencia === 'si' ? 'bg-cyan-500 text-black font-bold' : 'bg-[#111115] text-gray-400 border border-white/5'" class="py-2 text-[10px] uppercase tracking-wider rounded font-mono">SÍ, IRÉ</button>
            <button type="button" @click="formData.asistencia = 'no'" :class="formData.asistencia === 'no' ? 'bg-pink-500 text-black font-bold' : 'bg-[#111115] text-gray-400 border border-white/5'" class="py-2 text-[10px] uppercase tracking-wider rounded font-mono">NO IRÉ</button>
          </div>

          <!-- Ticket dynamic fields -->
          <div x-show="formData.asistencia === 'si'" x-transition class="space-y-4 border-t border-white/10 pt-3">
            
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[9px] uppercase tracking-wider text-gray-500 mb-1">Adulto Pases</label>
                <div class="flex items-center justify-between bg-[#111115] rounded-lg px-2 py-0.5 border border-white/5">
                  <button type="button" @click="if(formData.adultos > 1) formData.adultos--" class="text-cyan-400 font-bold px-1 text-sm">-</button>
                  <span class="text-xs text-white" x-text="formData.adultos"></span>
                  <button type="button" @click="if(formData.adultos < 6) formData.adultos++" class="text-cyan-400 font-bold px-1 text-sm">+</button>
                </div>
              </div>
              <div>
                <label class="block text-[9px] uppercase tracking-wider text-gray-500 mb-1">Niño Pases</label>
                <div class="flex items-center justify-between bg-[#111115] rounded-lg px-2 py-0.5 border border-white/5">
                  <button type="button" @click="if(formData.ninos > 0) formData.ninos--" class="text-cyan-400 font-bold px-1 text-sm">-</button>
                  <span class="text-xs text-white" x-text="formData.ninos"></span>
                  <button type="button" @click="if(formData.ninos < 6) formData.ninos++" class="text-cyan-400 font-bold px-1 text-sm">+</button>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-[9px] uppercase tracking-wider text-gray-500 mb-1">Plato Principal</label>
              <select x-model="formData.menuPlato" class="w-full bg-[#111115] border border-white/10 rounded-lg py-1.5 px-2 text-xs text-white focus:outline-none focus:border-cyan-500 font-mono">
                <option value="res">Filete de Res en Salsa Pimienta</option>
                <option value="salmon">Salmón al Horno con Finas Hierbas</option>
                <option value="veggie">Lasaña de Vegetales Portobello</option>
              </select>
            </div>

          </div>

          <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-pink-500 text-black py-3 rounded-lg uppercase tracking-wider text-xs font-black hover:opacity-90 transition-opacity mt-4 font-mono">
            GENERAR BOLETO VIP
          </button>
        </form>

      </div>
    </div>
  </div>
</section>
