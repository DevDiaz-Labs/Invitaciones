---
// src/components/rsvp/RSVPEcoFloral.astro
const { data } = Astro.props;
---

<section class="py-12 px-6 bg-[#f4f7f4] text-[#4a584a] font-sans relative border-b border-[#cfdad0]">
  
  <!-- Leaf SVGs background accents -->
  <div class="absolute top-2 right-2 opacity-15 text-[#6c7a6c] pointer-events-none">
    <svg width="100" height="100" viewBox="0 0 100 100" fill="currentColor">
      <path d="M10 80 Q30 50 60 40 Q75 60 90 90 Q60 85 30 90 Z" />
      <path d="M50 40 Q65 15 80 10 Q75 30 70 50 Z" />
    </svg>
  </div>
  <div class="absolute bottom-2 left-2 opacity-15 text-[#6c7a6c] pointer-events-none transform rotate-180">
    <svg width="80" height="80" viewBox="0 0 100 100" fill="currentColor">
      <path d="M10 80 Q30 50 60 40 Q75 60 90 90 Q60 85 30 90 Z" />
    </svg>
  </div>

  <div class="max-w-md mx-auto relative z-10" x-data="{
    submitted: false,
    formData: {
      nombre: '',
      asistencia: 'si',
      adultos: 2,
      ninos: 0,
      dieta: 'ninguna'
    },
    submitForm() {
      console.log('Eco Floral RSVP:', this.formData);
      this.submitted = true;
    }
  }">
    <div class="text-center mb-8">
      <span class="text-xs uppercase tracking-widest text-[#6c7a6c] font-semibold font-mono">Confirmación Botánica</span>
      <h3 class="text-2xl font-serif text-[#3b473b] mt-1">Nuestra Boda / RSVP</h3>
      <p class="text-xs text-gray-500 mt-2">Cultivemos juntos un día especial. Confírmanos asistencia.</p>
    </div>

    <!-- Thanks view -->
    <div x-show="submitted" x-transition class="bg-white border border-[#cfdad0] p-8 rounded-2xl text-center shadow-lg">
      <div class="w-12 h-12 bg-[#f4f7f4] text-[#6c7a6c] border border-[#cfdad0] rounded-full flex items-center justify-center mx-auto text-xl mb-4">🌿</div>
      <h4 class="text-lg font-serif text-[#3b473b]">¡Confirmación Sembrada!</h4>
      <p class="text-xs text-gray-500 leading-relaxed mt-2" x-text="formData.asistencia === 'si' ? 'Registramos tus pases y preferencias de menú. ¡Nos vemos rodeados de naturaleza!' : 'Gracias por avisarnos con antelación. Te mandamos un abrazo fuerte.'"></p>
      <button type="button" @click="submitted = false" class="text-xs text-[#6c7a6c] underline font-mono tracking-wider mt-4">Modificar</button>
    </div>

    <!-- Form content -->
    <form x-show="!submitted" @submit.prevent="submitForm" class="bg-white border border-[#cfdad0] rounded-2xl p-6 shadow-md space-y-6 text-left">
      
      <div>
        <label class="block text-[10px] uppercase tracking-wider text-[#6c7a6c] font-semibold mb-2 font-mono">Nombre Completo o Familia</label>
        <input type="text" required x-model="formData.nombre" class="w-full bg-[#fcfdfc] border border-[#cfdad0] rounded-xl py-2.5 px-3.5 text-xs text-[#4a584a] focus:outline-none focus:border-[#6c7a6c]" placeholder="Ej. Familia Rivas" />
      </div>

      <div>
        <label class="block text-[10px] uppercase tracking-wider text-[#6c7a6c] font-semibold mb-3 font-mono">¿Podrás asistir?</label>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" @click="formData.asistencia = 'si'" :class="formData.asistencia === 'si' ? 'bg-[#6c7a6c] text-white' : 'bg-[#fcfdfc] border border-[#cfdad0] text-[#6c7a6c]'" class="py-2.5 rounded-xl text-xs font-mono font-bold transition-all">
            SÍ, ASISTIRÉ
          </button>
          <button type="button" @click="formData.asistencia = 'no'" :class="formData.asistencia === 'no' ? 'bg-[#6c7a6c] text-white' : 'bg-[#fcfdfc] border border-[#cfdad0] text-[#6c7a6c]'" class="py-2.5 rounded-xl text-xs font-mono font-bold transition-all">
            NO PODRÉ
          </button>
        </div>
      </div>

      <!-- Conditional fields -->
      <div x-show="formData.asistencia === 'si'" x-transition class="space-y-5 border-t border-[#cfdad0] pt-4">
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-[#6c7a6c] mb-1.5 font-mono">Adultos</label>
            <div class="flex items-center justify-between border border-[#cfdad0] rounded-xl px-2 py-1 bg-[#fcfdfc]">
              <button type="button" @click="if(formData.adultos > 1) formData.adultos--" class="text-[#6c7a6c] font-bold px-1.5 text-sm">-</button>
              <span class="text-xs text-[#4a584a] font-bold" x-text="formData.adultos"></span>
              <button type="button" @click="if(formData.adultos < 8) formData.adultos++" class="text-[#6c7a6c] font-bold px-1.5 text-sm">+</button>
            </div>
          </div>
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-[#6c7a6c] mb-1.5 font-mono">Niños</label>
            <div class="flex items-center justify-between border border-[#cfdad0] rounded-xl px-2 py-1 bg-[#fcfdfc]">
              <button type="button" @click="if(formData.ninos > 0) formData.ninos--" class="text-[#6c7a6c] font-bold px-1.5 text-sm">-</button>
              <span class="text-xs text-[#4a584a] font-bold" x-text="formData.ninos"></span>
              <button type="button" @click="if(formData.ninos < 8) formData.ninos++" class="text-[#6c7a6c] font-bold px-1.5 text-sm">+</button>
            </div>
          </div>
        </div>

        <!-- Dietary requirements selector with icons -->
        <div>
          <label class="block text-[10px] uppercase tracking-wider text-[#6c7a6c] mb-2.5 font-mono">Requerimiento Alimentario</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" @click="formData.dieta = 'ninguna'" :class="formData.dieta === 'ninguna' ? 'border-[#6c7a6c] bg-[#f4f7f4] text-[#3b473b]' : 'border-gray-200'" class="border rounded-xl p-2.5 text-left flex items-center gap-2 hover:bg-gray-50 transition-all">
              <span class="text-base">🍽️</span>
              <span class="text-[10px] font-semibold">Ninguno</span>
            </button>
            <button type="button" @click="formData.dieta = 'vegetariano'" :class="formData.dieta === 'vegetariano' ? 'border-[#6c7a6c] bg-[#f4f7f4] text-[#3b473b]' : 'border-gray-200'" class="border rounded-xl p-2.5 text-left flex items-center gap-2 hover:bg-gray-50 transition-all">
              <span class="text-base">🥗</span>
              <span class="text-[10px] font-semibold">Vegetariano</span>
            </button>
            <button type="button" @click="formData.dieta = 'glutenfree'" :class="formData.dieta === 'glutenfree' ? 'border-[#6c7a6c] bg-[#f4f7f4] text-[#3b473b]' : 'border-gray-200'" class="border rounded-xl p-2.5 text-left flex items-center gap-2 hover:bg-gray-50 transition-all">
              <span class="text-base">🌾</span>
              <span class="text-[10px] font-semibold">Sin Gluten</span>
            </button>
            <button type="button" @click="formData.dieta = 'vegano'" :class="formData.dieta === 'vegano' ? 'border-[#6c7a6c] bg-[#f4f7f4] text-[#3b473b]' : 'border-gray-200'" class="border rounded-xl p-2.5 text-left flex items-center gap-2 hover:bg-gray-50 transition-all">
              <span class="text-base">🌱</span>
              <span class="text-[10px] font-semibold">Vegano</span>
            </button>
          </div>
        </div>

      </div>

      <button type="submit" class="w-full bg-[#6c7a6c] text-white py-3 rounded-xl uppercase tracking-wider text-xs font-bold hover:bg-[#5c685c] transition-colors shadow-md shadow-emerald-800/10">
        Enviar Confirmación
      </button>

    </form>
  </div>
</section>
