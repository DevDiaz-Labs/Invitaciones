---
const { data } = Astro.props;
const titulo = data?.titulo || 'Confirmación';
const mensaje = data?.mensajeDespedida || 'Por favor, indícanos si asistirás.';
---

<section class="py-16 px-6 bg-[#e0e5ec]">
  <div class="max-w-md mx-auto p-10 rounded-[30px] bg-[#e0e5ec] shadow-[9px_9px_16px_rgb(163,177,198,0.6),-9px_-9px_16px_rgba(255,255,255,0.5)] border border-white/40">
    <h2 class="text-2xl font-semibold mb-2 text-center text-gray-600">{titulo}</h2>
    <p class="text-center text-gray-500 mb-8 text-sm">{mensaje}</p>

    <form class="space-y-8">
      <div>
        <label class="block text-xs uppercase tracking-widest text-gray-500 mb-3 ml-2">Nombre</label>
        <input type="text" class="w-full bg-[#e0e5ec] rounded-2xl px-5 py-4 text-gray-600 shadow-[inset_6px_6px_10px_0_rgba(163,177,198,0.5),inset_-6px_-6px_10px_0_rgba(255,255,255,0.8)] focus:outline-none" required />
      </div>

      <div class="flex gap-6">
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="attending" class="peer sr-only" checked />
          <div class="text-center py-4 rounded-2xl bg-[#e0e5ec] text-gray-500 shadow-[6px_6px_10px_0_rgba(163,177,198,0.5),-6px_-6px_10px_0_rgba(255,255,255,0.8)] peer-checked:shadow-[inset_4px_4px_8px_0_rgba(163,177,198,0.5),inset_-4px_-4px_8px_0_rgba(255,255,255,0.8)] peer-checked:text-indigo-500 font-medium transition-all">Asistiré</div>
        </label>
        <label class="flex-1 cursor-pointer">
          <input type="radio" name="attending" class="peer sr-only" />
          <div class="text-center py-4 rounded-2xl bg-[#e0e5ec] text-gray-500 shadow-[6px_6px_10px_0_rgba(163,177,198,0.5),-6px_-6px_10px_0_rgba(255,255,255,0.8)] peer-checked:shadow-[inset_4px_4px_8px_0_rgba(163,177,198,0.5),inset_-4px_-4px_8px_0_rgba(255,255,255,0.8)] peer-checked:text-red-400 font-medium transition-all">No asistiré</div>
        </label>
      </div>

      <button type="submit" class="w-full mt-8 py-4 rounded-2xl bg-[#e0e5ec] text-indigo-500 font-bold uppercase tracking-wider shadow-[6px_6px_10px_0_rgba(163,177,198,0.5),-6px_-6px_10px_0_rgba(255,255,255,0.8)] active:shadow-[inset_4px_4px_8px_0_rgba(163,177,198,0.5),inset_-4px_-4px_8px_0_rgba(255,255,255,0.8)] transition-all">
        Confirmar
      </button>
    </form>
  </div>
</section>
