---
const { data } = Astro.props;
const titulo = data?.titulo || 'Confirma tu Asistencia';
const mensaje = data?.mensajeDespedida || 'Celebremos juntos rodeados de naturaleza.';
---

<section class="py-16 px-6 bg-[#F9F6F0]">
  <div class="max-w-md mx-auto bg-white p-10 rounded-tl-[60px] rounded-br-[60px] shadow-sm border border-[#E8E1D5] relative overflow-hidden">
    <!-- Decoración hojas -->
    <div class="absolute top-0 right-0 w-24 h-24 bg-[#E5ECE4] rounded-bl-full opacity-60"></div>
    <div class="absolute bottom-0 left-0 w-32 h-32 bg-[#E5ECE4] rounded-tr-full opacity-60"></div>

    <div class="relative z-10">
      <h2 class="text-3xl font-serif mb-2 text-center text-[#4A5D4E]">{titulo}</h2>
      <p class="text-center text-[#8C9A8E] mb-8 italic">{mensaje}</p>

      <form class="space-y-6">
        <div>
          <label class="block text-sm text-[#4A5D4E] mb-1 font-medium">Nombre completo</label>
          <input type="text" class="w-full bg-[#F9F6F0] border border-[#E8E1D5] rounded-lg px-4 py-3 text-[#4A5D4E] focus:outline-none focus:border-[#4A5D4E] transition-colors" required />
        </div>

        <div>
          <label class="block text-sm text-[#4A5D4E] mb-2 font-medium">¿Nos acompañas?</label>
          <div class="space-y-2">
            <label class="flex items-center gap-3 cursor-pointer p-3 border border-[#E8E1D5] rounded-lg hover:bg-[#F9F6F0] transition-colors">
              <input type="radio" name="attending" class="w-4 h-4 accent-[#4A5D4E]" checked />
              <span class="text-[#4A5D4E]">Sí, estaré ahí</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer p-3 border border-[#E8E1D5] rounded-lg hover:bg-[#F9F6F0] transition-colors">
              <input type="radio" name="attending" class="w-4 h-4 accent-[#4A5D4E]" />
              <span class="text-[#4A5D4E]">Lamentablemente no</span>
            </label>
          </div>
        </div>

        <button type="submit" class="w-full bg-[#4A5D4E] hover:bg-[#3A4A3E] text-white font-medium py-4 rounded-lg shadow-md transition-colors mt-4">
          Enviar Respuesta
        </button>
      </form>
    </div>
  </div>
</section>
