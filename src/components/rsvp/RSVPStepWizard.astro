---
// src/components/rsvp/RSVPStepWizard.astro
const { data } = Astro.props;
---

<section class="py-12 px-6 bg-slate-900 text-white relative overflow-hidden font-sans">
  <!-- Decorative background glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-md mx-auto relative z-10" x-data="{
    step: 1,
    submitted: false,
    formData: {
      nombre: '',
      asistencia: 'si',
      adultos: 2,
      jovenes: 0,
      ninos: 0,
      dieta: '',
      cancion: ''
    },
    nextStep() {
      if (this.step === 1) {
        if (!this.formData.nombre.trim()) {
          alert('Por favor, ingresa tu nombre.');
          return;
        }
        if (this.formData.asistencia === 'no') {
          this.submitForm();
          return;
        }
        this.step = 2;
      } else if (this.step === 2) {
        this.step = 3;
      }
    },
    prevStep() {
      if (this.step > 1) {
        this.step--;
      }
    },
    submitForm() {
      console.log('RSVP Wizard Submitted:', this.formData);
      this.submitted = true;
    }
  }">
    <div class="text-center mb-8">
      <span class="text-xs uppercase tracking-widest text-indigo-400 font-semibold font-mono">Paso a Paso</span>
      <h2 class="text-3xl font-serif mt-1 text-white">{data?.titulo || 'Confirmación Asistencia'}</h2>
      <p class="text-gray-400 text-xs mt-2">Por favor, completa el proceso interactivo</p>
    </div>

    <!-- Progress Indicator -->
    <div x-show="!submitted" class="mb-8 bg-slate-800 rounded-full h-1.5 overflow-hidden flex">
      <div class="bg-indigo-500 h-full transition-all duration-300" :style="`width: ${step === 1 ? '33.3%' : step === 2 ? '66.6%' : '100%'}`"></div>
    </div>

    <!-- Thank you State -->
    <div x-show="submitted" x-transition.duration.500ms class="bg-slate-800/80 border border-slate-700 p-8 rounded-2xl text-center shadow-xl backdrop-blur">
      <div class="w-16 h-16 bg-indigo-500/10 text-indigo-400 rounded-full flex items-center justify-center mx-auto mb-4 border border-indigo-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-2xl font-serif text-white mb-2">¡Confirmación Enviada!</h3>
      <p class="text-gray-300 text-sm leading-relaxed" x-text="formData.asistencia === 'si' ? '¡Excelente! Te hemos registrado. Nos vemos pronto en el gran día.' : 'Lamentamos que no puedas acompañarnos, gracias por informarnos.'"></p>
    </div>

    <!-- Form Steps -->
    <div x-show="!submitted" class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 shadow-xl backdrop-blur-sm">
      
      <!-- STEP 1: Identification & Yes/No -->
      <div x-show="step === 1" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
        <div class="space-y-6">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 font-semibold mb-2 font-mono">Nombre Completo o Familia</label>
            <input type="text" x-model="formData.nombre" class="w-full bg-slate-900 border border-slate-700 rounded-xl py-3 px-4 text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm" placeholder="Ej. Familia Martínez" />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3 font-mono">¿Nos acompañarás?</label>
            <div class="grid grid-cols-2 gap-4">
              <button type="button" @click="formData.asistencia = 'si'" :class="formData.asistencia === 'si' ? 'border-indigo-500 bg-indigo-500/10 text-white' : 'border-slate-700 bg-slate-900 text-gray-400'" class="border rounded-xl p-4 flex flex-col items-center justify-center gap-2 hover:border-indigo-400 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold font-mono">SÍ, CON GUSTO</span>
              </button>

              <button type="button" @click="formData.asistencia = 'no'" :class="formData.asistencia === 'no' ? 'border-pink-500 bg-pink-500/10 text-white' : 'border-slate-700 bg-slate-900 text-gray-400'" class="border rounded-xl p-4 flex flex-col items-center justify-center gap-2 hover:border-pink-400 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold font-mono">NO PODRÉ IR</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 2: Attendance Breakdown -->
      <div x-show="step === 2" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
        <div class="space-y-5">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-indigo-400 font-mono mb-2">Desglose de Asistentes</h4>
          
          <!-- Adults Counter -->
          <div class="flex items-center justify-between bg-slate-900 p-3 rounded-xl border border-slate-800">
            <div>
              <span class="block text-sm font-semibold">Adultos</span>
              <span class="text-xs text-gray-500">A partir de 18 años</span>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" @click="if(formData.adultos > 0) formData.adultos--" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">-</button>
              <span class="w-6 text-center font-mono font-bold" x-text="formData.adultos"></span>
              <button type="button" @click="if(formData.adultos < 10) formData.adultos++" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">+</button>
            </div>
          </div>

          <!-- Youth Counter -->
          <div class="flex items-center justify-between bg-slate-900 p-3 rounded-xl border border-slate-800">
            <div>
              <span class="block text-sm font-semibold">Jóvenes</span>
              <span class="text-xs text-gray-500">De 12 a 17 años</span>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" @click="if(formData.jovenes > 0) formData.jovenes--" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">-</button>
              <span class="w-6 text-center font-mono font-bold" x-text="formData.jovenes"></span>
              <button type="button" @click="if(formData.jovenes < 10) formData.jovenes++" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">+</button>
            </div>
          </div>

          <!-- Children Counter -->
          <div class="flex items-center justify-between bg-slate-900 p-3 rounded-xl border border-slate-800">
            <div>
              <span class="block text-sm font-semibold">Niños</span>
              <span class="text-xs text-gray-500">De 2 a 11 años</span>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" @click="if(formData.ninos > 0) formData.ninos--" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">-</button>
              <span class="w-6 text-center font-mono font-bold" x-text="formData.ninos"></span>
              <button type="button" @click="if(formData.ninos < 10) formData.ninos++" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center font-bold text-lg text-gray-300">+</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 3: Extra Info -->
      <div x-show="step === 3" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
        <div class="space-y-6">
          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 font-semibold mb-2 font-mono">Restricciones Alimentarias / Alergias</label>
            <input type="text" x-model="formData.dieta" class="w-full bg-slate-900 border border-slate-700 rounded-xl py-3 px-4 text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm" placeholder="Ej. Veganos, celíacos o alergias" />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-gray-400 font-semibold mb-2 font-mono">¿Qué canción te haría bailar sin parar?</label>
            <input type="text" x-model="formData.cancion" class="w-full bg-slate-900 border border-slate-700 rounded-xl py-3 px-4 text-white focus:outline-none focus:border-indigo-500 transition-colors text-sm" placeholder="Nombre de la canción y artista" />
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3 mt-8">
        <button type="button" x-show="step > 1" @click="prevStep()" class="flex-1 bg-slate-700 hover:bg-slate-650 text-white font-bold py-3 px-4 rounded-xl text-sm transition-colors uppercase font-mono">
          Atrás
        </button>
        <button type="button" @click="step === 3 ? submitForm() : nextStep()" class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 px-4 rounded-xl text-sm transition-colors uppercase font-mono shadow-lg shadow-indigo-600/20">
          <span x-text="step === 3 ? 'Confirmar' : formData.asistencia === 'no' ? 'Enviar' : 'Siguiente'"></span>
        </button>
      </div>

    </div>
  </div>
</section>
