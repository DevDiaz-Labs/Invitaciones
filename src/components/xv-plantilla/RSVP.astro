---
// RSVP.astro
interface Props {
  data: {
    telefono: string;
    mensajeDefault: string;
    fechaLimite: string;
    urlCalendario?: string;
  };
}
const { data } = Astro.props;
---

<section
    class="py-24 md:py-32 px-6 bg-white text-center rounded-t-[5rem] shadow-[0_-20px_50px_rgba(0,0,0,0.05)] relative"
>
    <div class="max-w-xl mx-auto space-y-10 observe-me fade-up">
        <h3 class="font-serif text-4xl md:text-5xl text-[var(--gold)]">
            Confirma tu asistencia
        </h3>
        <p class="text-gray-400 italic text-base md:text-lg font-light">
            Será un honor contar con tu presencia. Por favor, confírmanos antes
            del {data.fechaLimite}.
        </p>

        <form id="rsvp-form" class="space-y-6">
            <input
                type="text"
                id="guest-name"
                placeholder="Tu nombre completo"
                required
                class="w-full bg-gray-50 p-5 md:p-6 rounded-3xl border border-gray-100 focus:ring-1 focus:ring-[var(--gold)] outline-none transition-all text-center text-base md:text-lg"
            />

            <div class="relative">
                <select
                    id="guest-count"
                    class="w-full bg-gray-50 p-5 md:p-6 rounded-3xl border border-gray-100 focus:ring-1 focus:ring-[var(--gold)] outline-none transition-all text-center text-base md:text-lg appearance-none cursor-pointer"
                >
                    <option value="1">1 Persona</option>
                    <option value="2">2 Personas</option>
                    <option value="3">3 Personas</option>
                    <option value="4">4 Personas</option>
                    <option value="4">Más de 4 personas</option>
                </select>
            </div>

            <div class="flex flex-col gap-4 mt-8">
                <button
                    type="submit"
                    class="w-full bg-[#c5a059] text-white py-5 md:py-6 rounded-3xl font-bold uppercase tracking-[0.2em] shadow-xl hover:bg-[#a3864a] transition-all transform hover:-translate-y-1 text-sm md:text-lg"
                >
                    Confirmar por WhatsApp
                </button>

                {data.urlCalendario && (
                <div class="mt-16 md:mt-20">
                    <a
                        href={data.urlCalendario}
                        target="_blank"
                        class="btn-gold px-8 md:px-12 py-4 md:py-5 rounded-full font-bold uppercase tracking-[0.2em] text-[10px] md:text-[11px] inline-block"
                    >
                        Agendar en mi Calendario
                    </a>
                </div>
                )}
            </div>
        </form>

        <div
            id="status-msg"
            class="hidden mt-4 text-[var(--gold)] italic animate-pulse"
        >
            Redirigiendo a WhatsApp...
        </div>
    </div>
</section>

<script define:vars={{ telefonoAPI: data.telefono, mensajeBase: data.mensajeDefault }}>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("rsvp-form");
        if (!form) return;

        form.addEventListener("submit", function (e) {
            e.preventDefault();

            const nameInput = document.getElementById(
                "guest-name",
            );
            const countInput = document.getElementById(
                "guest-count",
            );
            const statusMsg = document.getElementById("status-msg");

            const name = nameInput?.value;
            const count = countInput?.value;

            const text = `${mensajeBase} Nombre: ${name}. Personas: ${count}.`;
            // Cambiar aquí el número de teléfono con código de país
            const url = `https://wa.me/${telefonoAPI}?text=${encodeURIComponent(text)}`;

            if (statusMsg) statusMsg.classList.remove("hidden");

            setTimeout(() => {
                window.open(url, "_blank");
                if (statusMsg) statusMsg.classList.add("hidden");
            }, 1000);
        });
    });
</script>
