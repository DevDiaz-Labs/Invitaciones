---
// Regalos.astro
---

<section class="py-24 md:py-32 px-6 text-center bg-[var(--gold)]/5">
    <div class="max-w-4xl mx-auto space-y-16">
        <h3
            class="font-serif text-4xl text-[var(--gold)] italic observe-me fade-up"
        >
            Regalos
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-20">
            <!-- Lluvia de Sobres -->
            <div
                class="space-y-6 observe-me fade-up"
                style="transition-delay: 200ms;"
            >
                <h4
                    class="text-lg md:text-xl tracking-[0.3em] uppercase text-gray-600 font-light"
                >
                    El mejor regalo es que estés presente en este día tan
                    especial
                </h4>
                <p
                    class="text-gray-400 italic text-base md:text-lg leading-relaxed px-4"
                >
                    "Si deseas darme un regalo, puedes hacerlo en sobre cerrado"
                </p>
            </div>
        </div>
    </div>
</section>
