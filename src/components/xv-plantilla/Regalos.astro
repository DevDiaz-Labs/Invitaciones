---
// Regalos.astro
interface Props {
  data: {
    mensaje: string;
    opcionEfectivo?: boolean;
    opcionMesa?: boolean;
    mostrarDatosBancarios?: boolean;
    amazon_liverpool?: boolean;
    datosBancarios?: string;
  };
}
const { data } = Astro.props;
---

<section class="py-24 md:py-32 px-6 text-center bg-[var(--gold)]/5">
    <div class="max-w-4xl mx-auto space-y-16">
        <h3
            class="font-serif text-5xl text-[var(--gold)] italic observe-me fade-up"
        >
            Regalos
        </h3>

        <div class="space-y-12">
            <div
                class="space-y-6 observe-me fade-up"
                style="transition-delay: 200ms;"
            >
                <h4
                    class="text-lg md:text-xl tracking-[0.3em] uppercase text-gray-600 font-light"
                >
                    El mejor regalo es que estés presente en este día tan
                    especial
                </h4>
                <p
                    class="text-gray-500 italic text-base md:text-lg leading-relaxed px-4"
                >
                    "{data.mensaje}"
                </p>
            </div>

            <div class={`grid grid-cols-1 ${data.opcionEfectivo && data.opcionMesa ? 'md:grid-cols-2' : ''} gap-8 mt-12 max-w-3xl mx-auto`}>
                {data.opcionEfectivo && (
                    <div class="bg-white/40 backdrop-blur-sm p-8 rounded-2xl shadow-sm border border-[var(--gold)]/10 observe-me fade-up" style="transition-delay: 400ms;">
                        <div class="w-16 h-16 bg-[var(--gold)]/10 rounded-full flex items-center justify-center mx-auto mb-6">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--gold)]"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </div>
                        <h5 class="text-2xl font-serif text-gray-800 mb-3">Efectivo</h5>
                        <p class="text-gray-400 text-xs mb-6 uppercase tracking-widest leading-loose">Si deseas tener un detalle en efectivo, en el salón habrá un lugar reservado para ello.</p>
                        {data.mostrarDatosBancarios && data.datosBancarios && (
                            <div class="bg-white/80 p-5 rounded-xl text-center border border-[var(--gold)]/20 shadow-inner">
                                <p class="text-[10px] text-[var(--gold)] font-bold uppercase tracking-[0.2em] mb-3">Datos de Transferencia</p>
                                <p class="text-gray-700 font-mono text-sm whitespace-pre-line leading-relaxed">{data.datosBancarios}</p>
                            </div>
                        )}
                    </div>
                )}

                {data.opcionMesa && (
                    <div class="bg-white/40 backdrop-blur-sm p-8 rounded-2xl shadow-sm border border-[var(--gold)]/10 observe-me fade-up" style="transition-delay: 600ms;">
                         <div class="w-16 h-16 bg-[var(--gold)]/10 rounded-full flex items-center justify-center mx-auto mb-6">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--gold)]"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
                        </div>
                        <h5 class="text-2xl font-serif text-gray-800 mb-3">Mesa de Regalos</h5>
                        <p class="text-gray-400 text-xs mb-6 uppercase tracking-widest leading-loose">¡Muchas gracias por pensar en nosotros!</p>
                        {data.amazon_liverpool && (
                            <div class="border-t border-[var(--gold)]/10 pt-4 mt-2">
                                 <p class="text-[var(--gold)] font-serif text-lg italic">Liverpool / Amazon</p>
                                 <p class="text-gray-400 text-[10px] uppercase tracking-widest mt-1">Busca por el nombre del festejado en recepción</p>
                            </div>
                        )}
                    </div>
                )}
            </div>
        </div>
    </div>
</section>
