---
// Footer.astro
interface Props {
    data: {
        nombre: string;
        agradecimiento: string;
    };
}
const { data } = Astro.props;
---

<footer class="py-24 text-center relative overflow-hidden">
    <!-- Overlay sutil -->
    <div class="absolute inset-0 opacity-5">
        <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            class="w-full h-full"
        >
            <path fill="var(--gold)" d="M0,100 C30,50 70,50 100,100 Z"></path>
        </svg>
    </div>

    <div class="observe-me fade-up">
        <h2
            class="font-cursive text-6xl md:text-7xl text-[var(--gold)] mb-6 relative z-10"
        >
            {data.nombre}
        </h2>
        <p
            class="text-[9px] md:text-[10px] tracking-[0.8em] md:tracking-[1em] text-[var(--dark-text)]/40 uppercase relative z-10"
        >
            {data.agradecimiento}
        </p>
    </div>

    <!-- Crédito clicable -->
    <div
        class="mt-12 text-[10px] text-[var(--dark-text)]/30 tracking-[0.2em] uppercase relative z-10 px-4 observe-me fade-in-slow"
    >
        <a
            href="https://wa.me/527824127509?text=Hola,%20vi%20una%20invitación%20digital%20y%20me%20gustaría%20más%20información."
            target="_blank"
            class="hover:text-[var(--gold)] transition-colors duration-300"
        >
            Desarrollado por DevDiaz Labs
        </a>
    </div>
</footer>
