---
const { data, bgImage } = Astro.props;
---

{data && data.mostrar && data.imagenes && data.imagenes.length > 0 && (
  <section class="py-12 md:py-24 text-center overflow-hidden" style={bgImage ? `background-image: linear-gradient(rgba(255, 236, 251, 0.6), rgba(255, 236, 251, 0.6)), url('${bgImage}'); background-size: cover; background-position: center; background-repeat: no-repeat;` : ""}>
    <div class="max-w-4xl mx-auto px-4 drop-shadow-md observe-me fade-up">
      <h2 class="text-5xl md:text-6xl font-titulo text-center mb-10 tracking-wide" style="color: var(--gold);">
        {data.titulo || 'Galería'}
      </h2>
      
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-6 no-scrollbar touch-pan-x observe-me fade-up">
        {data.imagenes.map((img: string) => (
          <div class="snap-center shrink-0 w-72 md:w-80 h-96 rounded-xl overflow-hidden shadow-xl" style="border: 2px solid var(--color-principal)">
            <img src={img} alt="Nuestros Tiempos" class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* Ocultar scrollbar para un look más limpio */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE y Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
