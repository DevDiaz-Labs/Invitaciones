---
// Recepcion.astro
interface Props {
    data: {
        lugar: string;
        direccion: string;
        hora: string;
        urlMapa: string;
        urlMapaDirecto?: string;
    };
}
const { data } = Astro.props;
---

<section class="pt-24">
    <div class="max-w-3xl mx-auto text-center px-6 mb-16 observe-me fade-up">
        <h3 class="font-titulo text-4xl md:text-5xl mb-6 text-[var(--gold)]">
            Recepción
        </h3>
        <p
            class="text-lg md:text-xl font-light tracking-[0.2em] mb-2 uppercase text-[var(--dark-text)]"
        >
            {data.lugar}
        </p>
        <p class="text-[var(--dark-text)]/60 italic text-base md:text-lg">
            {data.direccion}<br />{data.hora}
        </p>
        {
            data.urlMapaDirecto && (
                <a
                    href={data.urlMapaDirecto}
                    target="_blank"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-[var(--gold)]/30 rounded-full text-[var(--gold)] hover:bg-[var(--gold)] hover:text-white transition-all text-sm uppercase tracking-widest font-bold shadow-sm"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <>
                            <circle cx="12" cy="10" r="3" />
                            <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z" />
                        </>
                    </svg>
                    Ver en Google Maps
                </a>
            )
        }
    </div>
    <div class="full-map-container observe-me fade-in-slow">
        <iframe
            src={data.urlMapa}
            class="w-full h-full min-h-[400px] grayscale-[30%] sepia-[15%] contrast-[110%]"
            style="border:0; min-height: 400px;"
            allowfullscreen=""
            loading="lazy"
        >
        </iframe>
    </div>
</section>

<style>
    .full-map-container {
        width: 100%;
        height: 400px;
    }
</style>
