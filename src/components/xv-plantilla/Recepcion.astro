---
// Recepcion.astro
interface Props {
  data: {
    lugar: string;
    direccion: string;
    hora: string;
    urlMapa: string;
  };
}
const { data } = Astro.props;
---

<section class="pt-24">
    <div class="max-w-3xl mx-auto text-center px-6 mb-16 observe-me fade-up">
        <h3 class="font-serif text-4xl md:text-5xl mb-6 text-[var(--gold)]">Fiesta</h3>
        <p
            class="text-lg md:text-xl font-light tracking-[0.2em] mb-2 uppercase text-[var(--dark-text)]"
        >
            {data.lugar}
        </p>
        <p class="text-[var(--dark-text)]/60 italic text-base md:text-lg">
            {data.direccion}<br />{data.hora}
        </p>
    </div>
    <div class="full-map-container observe-me fade-in-slow">
        <iframe
            src={data.urlMapa}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
        >
        </iframe>
    </div>
</section>

<style>
    .full-map-container {
        width: 100%;
        height: 400px;
        filter: sepia(15%) contrast(1.1);
    }
</style>
