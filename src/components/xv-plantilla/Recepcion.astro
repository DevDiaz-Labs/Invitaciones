---
// Recepcion.astro
---

<section class="pt-24 bg-white">
    <div class="max-w-3xl mx-auto text-center px-6 mb-16 observe-me fade-up">
        <h3 class="font-serif text-4xl md:text-5xl mb-6">Fiesta</h3>
        <p
            class="text-lg md:text-xl font-light tracking-[0.2em] mb-2 uppercase"
        >
            Nombre del salon
        </p>
        <p class="text-gray-400 italic text-base md:text-lg">
            nombre del lugar
        </p>
    </div>
    <div class="full-map-container observe-me fade-in-slow">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4442.971636790663!2d-97.45759865650655!3d20.543951504202933!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85da6ab6d49c8145%3A0x29bffe5fffaef4d4!2sSal%C3%B3n%20de%20Eventos%20Robert's%20Palace!5e0!3m2!1ses!2smx!4v1773426590753!5m2!1ses!2smx"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
        >
        </iframe>
    </div>
</section>

<style>
    .full-map-container {
        width: 100%;
        height: 400px;
        filter: sepia(15%) contrast(1.1);
    }
</style>
