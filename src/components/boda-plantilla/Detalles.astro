---
const { data } = Astro.props;
---

<section class="py-32 px-6 bg-white relative">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="font-handwriting text-6xl md:text-8xl text-boho-eucalipto mb-24">
      El Momento
    </h2>
    <div class="flex flex-col md:flex-row justify-between items-start gap-16 md:gap-8">
      <!-- Ceremonia -->
      <div class="w-full md:w-1/2 flex flex-col items-center border-b-2 md:border-b-0 md:border-r-2 border-boho-eucalipto/20 pb-12 md:pb-0 md:pr-8">
        <h3 class="text-sm md:text-base tracking-[0.4em] text-boho-dorado uppercase mb-6 font-sans font-bold">Ceremonia</h3>
        <p class="text-5xl font-light text-gray-800 mb-6 font-serif">{data.ceremonia.hora}</p>
        <p class="text-3xl font-normal text-boho-terracota mb-4">{data.ceremonia.lugar}</p>
        <p class="text-xl text-gray-500 italic mb-10 max-w-xs">{data.ceremonia.direccion}</p>
        <a href={data.ceremonia.urlMapa} target="_blank" rel="noopener noreferrer" class="text-boho-eucalipto border-b border-boho-eucalipto pb-1 uppercase tracking-widest text-xs font-bold hover:text-boho-terracota hover:border-boho-terracota transition-all duration-300">
          Ubicación en Mapa
        </a>
      </div>

      <!-- Recepción -->
      <div class="w-full md:w-1/2 flex flex-col items-center md:pl-8">
        <h3 class="text-sm md:text-base tracking-[0.4em] text-boho-dorado uppercase mb-6 font-sans font-bold">Recepción</h3>
        <p class="text-5xl font-light text-gray-800 mb-6 font-serif">{data.recepcion.hora}</p>
        <p class="text-3xl font-normal text-boho-eucalipto mb-4">{data.recepcion.lugar}</p>
        <p class="text-xl text-gray-500 italic mb-10 max-w-xs">{data.recepcion.direccion}</p>
        <a href={data.recepcion.urlMapa} target="_blank" rel="noopener noreferrer" class="text-boho-terracota border-b border-boho-terracota pb-1 uppercase tracking-widest text-xs font-bold hover:text-boho-eucalipto hover:border-boho-eucalipto transition-all duration-300">
          Ubicación en Mapa
        </a>
      </div>
    </div>
    
    <div class="mt-32 text-3xl md:text-4xl text-gray-700 italic max-w-3xl mx-auto font-light leading-snug">
      "{data.notaEmocional}"
    </div>

    <!-- Agendar Evento (Calendar) -->
    {data.calendario && (
      <div class="mt-20 pt-16 border-t border-boho-eucalipto/20 flex flex-col items-center">
        <h4 class="font-sans tracking-[0.2em] uppercase text-boho-terracota text-sm mb-8 font-bold">Agendar fecha</h4>
        <div class="flex flex-col sm:flex-row gap-6">
          <!-- Google Calendar -->
          <a href={data.calendario.google} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 bg-white border border-gray-200 shadow-sm text-gray-700 px-8 py-3 rounded-full hover:shadow-md hover:border-boho-dorado hover:text-boho-dorado transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span class="font-semibold text-sm">Google Calendar</span>
          </a>
          <!-- Apple Calendar -->
          <a href={data.calendario.apple} download="nuestra-boda.ics" class="flex items-center justify-center gap-3 bg-white border border-gray-200 shadow-sm text-gray-700 px-8 py-3 rounded-full hover:shadow-md hover:border-boho-eucalipto hover:text-boho-eucalipto transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm3.11 14.86c-1.3.116-2.583-.554-3.414-1.503-.907.954-2.298 1.62-3.454 1.5l-.2-.02c-2.316-.275-3.66-2.614-3-4.912.56-1.954 2.128-3.42 4.148-3.792.81-.15 1.58-.04 2.23.238.16-.893.7-1.63 1.48-1.986.74-.32 1.63-.26 2.33.19.86.536 1.25 1.55 1.05 2.52-.39 2.05-1.54 3.99-3.23 4.96.65.62 1.5.9 2.37.76.6-.095 1.06-.525 1.25-1.095.055-.17.205-.29.38-.29h.67c.28 0 .48.275.4.545-.375 1.15-1.39 2.35-2.69 2.895z" />
            </svg>
            <span class="font-semibold text-sm">Apple / iOS</span>
          </a>
        </div>
      </div>
    )}
  </div>
</section>
