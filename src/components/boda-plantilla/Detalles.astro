---
import CalendarioBoho from "../calendario/CalendarioBoho.astro";

const { data } = Astro.props;
---

<section class="py-32 px-6 bg-white relative">
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="font-handwriting text-6xl md:text-8xl text-boho-eucalipto mb-24">
      El Momento
    </h2>
    <div class="flex flex-col md:flex-row justify-between items-start gap-16 md:gap-8">
      <!-- Ceremonia -->
      <div class="w-full md:w-1/2 flex flex-col items-center border-b-2 md:border-b-0 md:border-r-2 border-boho-eucalipto/20 pb-12 md:pb-0 md:pr-8">
        <h3 class="text-sm md:text-base tracking-[0.4em] text-boho-dorado uppercase mb-6 font-sans font-bold">Ceremonia</h3>
        <p class="text-5xl font-light text-gray-800 mb-6 font-serif">{data.ceremonia.hora}</p>
        <p class="text-3xl font-normal text-boho-terracota mb-4">{data.ceremonia.lugar}</p>
        <p class="text-xl text-gray-500 italic mb-10 max-w-xs">{data.ceremonia.direccion}</p>
        <a href={data.ceremonia.urlMapa} target="_blank" rel="noopener noreferrer" class="text-boho-eucalipto border-b border-boho-eucalipto pb-1 uppercase tracking-widest text-xs font-bold hover:text-boho-terracota hover:border-boho-terracota transition-all duration-300">
          Ubicación en Mapa
        </a>
      </div>

      <!-- Recepción -->
      <div class="w-full md:w-1/2 flex flex-col items-center md:pl-8">
        <h3 class="text-sm md:text-base tracking-[0.4em] text-boho-dorado uppercase mb-6 font-sans font-bold">Recepción</h3>
        <p class="text-5xl font-light text-gray-800 mb-6 font-serif">{data.recepcion.hora}</p>
        <p class="text-3xl font-normal text-boho-eucalipto mb-4">{data.recepcion.lugar}</p>
        <p class="text-xl text-gray-500 italic mb-10 max-w-xs">{data.recepcion.direccion}</p>
        <a href={data.recepcion.urlMapa} target="_blank" rel="noopener noreferrer" class="text-boho-terracota border-b border-boho-terracota pb-1 uppercase tracking-widest text-xs font-bold hover:text-boho-eucalipto hover:border-boho-eucalipto transition-all duration-300">
          Ubicación en Mapa
        </a>
      </div>
    <!-- Agendar Evento (Calendar) -->
    <CalendarioBoho calendario={data.calendario} />
  </div>
</section>
