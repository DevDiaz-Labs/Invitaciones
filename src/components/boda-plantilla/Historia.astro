---
const { data } = Astro.props;
---

<section id="historia" class="py-24 px-6 md:px-12 bg-boho-arena/20 relative">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-16 relative z-10">
    <div class="w-full md:w-1/2 flex justify-center">
       <div class="relative w-full max-w-md">
          <div class="absolute inset-0 bg-boho-terracota transform -translate-x-6 translate-y-6"></div>
          <img src={data.imagenContexto} alt="Nuestra Historia" class="relative z-10 w-full h-[600px] object-cover border-8 border-white shadow-2xl" />
       </div>
    </div>
    <div class="w-full md:w-1/2 text-center md:text-left mt-12 md:mt-0">
      <h2 class="font-handwriting text-6xl md:text-8xl text-boho-terracota mb-8 drop-shadow-sm transform -rotate-2">
        {data.titulo}
      </h2>
      <p class="text-xl md:text-3xl leading-relaxed text-gray-800 font-light mt-4">
        {data.texto}
      </p>
    </div>
  </div>
</section>
