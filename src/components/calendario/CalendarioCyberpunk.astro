---
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}
const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---
{calendario && (google || apple || outlook) && (
  <div class="cyber-wrap">
    <h4 class="cyber-title">SYSTEM_EVENT</h4>
    <div class="cyber-buttons">
      {google && <a href={google} class="cyber-btn" data-text="GOOGLE">GOOGLE</a>}
      {apple && <a href={apple} class="cyber-btn" data-text="APPLE">APPLE</a>}
      {outlook && <a href={outlook} class="cyber-btn" data-text="OUTLOOK">OUTLOOK</a>}
    </div>
  </div>
)}
<style>
  .cyber-wrap {
    background: #0f0f13;
    padding: 2rem;
    border: 1px solid #0ff;
    box-shadow: inset 0 0 10px #0ff;
    text-align: center;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .cyber-title {
    color: #0ff;
    text-shadow: 0 0 5px #0ff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.2em;
  }
  .cyber-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .cyber-btn {
    position: relative;
    width: 100%;
    max-width: 250px;
    background: transparent;
    color: #f0f;
    padding: 0.5rem 1rem;
    border: 1px solid #f0f;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 2px;
    transition: all 0.2s;
  }
  .cyber-btn:hover {
    background: #f0f;
    color: #000;
    box-shadow: 0 0 15px #f0f;
  }
</style>
