---
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}
const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---
{calendario && (google || apple || outlook) && (
  <div class="retro-wrap">
    <h4 class="retro-title">SAVE THE DATE</h4>
    <div class="retro-buttons">
      {google && <a href={google} class="retro-btn">Google</a>}
      {apple && <a href={apple} class="retro-btn">Apple</a>}
      {outlook && <a href={outlook} class="retro-btn">Outlook</a>}
    </div>
  </div>
)}
<style>
  .retro-wrap {
    background: #ffcc00;
    padding: 2rem;
    border: 4px solid #000;
    box-shadow: 8px 8px 0px #000;
    text-align: center;
    font-family: 'Courier New', Courier, monospace;
    margin-bottom: 2rem;
  }
  .retro-title {
    font-size: 1.5rem;
    font-weight: bold;
    color: #000;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .retro-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .retro-btn {
    width: 100%;
    max-width: 250px;
    background: #fff;
    color: #000;
    padding: 0.5rem 1rem;
    border: 2px solid #000;
    box-shadow: 4px 4px 0px #000;
    font-weight: bold;
    text-decoration: none;
    transition: all 0.1s;
  }
  .retro-btn:active {
    transform: translate(4px, 4px);
    box-shadow: 0px 0px 0px #000;
  }
</style>
