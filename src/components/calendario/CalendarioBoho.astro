---
// src/components/calendario/CalendarioBoho.astro
interface Props {
  calendario: {
    google?: string;
    apple?: string;
  };
  bgImage?: string;
  bgColor?: string;
  bgSize?: string;
  bgRepeat?: string;
  bgPosition?: string;
}

const { calendario, bgImage, bgColor = "transparent", bgSize = "cover", bgRepeat = "no-repeat", bgPosition = "center" } = Astro.props;
const { google, apple } = calendario || {};
---

{calendario && (google || apple) && (
  <div class="pt-12 pb-12 flex flex-col items-center w-full" style={`background-color: ${bgColor}; ${bgImage ? `background-image: url('${bgImage}'); background-size: ${bgSize}; background-position: ${bgPosition}; background-repeat: ${bgRepeat};` : ''}`}>
    <h4 class="text-xl md:text-2xl uppercase tracking-[0.4em] mb-8 font-light text-center" style="color: var(--gold, #c5a059);">Agendar fecha</h4>
    <div class="flex flex-col sm:flex-row gap-6">
      <!-- Google Calendar -->
      {google && (
        <a href={google} target="_blank" rel="noopener noreferrer" class="hover-gold flex items-center justify-center gap-3 bg-white border border-gray-200 shadow-sm text-gray-700 px-8 py-3 rounded-full hover:shadow-md transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span class="font-semibold text-sm font-sans uppercase tracking-widest text-[10px]">Google Calendar</span>
        </a>
      )}
      <!-- Apple Calendar -->
      {apple && (
        <a href={apple} class="hover-gold flex items-center justify-center gap-3 bg-white border border-gray-200 shadow-sm text-gray-700 px-8 py-3 rounded-full hover:shadow-md transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.17c.66-.81 1.11-1.93.99-3.06-.96.04-2.13.64-2.82 1.45-.6.69-1.12 1.84-.98 2.94 1.07.08 2.15-.52 2.81-1.33z"/>
          </svg>
          <span class="font-semibold text-sm font-sans uppercase tracking-widest text-[10px]">Apple / iOS</span>
        </a>
      )}
    </div>
  </div>
)}

<style>
  .hover-gold:hover {
    border-color: var(--gold, #c5a059) !important;
    color: var(--gold, #c5a059) !important;
  }
</style>
