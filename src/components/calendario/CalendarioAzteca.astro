          <rect x="60" y="12" width="4" height="4"/>
        </g>
      </svg>
    </div>

    <div class="ca-inner">
      <!-- Sun symbol -->
      <div class="ca-sun-wrap">
        <svg viewBox="0 0 60 60" class="ca-sun" xmlns="http://www.w3.org/2000/svg">
          <circle cx="30" cy="30" r="12" fill="#e8890a"/>
          <circle cx="30" cy="30" r="8" fill="#c44b00"/>
          <circle cx="30" cy="30" r="4" fill="#e8890a"/>
          <!-- Sun rays -->
          <g stroke="#e8890a" stroke-width="2" stroke-linecap="square">
            <line x1="30" y1="4" x2="30" y2="12"/>
            <line x1="30" y1="48" x2="30" y2="56"/>
            <line x1="4" y1="30" x2="12" y2="30"/>
            <line x1="48" y1="30" x2="56" y2="30"/>
            <line x1="11.5" y1="11.5" x2="17" y2="17"/>
            <line x1="43" y1="43" x2="48.5" y2="48.5"/>
            <line x1="48.5" y1="11.5" x2="43" y2="17"/>
            <line x1="17" y1="43" x2="11.5" y2="48.5"/>
          </g>
          <!-- Diamond accents on rays -->
          <g fill="#f8c040">
            <polygon points="30,2 31.5,5 30,8 28.5,5"/>
            <polygon points="30,52 31.5,55 30,58 28.5,55"/>
            <polygon points="2,30 5,31.5 8,30 5,28.5"/>
            <polygon points="52,30 55,31.5 58,30 55,28.5"/>
          </g>
        </svg>
      </div>

      <h4 class="ca-title">MARCA LA FECHA</h4>
      <div class="ca-subtitle-row">
        <span class="ca-line-deco"></span>
        <span class="ca-subtitle">Agenda el evento</span>
        <span class="ca-line-deco"></span>
      </div>

      <div class="ca-buttons">
        {google && (
          <a href={google} target="_blank" rel="noopener noreferrer" class="ca-btn ca-btn-main">
            <div class="ca-btn-corner ca-corner-tl"></div>
            <div class="ca-btn-corner ca-corner-tr"></div>
            <div class="ca-btn-corner ca-corner-bl"></div>
            <div class="ca-btn-corner ca-corner-br"></div>
            <svg viewBox="0 0 24 24" class="ca-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Google Calendar
          </a>
        )}
        {apple && (
          <a href={apple} class="ca-btn ca-btn-alt">
            <svg viewBox="0 0 24 24" class="ca-icon" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            Apple Calendar
          </a>
        )}
        {outlook && (
          <a href={outlook} target="_blank" rel="noopener noreferrer" class="ca-btn ca-btn-alt">
            <svg viewBox="0 0 24 24" class="ca-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
              <path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/>
            </svg>
            Outlook
          </a>
        )}
      </div>
    </div>

    <!-- Aztec geometric border bottom -->
    <div class="ca-border-bottom">
      <svg viewBox="0 0 320 24" class="ca-border-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <rect width="320" height="24" fill="#1a0a00"/>
        <g fill="#c44b00" opacity="0.9">
          <rect x="0" y="16" width="8" height="8"/>
          <rect x="8" y="8" width="8" height="8"/>
          <rect x="16" y="16" width="8" height="8"/>
          <rect x="24" y="8" width="8" height="8"/>
          <rect x="32" y="16" width="8" height="8"/>
          <rect x="40" y="8" width="8" height="8"/>
          <rect x="48" y="16" width="8" height="8"/>
          <rect x="56" y="8" width="8" height="8"/>
          <rect x="64" y="16" width="8" height="8"/>
          <rect x="72" y="8" width="8" height="8"/>
          <rect x="80" y="16" width="8" height="8"/>
          <rect x="88" y="8" width="8" height="8"/>
          <rect x="96" y="16" width="8" height="8"/>
          <rect x="104" y="8" width="8" height="8"/>
          <rect x="112" y="16" width="8" height="8"/>
          <rect x="120" y="8" width="8" height="8"/>
          <rect x="128" y="16" width="8" height="8"/>
          <rect x="136" y="8" width="8" height="8"/>
          <rect x="144" y="16" width="8" height="8"/>
          <rect x="152" y="8" width="8" height="8"/>
          <rect x="160" y="16" width="8" height="8"/>
