<style>
  .ca-wrap {
    position: relative;
    background: #2d1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }
  .ca-border-top, .ca-border-bottom {
    width: 100%;
    line-height: 0;
  }
  .ca-border-svg { width: 100%; display: block; height: 24px; }

  .ca-inner {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 320px;
    box-sizing: border-box;
  }
  .ca-sun-wrap {
    margin-bottom: 1.4rem;
  }
  .ca-sun {
    width: 64px;
    height: 64px;
  }
  .ca-title {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #e8890a;
    letter-spacing: 0.3em;
    margin: 0 0 0.8rem;
    text-align: center;
  }
  .ca-subtitle-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .ca-line-deco {
    display: block;
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c44b00, transparent);
  }
  .ca-subtitle {
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.7rem;
    color: #a0602a;
    letter-spacing: 0.2em;
    font-weight: 300;
    text-transform: uppercase;
  }
  .ca-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }
  .ca-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.9rem 1.5rem;
    font-family: 'Josefin Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .ca-btn-main {
    background: #c44b00;
    color: #fdf0d0;
    border: none;
    box-shadow: 0 4px 12px rgba(196,75,0,0.4), inset 0 1px 0 rgba(255,255,255,0.1);
  }
  .ca-btn-main:hover {
    background: #e05a00;
    box-shadow: 0 6px 18px rgba(196,75,0,0.5);
    transform: translateY(-1px);
  }
  /* Corner ornaments for main button */
  .ca-btn-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: #f8c040;
    border-style: solid;
    opacity: 0.7;
  }
  .ca-corner-tl { top: 3px; left: 3px; border-width: 2px 0 0 2px; }
  .ca-corner-tr { top: 3px; right: 3px; border-width: 2px 2px 0 0; }
  .ca-corner-bl { bottom: 3px; left: 3px; border-width: 0 0 2px 2px; }
  .ca-corner-br { bottom: 3px; right: 3px; border-width: 0 2px 2px 0; }

  .ca-btn-alt {
    background: transparent;
    color: #e8890a;
    border: 1px solid rgba(232,137,10,0.4);
  }
  .ca-btn-alt:hover {
    background: rgba(196,75,0,0.1);
    border-color: rgba(232,137,10,0.7);
    transform: translateY(-1px);
  }
  .ca-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
</style>
