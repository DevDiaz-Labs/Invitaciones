          <rect x="144" y="0" width="8" height="8"/>
          <rect x="152" y="8" width="8" height="8"/>
          <rect x="160" y="0" width="8" height="8"/>
          <rect x="168" y="8" width="8" height="8"/>
          <rect x="176" y="0" width="8" height="8"/>
          <rect x="184" y="8" width="8" height="8"/>
          <rect x="192" y="0" width="8" height="8"/>
          <rect x="200" y="8" width="8" height="8"/>
          <rect x="208" y="0" width="8" height="8"/>
          <rect x="216" y="8" width="8" height="8"/>
          <rect x="224" y="0" width="8" height="8"/>
          <rect x="232" y="8" width="8" height="8"/>
          <rect x="240" y="0" width="8" height="8"/>
          <rect x="248" y="8" width="8" height="8"/>
          <rect x="256" y="0" width="8" height="8"/>
