---
// src/components/calendario/CalendarioOscuro.astro
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}

const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

{calendario && (google || apple || outlook) && (
  <div class="co-wrap">
    <!-- Top golden border ornament -->
    <div class="co-ornament-top">
      <svg viewBox="0 0 300 20" class="co-orn-svg" xmlns="http://www.w3.org/2000/svg">
        <line x1="0" y1="10" x2="110" y2="10" stroke="#c9a84c" stroke-width="0.5" opacity="0.6"/>
        <polygon points="130,10 120,5 122,10 120,15" fill="#c9a84c" opacity="0.7"/>
        <polygon points="135,3 137,10 135,17 145,10" fill="none" stroke="#c9a84c" stroke-width="0.8" opacity="0.7"/>
        <polygon points="165,3 163,10 165,17 155,10" fill="none" stroke="#c9a84c" stroke-width="0.8" opacity="0.7"/>
        <polygon points="170,10 180,5 178,10 180,15" fill="#c9a84c" opacity="0.7"/>
        <line x1="190" y1="10" x2="300" y2="10" stroke="#c9a84c" stroke-width="0.5" opacity="0.6"/>
      </svg>
    </div>

    <div class="co-content">
      <p class="co-eyebrow">— Reserva este momento —</p>
      <h4 class="co-title">Agenda la Fecha</h4>
      <p class="co-sub">Una velada que no olvidarás</p>

      <div class="co-divider">
        <span class="co-diamond">◆</span>
      </div>

      <div class="co-buttons">
        {google && (
          <a href={google} target="_blank" rel="noopener noreferrer" class="co-btn co-btn-gold">
            <svg viewBox="0 0 24 24" class="co-icon" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Google Calendar
          </a>
        )}
        {apple && (
          <a href={apple} class="co-btn co-btn-outline">
            <svg viewBox="0 0 24 24" class="co-icon" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            Apple Calendar
          </a>
        )}
        {outlook && (
          <a href={outlook} target="_blank" rel="noopener noreferrer" class="co-btn co-btn-outline">
            <svg viewBox="0 0 24 24" class="co-icon" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
              <path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/>
            </svg>
            Outlook
          </a>
        )}
      </div>
    </div>

    <!-- Bottom golden border ornament -->
    <div class="co-ornament-bottom">
      <svg viewBox="0 0 300 20" class="co-orn-svg" xmlns="http://www.w3.org/2000/svg">
        <line x1="0" y1="10" x2="120" y2="10" stroke="#c9a84c" stroke-width="0.5" opacity="0.6"/>
        <circle cx="150" cy="10" r="4" fill="none" stroke="#c9a84c" stroke-width="0.8" opacity="0.7"/>
        <circle cx="150" cy="10" r="1.5" fill="#c9a84c" opacity="0.7"/>
        <line x1="180" y1="10" x2="300" y2="10" stroke="#c9a84c" stroke-width="0.5" opacity="0.6"/>
      </svg>
    </div>
  </div>
)}

<style>
  .co-wrap {
    position: relative;
    background: #0e0e0e;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    border-top: 1px solid rgba(201,168,76,0.15);
    border-bottom: 1px solid rgba(201,168,76,0.15);
  }
  .co-ornament-top, .co-ornament-bottom {
    width: 100%;
    max-width: 300px;
  }
  .co-ornament-top { margin-bottom: 1.8rem; }
  .co-ornament-bottom { margin-top: 1.8rem; }
  .co-orn-svg { width: 100%; }

  .co-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 300px;
  }
  .co-eyebrow {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.8rem;
    font-style: italic;
    color: #c9a84c;
    letter-spacing: 0.12em;
    margin: 0 0 0.5rem;
    text-align: center;
    opacity: 0.85;
  }
  .co-title {
    font-family: 'Cinzel', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #f0e6c8;
    letter-spacing: 0.15em;
    margin: 0 0 0.3rem;
    text-align: center;
    text-transform: uppercase;
  }
  .co-sub {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(240,230,200,0.55);
    margin: 0 0 1.2rem;
    text-align: center;
    font-style: italic;
  }
  .co-divider {
    margin-bottom: 1.6rem;
  }
  .co-diamond {
    color: #c9a84c;
    font-size: 0.7rem;
    opacity: 0.7;
  }
  .co-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
  }
  .co-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1.5rem;
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  .co-btn-gold {
    background: linear-gradient(135deg, #c9a84c, #e6c96a, #c9a84c);
    color: #0e0e0e;
    border: none;
    box-shadow: 0 2px 12px rgba(201,168,76,0.25);
  }
  .co-btn-gold:hover {
    box-shadow: 0 4px 20px rgba(201,168,76,0.45);
    transform: translateY(-1px);
  }
  .co-btn-outline {
    background: transparent;
    color: #c9a84c;
    border: 1px solid rgba(201,168,76,0.4);
  }
  .co-btn-outline:hover {
    background: rgba(201,168,76,0.07);
    border-color: rgba(201,168,76,0.7);
    transform: translateY(-1px);
  }
  .co-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
</style>
