---
// src/components/calendario/CalendarioSTD.astro
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}

const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---

<!-- Include Material Symbols Outlined stylesheet locally so icons render reliably -->
<link
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
  rel="stylesheet"
/>

{calendario && (google || apple || outlook) && (
  <div class="py-16 px-4 bg-[#1A0F11] text-[#F5EBE0] flex flex-col items-center w-full border-t border-[#B76E79]/20">
    <h4 class="font-serif italic text-2xl md:text-3xl text-[#B76E79] tracking-wide mb-8">Save the Date</h4>
    
    <div class="flex flex-col gap-4 w-full justify-center px-4 max-w-xs">
      {google && (
        <a
          href={google}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full bg-gradient-to-r from-[#B76E79] to-[#c2848e] text-white px-6 py-3 rounded-md font-semibold text-xs uppercase tracking-widest shadow-lg hover:shadow-xl hover:opacity-95 transition-all flex items-center justify-center gap-2 border border-[#D4A373]/20"
        >
          <span class="material-symbols-outlined text-[16px]">calendar_today</span>
          Google Calendar
        </a>
      )}
      
      {outlook && (
        <a
          href={outlook}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full bg-transparent border border-[#D4A373]/40 text-[#F5EBE0] px-6 py-3 rounded-md font-semibold text-xs uppercase tracking-widest hover:bg-[#D4A373]/10 transition-all flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined text-[16px]">event</span>
          Outlook
        </a>
      )}
      
      {apple && (
        <a
          href={apple}
          class="w-full bg-transparent border border-[#D4A373]/40 text-[#F5EBE0] px-6 py-3 rounded-md font-semibold text-xs uppercase tracking-widest hover:bg-[#D4A373]/10 transition-all flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined text-[16px]">calendar_month</span>
          Apple Calendar
        </a>
      )}
    </div>
  </div>
)}
