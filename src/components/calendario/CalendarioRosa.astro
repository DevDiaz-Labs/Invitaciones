---
// src/components/calendario/CalendarioRosa.astro
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}

const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---

<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Nunito:wght@400;600&display=swap" rel="stylesheet" />

{calendario && (google || apple || outlook) && (
  <div class="cr-wrap">
    <div class="cr-petals">
      <svg class="cr-petal cr-p1" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="30" cy="30" rx="12" ry="28" fill="#f9c8d4" opacity="0.6" transform="rotate(20 30 30)"/>
      </svg>
      <svg class="cr-petal cr-p2" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="30" cy="30" rx="12" ry="28" fill="#f9c8d4" opacity="0.5" transform="rotate(-30 30 30)"/>
      </svg>
      <svg class="cr-petal cr-p3" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
        <ellipse cx="30" cy="30" rx="12" ry="28" fill="#fbb6c8" opacity="0.4" transform="rotate(60 30 30)"/>
      </svg>
    </div>

    <div class="cr-heart-deco">♡</div>
    <h4 class="cr-title">Guarda la fecha</h4>
    <p class="cr-subtitle">¡No te lo puedes perder!</p>

    <div class="cr-buttons">
      {google && (
        <a href={google} target="_blank" rel="noopener noreferrer" class="cr-btn cr-btn-google">
          <span class="cr-btn-heart">♥</span>
          <svg viewBox="0 0 24 24" class="cr-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Google Calendar
        </a>
      )}
      {apple && (
        <a href={apple} class="cr-btn cr-btn-apple">
          <span class="cr-btn-heart">♥</span>
          <svg viewBox="0 0 24 24" class="cr-icon" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Apple Calendar
        </a>
      )}
      {outlook && (
        <a href={outlook} target="_blank" rel="noopener noreferrer" class="cr-btn cr-btn-outlook">
          <span class="cr-btn-heart">♥</span>
          <svg viewBox="0 0 24 24" class="cr-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
            <path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/>
          </svg>
          Outlook
        </a>
      )}
    </div>
    <div class="cr-footer-heart">♡ ♡ ♡</div>
  </div>
)}

<style>
  .cr-wrap {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #fff0f4 0%, #ffe4ee 50%, #ffd6e7 100%);
    padding: 3rem 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }
  .cr-petals {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }
  .cr-petal {
    position: absolute;
    width: 80px;
    height: 80px;
  }
  .cr-p1 { top: -20px; left: -20px; transform: rotate(15deg); }
  .cr-p2 { bottom: -15px; right: -15px; transform: rotate(-40deg); }
  .cr-p3 { top: 30%; right: -25px; transform: rotate(70deg); }

  .cr-heart-deco {
    font-size: 2.2rem;
    color: #e8749a;
    margin-bottom: 0.5rem;
    animation: cr-pulse 2.5s ease-in-out infinite;
  }
  @keyframes cr-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
  .cr-title {
    font-family: 'Dancing Script', cursive;
    font-size: 2rem;
    font-weight: 700;
    color: #c94f7c;
    margin: 0 0 0.25rem;
    text-align: center;
  }
  .cr-subtitle {
    font-family: 'Nunito', sans-serif;
    font-size: 0.8rem;
    color: #d47094;
    margin: 0 0 2rem;
    letter-spacing: 0.05em;
    text-align: center;
  }
  .cr-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    max-width: 300px;
    align-items: center;
  }
  .cr-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.8rem 1.8rem;
    border-radius: 999px;
    font-family: 'Nunito', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .cr-btn-google {
    background: linear-gradient(135deg, #f472a0, #e8749a);
    color: #fff;
    box-shadow: 0 4px 18px rgba(232, 116, 154, 0.4);
  }
  .cr-btn-google:hover {
    box-shadow: 0 6px 24px rgba(232, 116, 154, 0.6);
    transform: translateY(-1px);
  }
  .cr-btn-apple {
    background: #fff;
    color: #c94f7c;
    border: 2px solid #f5a8c5;
    box-shadow: 0 2px 10px rgba(232, 116, 154, 0.15);
  }
  .cr-btn-apple:hover {
    background: #fff0f6;
    border-color: #e8749a;
    transform: translateY(-1px);
  }
  .cr-btn-outlook {
    background: #fff;
    color: #c94f7c;
    border: 2px solid #f5a8c5;
    box-shadow: 0 2px 10px rgba(232, 116, 154, 0.15);
  }
  .cr-btn-outlook:hover {
    background: #fff0f6;
    border-color: #e8749a;
    transform: translateY(-1px);
  }
  .cr-btn-heart {
    font-size: 0.75rem;
    opacity: 0.8;
  }
  .cr-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .cr-footer-heart {
    margin-top: 1.8rem;
    font-size: 0.9rem;
    color: #f5a8c5;
    letter-spacing: 0.4em;
  }
</style>
