---
interface Props {
  calendario: {
    google?: string;
    apple?: string;
    outlook?: string;
  };
}
const { calendario } = Astro.props;
const { google, apple, outlook } = calendario || {};
---
{calendario && (google || apple || outlook) && (
  <div class="vintage-wrap">
    <h4 class="vintage-title">Reserva la Fecha</h4>
    <hr class="vintage-divider" />
    <div class="vintage-buttons">
      {google && <a href={google} class="vintage-btn">Google</a>}
      {apple && <a href={apple} class="vintage-btn">Apple</a>}
      {outlook && <a href={outlook} class="vintage-btn">Outlook</a>}
    </div>
  </div>
)}
<style>
  .vintage-wrap {
    background: #fdf6e3;
    padding: 2rem;
    border: 2px dashed #d4c098;
    text-align: center;
    font-family: 'Times New Roman', Times, serif;
    color: #5c4a3d;
  }
  .vintage-title {
    font-size: 1.8rem;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .vintage-divider {
    border: 0;
    height: 1px;
    background: #d4c098;
    margin-bottom: 1.5rem;
    width: 50%;
    margin-left: auto;
    margin-right: auto;
  }
  .vintage-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .vintage-btn {
    width: 100%;
    max-width: 220px;
    background: #e9dec5;
    color: #5c4a3d;
    padding: 0.5rem;
    border: 1px solid #cbb691;
    text-decoration: none;
    font-variant: small-caps;
    font-size: 1.2rem;
  }
  .vintage-btn:hover {
    background: #d4c098;
  }
</style>
