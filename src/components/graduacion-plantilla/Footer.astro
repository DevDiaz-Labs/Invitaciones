---
const { data } = Astro.props;
---

<footer class="bg-black/90 py-16 text-center border-t border-grad-secondary/20">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl font-serif text-grad-secondary mb-4 italic">
      {data.hashtag}
    </h2>
    <p class="text-gray-400 font-sans font-light text-sm tracking-widest uppercase">
      {data.agradecimiento}
    </p>
    
    <div class="mt-12 text-gray-600 text-xs tracking-widest flex flex-col items-center gap-2">
      <div class="w-12 h-px bg-grad-secondary/30"></div>
      <p>Diseñado con DevDiaz Labs</p>
      <div class="w-12 h-px bg-grad-secondary/30"></div>
    </div>
  </div>
</footer>
